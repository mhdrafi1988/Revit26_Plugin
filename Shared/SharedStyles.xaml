<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models">

    <!-- ═══════════════════════════════════════════════════════════
         REVIT PLUGIN SHARED STYLE GUIDE  —  Navy Corporate Theme
         Version : 3.1  (adds tinted metric tiles + ToolWindowShell tokens)
         Drop-in compatible with v2.1 key names; adds DataGrid,
         header bar, badge, and button-variant styles for reuse
         across all 10 tools.
    ═══════════════════════════════════════════════════════════ -->

    <!-- ─── FONT FAMILY ───────────────────────────────────────── -->
    <FontFamily x:Key="SystemFont">Segoe UI, -apple-system, BlinkMacSystemFont, Helvetica Neue, sans-serif</FontFamily>

    <!-- ═══════════════════════════════════════════════════════════
         COLOR TOKENS — Navy Corporate Palette
    ═══════════════════════════════════════════════════════════ -->

    <!-- Backgrounds -->

    <Color x:Key="SystemBackground">LightBlue</Color>
    <Color x:Key="SystemSecondaryBackground">#EEF3F9</Color>
    <Color x:Key="SystemTertiaryBackground">#DCE6F2</Color>
    <Color x:Key="SeparatorColor">#D7E1ED</Color>
    <Color x:Key="SeparatorThin">#E8EEF6</Color>

    <!-- Input fields — light orange fill so text/numeric inputs are visibly
         distinguishable from card backgrounds across ALL tools. -->
    <Color x:Key="InputBackground">#FDF0E3</Color>

    <!-- Brand / Accent -->
    <Color x:Key="NavyPrimary">#1E3A5F</Color>
    <Color x:Key="NavyDark">#14283F</Color>
    <Color x:Key="NavyLight">#2C4A6E</Color>
    <Color x:Key="AppleBlue">#2D6CDF</Color>
    <!-- kept key name for backward compatibility -->
    <Color x:Key="AppleBlueLight">#5B8DEF</Color>
    <Color x:Key="AppleBlueDark">#1E4FB8</Color>

    <!-- Text -->
    <Color x:Key="TextPrimary">#1A2B3C</Color>
    <Color x:Key="TextSecondary">#5B7185</Color>
    <Color x:Key="TextTertiary">#8FA3B8</Color>
    <Color x:Key="TextDisabled">#C3CFDB</Color>
    <Color x:Key="TextOnDark">#EAF1F8</Color>

    <!-- Status -->
    <Color x:Key="ColorSuccess">#2E9E64</Color>
    <Color x:Key="ColorWarning">#E0922E</Color>
    <Color x:Key="ColorDanger">#D9534F</Color>
    <Color x:Key="ColorInfo">#2D6CDF</Color>

    <!-- Log Panel (always dark, regardless of window theme) -->
    <Color x:Key="LogBackground">#14283F</Color>
    <Color x:Key="LogTitleBar">#1E3A5F</Color>
    <Color x:Key="LogText">#EAF1F8</Color>
    <Color x:Key="LogTextDim">#7E94AA</Color>
    <Color x:Key="LogSuccess">#4CC18A</Color>
    <Color x:Key="LogWarning">#F0AE5C</Color>
    <Color x:Key="LogError">#F0837D</Color>
    <Color x:Key="LogHighlight">#7FB0FF</Color>

    <!-- Cards -->
    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBorder">#D7E1ED</Color>
    <Color x:Key="IconTint">#5B7185</Color>

    <!-- Tinted metric tiles (v3.1) — Background / Border / Text per tone.
         Taken from SectionAutoRenamer V024's inline tile colours. -->
    <Color x:Key="TileInfoBackground">#E6F1FB</Color>
    <Color x:Key="TileInfoBorder">#85B7EB</Color>
    <Color x:Key="TileInfoText">#0C447C</Color>
    <Color x:Key="TileDangerBackground">#FAECE7</Color>
    <Color x:Key="TileDangerBorder">#F0997B</Color>
    <Color x:Key="TileDangerText">#712B13</Color>
    <Color x:Key="TileSuccessBackground">#EAF3DE</Color>
    <Color x:Key="TileSuccessBorder">#97C459</Color>
    <Color x:Key="TileSuccessText">#27500A</Color>
    <Color x:Key="TileWarningBackground">#FAEEDA</Color>
    <Color x:Key="TileWarningBorder">#EF9F27</Color>
    <Color x:Key="TileWarningText">#633806</Color>

    <!-- Pass / fail row tints for result grids (v3.1) -->
    <Color x:Key="RowSuccessBackground">#F5FFF8</Color>
    <Color x:Key="RowDangerBackground">#FFF5F5</Color>

    <!-- Result-group palette (v3.1) — accent bar / count-pill background /
         text, used by grouped result lists (WorksetRenamer FX). -->
    <Color x:Key="GroupOkAccent">#1E7E1E</Color>
    <Color x:Key="GroupOkBackground">#DCF3DC</Color>
    <Color x:Key="GroupWarningAccent">#C98A00</Color>
    <Color x:Key="GroupWarningBackground">#FFF0CC</Color>
    <Color x:Key="GroupWarningText">#A06A00</Color>
    <Color x:Key="GroupNewAccent">#1E7A52</Color>
    <Color x:Key="GroupNewBackground">#DCF3EA</Color>
    <Color x:Key="GroupNeutralAccent">#999999</Color>
    <Color x:Key="GroupNeutralBackground">#EEEEEE</Color>
    <Color x:Key="GroupNeutralText">#777777</Color>
    <Color x:Key="GroupDangerAccent">#B23B3B</Color>
    <Color x:Key="GroupDangerBackground">#FBDADA</Color>

    <!-- Faint status tints for outlined metric tiles (v3.1, from WorksetManager) -->
    <Color x:Key="TintSuccess">#0A34C759</Color>
    <Color x:Key="TintInfo">#0A3A82F7</Color>
    <Color x:Key="TintWarning">#0AFF9F0A</Color>

    <!-- Action buttons / status pills / warning banner (v3.1, from ScheduleExportImport) -->
    <Color x:Key="ActionExport">#1E7E34</Color>
    <Color x:Key="ActionImport">#C0392B</Color>
    <Color x:Key="ActionText">#FFFFFF</Color>
    <Color x:Key="PillNeutralBackground">#EEF1F5</Color>
    <Color x:Key="PillNeutralText">#4B5563</Color>
    <Color x:Key="PillInfoBackground">#E3ECFB</Color>
    <Color x:Key="PillInfoText">#1D4ED8</Color>
    <Color x:Key="PillSuccessBackground">#DCF3E3</Color>
    <Color x:Key="PillSuccessText">#15803D</Color>
    <Color x:Key="PillDangerText">#B91C1C</Color>
    <Color x:Key="PillMutedBackground">#E5E7EB</Color>
    <Color x:Key="PillMutedText">#374151</Color>
    <Color x:Key="PillTypeBackground">#EDE7FB</Color>
    <Color x:Key="PillTypeText">#6D28D9</Color>
    <Color x:Key="BannerWarningBackground">#FFF6E0</Color>
    <Color x:Key="BannerWarningBorder">#E8B84A</Color>
    <Color x:Key="BannerWarningText">#7A4F00</Color>

    <!-- Import status pills + dark row-detail text (v3.1, from RoofTypeCreator) -->
    <Color x:Key="PillNewBackground">#E3F2FD</Color>
    <Color x:Key="PillNewText">#1565C0</Color>
    <Color x:Key="PillDupBackground">#FFF3E0</Color>
    <Color x:Key="PillDupText">#E65100</Color>
    <Color x:Key="PillRenamedBackground">#F3E5F5</Color>
    <Color x:Key="PillRenamedText">#7B1FA2</Color>
    <Color x:Key="DetailMutedText">#888888</Color>
    <Color x:Key="DetailValueText">#DDDDDD</Color>

    <!-- Soft status-pill backgrounds (v3.1, from CreateSections) -->
    <Color x:Key="SoftSuccessBackground">#E4F5EC</Color>
    <Color x:Key="SoftWarningBackground">#FDF1E1</Color>
    <Color x:Key="SoftDangerBackground">#FBE8E7</Color>
    <Color x:Key="BadgeOnDark">#33FFFFFF</Color>  <!-- translucent white badge on navy chips (RoofEdgeAroundSections) -->
    <Color x:Key="PillTaggableBackground">#E7F5EE</Color>      <!-- SectionViewAutoTagger category pills -->
    <Color x:Key="PillNotTaggableBackground">#FBEAE9</Color>

    <!-- ═══════════════════════════════════════════════════════════
         SOLID COLOR BRUSHES
    ═══════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BrushSystemBackground"          Color="{StaticResource SystemBackground}"/>
    <SolidColorBrush x:Key="BrushSystemSecondaryBackground" Color="{StaticResource SystemSecondaryBackground}"/>
    <SolidColorBrush x:Key="BrushSystemTertiaryBackground"  Color="{StaticResource SystemTertiaryBackground}"/>
    <SolidColorBrush x:Key="BrushSeparator"                 Color="{StaticResource SeparatorColor}"/>
    <SolidColorBrush x:Key="BrushSeparatorThin"             Color="{StaticResource SeparatorThin}"/>
    <SolidColorBrush x:Key="BrushInputBackground"           Color="{StaticResource InputBackground}"/>

    <SolidColorBrush x:Key="BrushNavyPrimary"               Color="{StaticResource NavyPrimary}"/>
    <SolidColorBrush x:Key="BrushNavyDark"                  Color="{StaticResource NavyDark}"/>
    <SolidColorBrush x:Key="BrushNavyLight"                 Color="{StaticResource NavyLight}"/>
    <SolidColorBrush x:Key="BrushAppleBlue"                 Color="{StaticResource AppleBlue}"/>
    <SolidColorBrush x:Key="BrushAppleBlueLight"            Color="{StaticResource AppleBlueLight}"/>
    <SolidColorBrush x:Key="BrushAppleBlueDark"             Color="{StaticResource AppleBlueDark}"/>
    <!-- General-purpose accent brush (filter badges, "active" links, chip highlights) -->
    <SolidColorBrush x:Key="BrushSystemAccent"              Color="{StaticResource AppleBlue}"/>

    <SolidColorBrush x:Key="BrushTextPrimary"               Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="BrushTextSecondary"             Color="{StaticResource TextSecondary}"/>
    <SolidColorBrush x:Key="BrushTextTertiary"              Color="{StaticResource TextTertiary}"/>
    <SolidColorBrush x:Key="BrushTextDisabled"              Color="{StaticResource TextDisabled}"/>
    <SolidColorBrush x:Key="BrushTextOnDark"                Color="{StaticResource TextOnDark}"/>

    <SolidColorBrush x:Key="BrushSuccess"                   Color="{StaticResource ColorSuccess}"/>
    <SolidColorBrush x:Key="BrushWarning"                   Color="{StaticResource ColorWarning}"/>
    <SolidColorBrush x:Key="BrushDanger"                    Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="BrushInfo"                      Color="{StaticResource ColorInfo}"/>

    <SolidColorBrush x:Key="BrushLogBg"                     Color="{StaticResource LogBackground}"/>
    <SolidColorBrush x:Key="BrushLogTitleBar"               Color="{StaticResource LogTitleBar}"/>
    <SolidColorBrush x:Key="BrushLogText"                   Color="{StaticResource LogText}"/>
    <SolidColorBrush x:Key="BrushLogTextDim"                Color="{StaticResource LogTextDim}"/>
    <SolidColorBrush x:Key="BrushLogSuccess"                Color="{StaticResource LogSuccess}"/>
    <SolidColorBrush x:Key="BrushLogWarning"                Color="{StaticResource LogWarning}"/>
    <SolidColorBrush x:Key="BrushLogError"                  Color="{StaticResource LogError}"/>
    <SolidColorBrush x:Key="BrushLogHighlight"              Color="{StaticResource LogHighlight}"/>

    <SolidColorBrush x:Key="BrushCardBackground"            Color="{StaticResource CardBackground}"/>
    <SolidColorBrush x:Key="BrushCardBorder"                Color="{StaticResource CardBorder}"/>
    <SolidColorBrush x:Key="BrushIconTint"                  Color="{StaticResource IconTint}"/>

    <SolidColorBrush x:Key="BrushTileInfoBackground"        Color="{StaticResource TileInfoBackground}"/>
    <SolidColorBrush x:Key="BrushTileInfoBorder"            Color="{StaticResource TileInfoBorder}"/>
    <SolidColorBrush x:Key="BrushTileInfoText"              Color="{StaticResource TileInfoText}"/>
    <SolidColorBrush x:Key="BrushTileDangerBackground"      Color="{StaticResource TileDangerBackground}"/>
    <SolidColorBrush x:Key="BrushTileDangerBorder"          Color="{StaticResource TileDangerBorder}"/>
    <SolidColorBrush x:Key="BrushTileDangerText"            Color="{StaticResource TileDangerText}"/>
    <SolidColorBrush x:Key="BrushTileSuccessBackground"     Color="{StaticResource TileSuccessBackground}"/>
    <SolidColorBrush x:Key="BrushTileSuccessBorder"         Color="{StaticResource TileSuccessBorder}"/>
    <SolidColorBrush x:Key="BrushTileSuccessText"           Color="{StaticResource TileSuccessText}"/>
    <SolidColorBrush x:Key="BrushTileWarningBackground"     Color="{StaticResource TileWarningBackground}"/>
    <SolidColorBrush x:Key="BrushTileWarningBorder"         Color="{StaticResource TileWarningBorder}"/>
    <SolidColorBrush x:Key="BrushTileWarningText"           Color="{StaticResource TileWarningText}"/>
    <SolidColorBrush x:Key="BrushRowSuccessBackground"      Color="{StaticResource RowSuccessBackground}"/>
    <SolidColorBrush x:Key="BrushRowDangerBackground"       Color="{StaticResource RowDangerBackground}"/>
    <SolidColorBrush x:Key="BrushGroupOkAccent"                  Color="{StaticResource GroupOkAccent}"/>
    <SolidColorBrush x:Key="BrushGroupOkBackground"              Color="{StaticResource GroupOkBackground}"/>
    <SolidColorBrush x:Key="BrushGroupWarningAccent"             Color="{StaticResource GroupWarningAccent}"/>
    <SolidColorBrush x:Key="BrushGroupWarningBackground"         Color="{StaticResource GroupWarningBackground}"/>
    <SolidColorBrush x:Key="BrushGroupWarningText"               Color="{StaticResource GroupWarningText}"/>
    <SolidColorBrush x:Key="BrushGroupNewAccent"                 Color="{StaticResource GroupNewAccent}"/>
    <SolidColorBrush x:Key="BrushGroupNewBackground"             Color="{StaticResource GroupNewBackground}"/>
    <SolidColorBrush x:Key="BrushGroupNeutralAccent"             Color="{StaticResource GroupNeutralAccent}"/>
    <SolidColorBrush x:Key="BrushGroupNeutralBackground"         Color="{StaticResource GroupNeutralBackground}"/>
    <SolidColorBrush x:Key="BrushGroupNeutralText"               Color="{StaticResource GroupNeutralText}"/>
    <SolidColorBrush x:Key="BrushGroupDangerAccent"              Color="{StaticResource GroupDangerAccent}"/>
    <SolidColorBrush x:Key="BrushGroupDangerBackground"          Color="{StaticResource GroupDangerBackground}"/>
    <SolidColorBrush x:Key="BrushTintSuccess"               Color="{StaticResource TintSuccess}"/>
    <SolidColorBrush x:Key="BrushTintInfo"                  Color="{StaticResource TintInfo}"/>
    <SolidColorBrush x:Key="BrushTintWarning"               Color="{StaticResource TintWarning}"/>
    <SolidColorBrush x:Key="BrushActionExport"                   Color="{StaticResource ActionExport}"/>
    <SolidColorBrush x:Key="BrushActionImport"                   Color="{StaticResource ActionImport}"/>
    <SolidColorBrush x:Key="BrushActionText"                     Color="{StaticResource ActionText}"/>
    <SolidColorBrush x:Key="BrushPillNeutralBackground"          Color="{StaticResource PillNeutralBackground}"/>
    <SolidColorBrush x:Key="BrushPillNeutralText"                Color="{StaticResource PillNeutralText}"/>
    <SolidColorBrush x:Key="BrushPillInfoBackground"             Color="{StaticResource PillInfoBackground}"/>
    <SolidColorBrush x:Key="BrushPillInfoText"                   Color="{StaticResource PillInfoText}"/>
    <SolidColorBrush x:Key="BrushPillSuccessBackground"          Color="{StaticResource PillSuccessBackground}"/>
    <SolidColorBrush x:Key="BrushPillSuccessText"                Color="{StaticResource PillSuccessText}"/>
    <SolidColorBrush x:Key="BrushPillDangerText"                 Color="{StaticResource PillDangerText}"/>
    <SolidColorBrush x:Key="BrushPillMutedBackground"            Color="{StaticResource PillMutedBackground}"/>
    <SolidColorBrush x:Key="BrushPillMutedText"                  Color="{StaticResource PillMutedText}"/>
    <SolidColorBrush x:Key="BrushPillTypeBackground"             Color="{StaticResource PillTypeBackground}"/>
    <SolidColorBrush x:Key="BrushPillTypeText"                   Color="{StaticResource PillTypeText}"/>
    <SolidColorBrush x:Key="BrushBannerWarningBackground"        Color="{StaticResource BannerWarningBackground}"/>
    <SolidColorBrush x:Key="BrushBannerWarningBorder"            Color="{StaticResource BannerWarningBorder}"/>
    <SolidColorBrush x:Key="BrushBannerWarningText"              Color="{StaticResource BannerWarningText}"/>
    <SolidColorBrush x:Key="BrushPillNewBackground"            Color="{StaticResource PillNewBackground}"/>
    <SolidColorBrush x:Key="BrushPillNewText"                  Color="{StaticResource PillNewText}"/>
    <SolidColorBrush x:Key="BrushPillDupBackground"            Color="{StaticResource PillDupBackground}"/>
    <SolidColorBrush x:Key="BrushPillDupText"                  Color="{StaticResource PillDupText}"/>
    <SolidColorBrush x:Key="BrushPillRenamedBackground"        Color="{StaticResource PillRenamedBackground}"/>
    <SolidColorBrush x:Key="BrushPillRenamedText"              Color="{StaticResource PillRenamedText}"/>
    <SolidColorBrush x:Key="BrushDetailMutedText"              Color="{StaticResource DetailMutedText}"/>
    <SolidColorBrush x:Key="BrushDetailValueText"              Color="{StaticResource DetailValueText}"/>
    <SolidColorBrush x:Key="BrushSoftSuccessBackground"        Color="{StaticResource SoftSuccessBackground}"/>
    <SolidColorBrush x:Key="BrushSoftWarningBackground"        Color="{StaticResource SoftWarningBackground}"/>
    <SolidColorBrush x:Key="BrushSoftDangerBackground"         Color="{StaticResource SoftDangerBackground}"/>
    <SolidColorBrush x:Key="BrushBadgeOnDark"             Color="{StaticResource BadgeOnDark}"/>
    <SolidColorBrush x:Key="BrushPillTaggableBackground"    Color="{StaticResource PillTaggableBackground}"/>
    <SolidColorBrush x:Key="BrushPillNotTaggableBackground" Color="{StaticResource PillNotTaggableBackground}"/>


    <!-- ═══════════════════════════════════════════════════════════
         TYPOGRAPHY — sizes nudged up for readability
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="AppName" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="AppSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Margin"     Value="0,2,0,0"/>
    </Style>

    <!-- Section headers: navy + letter-spacing feel via uppercase, used above each card -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="11.5"/>
        <Setter Property="FontWeight"   Value="SemiBold"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushNavyPrimary}"/>
        <Setter Property="Margin"       Value="12,10,12,5"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Margin"     Value="0,0,0,2"/>
    </Style>

    <Style x:Key="FieldValue" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>

    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="10.5"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextTertiary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin"       Value="0,3,0,0"/>
    </Style>

    <Style x:Key="UnitLabel" TargetType="TextBlock">
        <Setter Property="FontSize"           Value="12"/>
        <Setter Property="Foreground"         Value="{StaticResource BrushTextTertiary}"/>
        <Setter Property="VerticalAlignment"  Value="Center"/>
        <Setter Property="Margin"             Value="3,0,0,0"/>
    </Style>

    <!-- Generic body text — for any plain TextBlock needing the readable default -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontSize"     Value="13"/>
        <Setter Property="Foreground"   Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         METRIC STYLES
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
    </Style>

    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="Margin"     Value="0,0,0,5"/>
    </Style>

    <!-- Large metric number — base style, navy by default -->
    <Style x:Key="MetricNumber" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="23"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
    </Style>

    <!-- Semantic variants — use instead of hardcoded named colors (Orange, Cyan, etc.) -->
    <Style x:Key="MetricNumberAccent" TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
    </Style>

    <Style x:Key="MetricNumberSuccess" TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
    </Style>

    <Style x:Key="MetricNumberWarning" TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
    </Style>

    <Style x:Key="MetricNumberDanger" TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
    </Style>

    <Style x:Key="MetricUnit" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
        <Setter Property="Margin"     Value="0,3,0,0"/>
    </Style>

    <!-- ─── Tinted metric tiles (v3.1) ───────────────────────────
         <Border Style="{StaticResource MetricTileInfo}">
             <StackPanel>
                 <TextBlock Text="SELECTED" Style="{StaticResource MetricTileLabelInfo}"/>
                 <TextBlock Text="{Binding X}" Style="{StaticResource MetricTileNumberInfo}"/>
             </StackPanel>
         </Border>
    ─────────────────────────────────────────────────────────── -->
    <Style x:Key="MetricTile" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="BorderThickness" Value="0.5"/>
        <Setter Property="Padding"         Value="10,6"/>
        <Setter Property="Background"      Value="{StaticResource BrushSystemBackground}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushCardBorder}"/>
    </Style>
    <Style x:Key="MetricTileInfo" TargetType="Border" BasedOn="{StaticResource MetricTile}">
        <Setter Property="Background"  Value="{StaticResource BrushTileInfoBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileInfoBorder}"/>
    </Style>
    <Style x:Key="MetricTileDanger" TargetType="Border" BasedOn="{StaticResource MetricTile}">
        <Setter Property="Background"  Value="{StaticResource BrushTileDangerBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileDangerBorder}"/>
    </Style>
    <Style x:Key="MetricTileSuccess" TargetType="Border" BasedOn="{StaticResource MetricTile}">
        <Setter Property="Background"  Value="{StaticResource BrushTileSuccessBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileSuccessBorder}"/>
    </Style>
    <Style x:Key="MetricTileWarning" TargetType="Border" BasedOn="{StaticResource MetricTile}">
        <Setter Property="Background"  Value="{StaticResource BrushTileWarningBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushTileWarningBorder}"/>
    </Style>

    <Style x:Key="MetricTileLabel" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="9.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    </Style>
    <Style x:Key="MetricTileLabelInfo" TargetType="TextBlock" BasedOn="{StaticResource MetricTileLabel}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileInfoText}"/>
    </Style>
    <Style x:Key="MetricTileLabelDanger" TargetType="TextBlock" BasedOn="{StaticResource MetricTileLabel}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileDangerText}"/>
    </Style>
    <Style x:Key="MetricTileLabelSuccess" TargetType="TextBlock" BasedOn="{StaticResource MetricTileLabel}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileSuccessText}"/>
    </Style>
    <Style x:Key="MetricTileLabelWarning" TargetType="TextBlock" BasedOn="{StaticResource MetricTileLabel}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileWarningText}"/>
    </Style>

    <Style x:Key="MetricTileNumber" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="18"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
    </Style>
    <Style x:Key="MetricTileNumberInfo" TargetType="TextBlock" BasedOn="{StaticResource MetricTileNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileInfoText}"/>
    </Style>
    <Style x:Key="MetricTileNumberDanger" TargetType="TextBlock" BasedOn="{StaticResource MetricTileNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileDangerText}"/>
    </Style>
    <Style x:Key="MetricTileNumberSuccess" TargetType="TextBlock" BasedOn="{StaticResource MetricTileNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileSuccessText}"/>
    </Style>
    <Style x:Key="MetricTileNumberWarning" TargetType="TextBlock" BasedOn="{StaticResource MetricTileNumber}">
        <Setter Property="Foreground" Value="{StaticResource BrushTileWarningText}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         HEADER BAR — navy bar for window/app identity
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="HeaderBar" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource BrushNavyPrimary}"/>
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Setter Property="Padding"      Value="16,12"/>
    </Style>

    <Style x:Key="HeaderTitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
    </Style>

    <Style x:Key="HeaderSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlueLight}"/>
        <Setter Property="Margin"     Value="0,2,0,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         CARDS / PANELS
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="BaseCard" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="10"/>
    </Style>

    <Style x:Key="ContentCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin"  Value="0,0,0,8"/>
    </Style>

    <Style x:Key="AppIdentityCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Setter Property="Padding" Value="14"/>
        <Setter Property="Margin"  Value="0,0,0,8"/>
    </Style>

    <Style x:Key="SectionCard" TargetType="Border" BasedOn="{StaticResource ContentCard}">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="MetricCard" TargetType="Border" BasedOn="{StaticResource BaseCard}">
        <Setter Property="Padding" Value="12,14"/>
    </Style>

    <!--  NEW: CardGroupBox style for GroupBox controls  -->
    <Style x:Key="CardGroupBox" TargetType="GroupBox">
        <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <ContentPresenter ContentSource="Header"
                                              Margin="12,10,12,0"
                                              TextBlock.FontWeight="SemiBold"
                                              TextBlock.Foreground="{StaticResource BrushTextSecondary}"/>
                            <ContentPresenter ContentSource="Content" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BADGE / PILL — for status counts, mode tags
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="BadgePill" TargetType="Border">
        <Setter Property="Background"        Value="{StaticResource BrushSystemSecondaryBackground}"/>
        <Setter Property="CornerRadius"      Value="10"/>
        <Setter Property="Padding"           Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         INPUTS
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="FieldRow" TargetType="StackPanel">
        <Setter Property="Margin" Value="12,4,12,4"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         Template override needed so Background actually paints with
         rounded corners — a bare Setter on a default TextBox Style
         renders the fill square with native WPF chrome. Kept borderless
         (no BorderBrush/Thickness) to preserve the original flush look,
         now with the light-orange input fill.
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="BorderlessTextInput" TargetType="TextBox">
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="FontWeight"               Value="Normal"/>
        <Setter Property="Foreground"               Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"               Value="{StaticResource BrushInputBackground}"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="Padding"                  Value="4,3"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush"               Value="{StaticResource BrushAppleBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="4">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boxed text input — bordered field for forms that need a visible outline -->
    <Style x:Key="BoxedTextInput" TargetType="TextBox">
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"      Value="{StaticResource BrushInputBackground}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushSeparator}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="Height"          Value="32"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ComboBox base — minimal styling for consistent look (relies on default chrome) -->
    <Style x:Key="StandardComboBox" TargetType="ComboBox">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Height"   Value="32"/>
        <Setter Property="Padding"  Value="2,2"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource BrushInputBackground}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         TOGGLE SWITCH
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="AppleToggleButton" TargetType="ToggleButton">
        <Setter Property="Width"  Value="34"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track"
                            Background="{StaticResource BrushSystemTertiaryBackground}"
                            CornerRadius="9.5"
                            Width="34"
                            Height="19">
                        <Border x:Name="Knob"
                                Background="White"
                                CornerRadius="7.5"
                                Width="15"
                                Height="15"
                                Margin="2"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.15"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                            <Setter TargetName="Knob"  Property="Margin"     Value="17,2,2,2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="AppleToggleRow" TargetType="StackPanel">
        <Setter Property="Orientation"       Value="Horizontal"/>
        <Setter Property="Margin"            Value="12,7"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         BUTTONS
    ═══════════════════════════════════════════════════════════ -->
    <!-- Primary action — navy, used for main "Apply / Run / Save" actions -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height"     Value="38"/>
        <Setter Property="FontSize"   Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushNavyLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushNavyDark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent action — bright blue, for secondary "highlight" actions (Export, Refresh) -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAppleBlueLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushAppleBlueDark}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary — text-style button on transparent background -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Height"     Value="32"/>
        <Setter Property="FontSize"   Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Outline — bordered button, neutral actions (Browse, Cancel) -->
    <Style x:Key="OutlineButton" TargetType="Button">
        <Setter Property="Height"     Value="32"/>
        <Setter Property="FontSize"   Value="12.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{StaticResource BrushSystemBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9" Padding="12,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger — destructive actions (Delete, Remove, Clear) -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="18,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         STATUS / CHIP
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="StatusRow" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/>
        <Setter Property="Margin"      Value="12,10"/>
    </Style>

    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width"             Value="7"/>
        <Setter Property="Height"            Value="7"/>
        <Setter Property="Fill"              Value="{StaticResource BrushSuccess}"/>
        <Setter Property="Margin"            Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

    <!-- Ghost button for dark surfaces — e.g. "Clear" on the log panel header -->
    <Style x:Key="DarkGhostButton" TargetType="Button">
        <Setter Property="Height"     Value="26"/>
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource BrushLogText}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushLogTextDim}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="10,0">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushLogText}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         SEPARATOR
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="SeparatorLine" TargetType="Border">
        <Setter Property="Height"     Value="1"/>
        <Setter Property="Background" Value="{StaticResource BrushSeparatorThin}"/>
        <Setter Property="Margin"     Value="12,0"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         DATAGRID — shared look for all grid-based tools
         (WorksetManager, SectionsList, RoofTag, etc.)
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="StandardDataGrid" TargetType="DataGrid">
        <Setter Property="Background"                 Value="{StaticResource BrushSystemBackground}"/>
        <Setter Property="BorderThickness"            Value="0"/>
        <Setter Property="RowHeight"                  Value="30"/>
        <Setter Property="FontSize"                   Value="12.5"/>
        <Setter Property="Foreground"                 Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="GridLinesVisibility"        Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush"   Value="{StaticResource BrushSeparatorThin}"/>
        <Setter Property="VerticalGridLinesBrush"     Value="{StaticResource BrushSeparatorThin}"/>
        <Setter Property="HeadersVisibility"          Value="Column"/>
        <Setter Property="CanUserResizeRows"          Value="False"/>
        <Setter Property="AlternatingRowBackground"   Value="{StaticResource BrushSystemSecondaryBackground}"/>
        <Setter Property="RowBackground"              Value="{StaticResource BrushSystemBackground}"/>
        <Setter Property="SelectionMode"              Value="Extended"/>
    </Style>

    <Style x:Key="StandardDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{StaticResource BrushNavyPrimary}"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextOnDark}"/>
        <Setter Property="FontSize"        Value="11.5"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushNavyLight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="StandardDataGridCell" TargetType="DataGridCell">
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAppleBlueLight}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StandardDataGridRow" TargetType="DataGridRow">
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushAppleBlue}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         LIGHTWEIGHT DATAGRID BASES — for grids that drive their own
         "selected" highlight off a VM property (e.g. checkbox-driven
         row selection) instead of WPF's native DataGridRow.IsSelected.
         Unlike Standard*, these do NOT recolor on native selection,
         so they won't fight a custom IsSelected DataTrigger like
         SarRowStyle in SectionsListWindow.
    ═══════════════════════════════════════════════════════════ -->
    <Style x:Key="DataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{StaticResource BrushSystemSecondaryBackground}"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextSecondary}"/>
        <Setter Property="FontSize"        Value="11"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderThickness" Value="0"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="MinHeight"  Value="28"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         COMPACT INPUT / TOOLBAR BUTTON
    ═══════════════════════════════════════════════════════════ -->
    <!-- Compact bordered text input — for inline toolbar/filter fields
         (smaller footprint than BoxedTextInput, which targets full form rows) -->
    <Style x:Key="StyledTextInput" TargetType="TextBox">
        <Setter Property="FontSize"        Value="12"/>
        <Setter Property="Foreground"      Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Background"      Value="{StaticResource BrushInputBackground}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="2,2"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="CaretBrush"      Value="{StaticResource BrushAppleBlue}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Small secondary action — bordered, compact (toolbars, action-bar "Select all" etc.) -->
    <Style x:Key="SmallSecondaryButton" TargetType="Button">
        <Setter Property="Height"     Value="26"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"    Value="9,0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlueLight}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSeparator}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextDisabled}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter "chip" — a RadioButton rendered as a pill, highlighted (accent
         background/white text) when checked. Used for one-click quick-filter
         rows (e.g. ViewAutoRenamer's Quick Filter chip strip). -->
    <Style x:Key="ChipToggle" TargetType="RadioButton">
        <Setter Property="Height"     Value="24"/>
        <Setter Property="FontSize"   Value="11"/>
        <Setter Property="Padding"    Value="10,0"/>
        <Setter Property="Margin"     Value="0,0,6,0"/>
        <Setter Property="Cursor"     Value="Hand"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg"
                            Background="{StaticResource BrushSystemBackground}"
                            BorderBrush="{StaticResource BrushCardBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushAppleBlueLight}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background"  Value="{StaticResource BrushSystemAccent}"/>
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource BrushSystemAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════
         STAGE CARD — numbered accordion header for multi-stage tools
         (SmartViewToSheetPlacer StageCardControl, and any future
         staged-workflow tool). Base states below are "pending" —
         StageCardControl.xaml overrides Background/Foreground via
         its own MultiDataTrigger/DataTrigger for active/complete.
    ═══════════════════════════════════════════════════════════ -->

    <!-- Header row toggle — flat, full-width, no native ToggleButton chrome -->
    <Style x:Key="StageHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Padding"         Value="14,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Numbered circle base — pending = grey; active/complete set by control's own triggers -->
    <Style x:Key="StageNumberCircleBase" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
    </Style>

    <Style x:Key="StageNumberText" TargetType="TextBlock">
        <Setter Property="FontSize"             Value="11.5"/>
        <Setter Property="FontWeight"           Value="Bold"/>
        <Setter Property="Foreground"           Value="{StaticResource BrushTextOnDark}"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Center"/>
    </Style>

    <Style x:Key="StageTitleText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
        <Setter Property="Margin"     Value="0,0,8,0"/>
    </Style>

    <Style x:Key="StageSubtitleText" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="11.5"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
    </Style>

    <!-- Status badge/pill base — pending = tertiary bg; active/complete set by control's own triggers -->
    <Style x:Key="StatusBadgeBase" TargetType="Border">
        <Setter Property="Background"   Value="{StaticResource BrushSystemTertiaryBackground}"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding"      Value="9,3"/>
    </Style>

    <Style x:Key="StatusBadgeTextPending" TargetType="TextBlock">
        <Setter Property="FontSize"   Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
    </Style>

    <!-- ===== CONVERTER INSTANCE (ADDED) ===== -->
   

</ResourceDictionary>