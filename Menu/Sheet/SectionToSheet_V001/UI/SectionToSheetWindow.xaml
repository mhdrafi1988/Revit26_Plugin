<!--
  SectionToSheetWindow.xaml (Section To Sheet V001)
  HEADER  metric cards (found / not placed / will move / sheets used)
  BODY    left: setup · right: sections list · below: activity log
  FOOTER  Place → Close
-->
<Window x:Class="Revit26_Plugin.SectionToSheet.V001.UI.SectionToSheetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin.Shared.Controls"
        Title="Section To Sheet"
        Height="800" Width="1040" MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <converters:InverseBoolConverter x:Key="InvertBool"/>
            <Style x:Key="MmBox" TargetType="TextBox" BasedOn="{StaticResource BoxedTextInput}">
                <Setter Property="Width" Value="56"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
            </Style>
            <Style x:Key="SmallLabel" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell x:Name="Shell"
                           Title="Section To Sheet"
                           Subtitle="Places every section in the active plan view onto sheets — placed ones are moved"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sections" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding PlanName, StringFormat='in {0}'}" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="To Place" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NotPlacedCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="not on a sheet yet" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="To Move" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MoveCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="already on a sheet" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Sheets Used" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SheetsUsedCount}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="last run" Style="{StaticResource MetricUnit}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═══ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Setup ── -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Margin="12,0,12,10">
                            <TextBlock Text="Sheets" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                            <TextBlock Text="Start on" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="0,2,0,8"
                                      ItemsSource="{Binding StartSheets}" SelectedItem="{Binding SelectedStartSheet}"
                                      DisplayMemberPath="Label"/>

                            <TextBlock Text="When a sheet is full" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                <RadioButton GroupName="Overflow" Content="New sheets" Margin="0,0,14,0"
                                             IsChecked="{Binding OverflowToExisting, Converter={StaticResource InvertBool}}"/>
                                <RadioButton GroupName="Overflow" Content="Existing sheets I pick"
                                             IsChecked="{Binding OverflowToExisting}"/>
                            </StackPanel>
                            <Border Visibility="{Binding OverflowToExisting, Converter={StaticResource BoolToVis}}"
                                    BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8">
                                <ListBox ItemsSource="{Binding OverflowSheets}" MaxHeight="130" BorderThickness="0"
                                         ToolTip="Ticked sheets are filled top to bottom in this order; new sheets follow if they run out.">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsPicked}" Content="{Binding Label}"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>

                            <TextBlock Text="If a sheet already has views" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Margin="0,2,0,8">
                                <RadioButton GroupName="Content" Content="Stack the sections below them" IsChecked="{Binding ContentStack}"/>
                                <RadioButton GroupName="Content" Content="Skip to the next sheet" IsChecked="{Binding ContentSkip}" Margin="0,3,0,0"/>
                                <RadioButton GroupName="Content" Content="Rearrange all views on it together" IsChecked="{Binding ContentRearrange}" Margin="0,3,0,0"
                                             ToolTip="Existing views are moved too. Schedules, legends and text stay where they are."/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                        <StackPanel Margin="12,0,12,10">
                            <TextBlock Text="New sheets" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <TextBlock Text="Titleblock" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}" Margin="0,2,0,8"
                                      ItemsSource="{Binding Titleblocks}" SelectedItem="{Binding SelectedTitleblock}"
                                      DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Number" Style="{StaticResource SmallLabel}"/>
                                <TextBox Text="{Binding SheetNumberPrefix, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" Width="70"
                                         ToolTip="Prefix of new sheet numbers"/>
                                <TextBox Text="{Binding SheetNumberStart, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MmBox}" Width="56"
                                         ToolTip="First number; used numbers are skipped. Its length sets the zero padding (001)."/>
                            </StackPanel>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SectionCard}" Margin="0,8,0,0">
                        <StackPanel Margin="12,0,12,10">
                            <TextBlock Text="Layout" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Algorithm" Style="{StaticResource SmallLabel}"/>
                                <ComboBox Style="{StaticResource StandardComboBox}" Width="170"
                                          ItemsSource="{Binding Strategies}" SelectedItem="{Binding Strategy}"/>
                            </StackPanel>
                            <TextBlock Text="Margin (mm)  top · bottom · left · right" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,6">
                                <TextBox Text="{Binding MarginTopMm}" Style="{StaticResource MmBox}"/>
                                <TextBox Text="{Binding MarginBottomMm}" Style="{StaticResource MmBox}"/>
                                <TextBox Text="{Binding MarginLeftMm}" Style="{StaticResource MmBox}"/>
                                <TextBox Text="{Binding MarginRightMm}" Style="{StaticResource MmBox}"/>
                            </StackPanel>
                            <TextBlock Text="Gap between views (mm)  horizontal · vertical" Style="{StaticResource FieldLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBox Text="{Binding GapHorizontalMm}" Style="{StaticResource MmBox}"/>
                                <TextBox Text="{Binding GapVerticalMm}" Style="{StaticResource MmBox}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Sections list ── -->
                <Border Grid.Column="2" Style="{StaticResource SectionCard}">
                    <DockPanel Margin="12,0,12,10">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Sections in this plan" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <CheckBox Content="Include already placed (moved)" IsChecked="{Binding IncludePlaced}"
                                          VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,4,0"/>
                                <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectNoneCommand}" Margin="0,0,4,0"/>
                                <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ReloadCommand}"/>
                            </StackPanel>
                        </DockPanel>
                        <DataGrid ItemsSource="{Binding SectionsView}" Style="{StaticResource StandardDataGrid}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  MinHeight="200"
                                  shell:ShellBehaviors.MaxHeightRatio="0.5"
                                  shell:ShellBehaviors.ForwardMouseWheel="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Section" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Scale" Width="70" Binding="{Binding ScaleLabel}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size (mm)" Width="100" Binding="{Binding SizeLabel}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Status" Width="190" Binding="{Binding StatusLabel}" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ── Activity log ── -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0" Click="CopySelectedLog_Click"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding LogEntries}" SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0" MinHeight="90" Padding="0"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}" Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Place" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding PlaceCommand}"
                        ToolTip="Place the ticked sections on sheets (one Undo step)."/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" IsCancel="True"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
