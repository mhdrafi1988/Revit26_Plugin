<Window x:Class="Revit26_Plugin.SmartViewToSheetPlacer.V204.Views.SmartViewToSheetPlacerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        mc:Ignorable="d"
        Title="Smart View To Sheet Placer — v204"
        Height="900" Width="1200"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <!-- V204 fix: StaticResource lookups throughout this Window (HeaderBar,
         SectionCard, etc.) are resolved by the XAML compiler at BUILD TIME —
         the code-behind LoadSharedStyles() call only helps at RUNTIME and
         cannot satisfy the compiler. A prior edit removed this merge
         entirely in favor of the code-behind trick alone, which broke the
         build. Using the assembly-relative pack syntax below (not the
         absolute pack://application:,,, form) resolves against the current
         assembly directly, without needing a live Application object — safe
         at both compile time and Revit runtime. LoadSharedStyles() in the
         code-behind is kept as a defensive no-op-if-already-merged fallback,
         but this static merge is what actually makes the Window buildable. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:BoolToHeaderIconBrushConverter x:Key="BoolToHeaderIconBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Esc" Command="{Binding CloseCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Smart View To Sheet Placer" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Grid.Column="1" Text="v204" Style="{StaticResource HeaderSubtitle}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Scrollable accordion body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- ═══════════ STAGE 1: SELECT VIEWS ═══════════ -->
                <!-- V204: StageCardControl UserControl eliminated — inlined directly
                     here per confirmed decision. Header block below is repeated once
                     per stage (5x total), each bound to that stage's own
                     StageXExpanded/StageXComplete/StageXStatusLabel properties
                     directly on the Window's DataContext (no more AncestorType=UserControl
                     RelativeSource indirection needed). -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource StageHeaderToggle}"
                                      IsChecked="{Binding Stage1Expanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StageNumberCircleBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage1Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage1Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage1Complete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="1" Style="{StaticResource StageNumberText}"/>
                                    </Border>
                                    <TextBlock Text="Select Views" Style="{StaticResource StageTitleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Choose views and titleblock" Style="{StaticResource StageSubtitleText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage1Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage1Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage1Complete}" Value="True">
                                                        <Setter Property="Background" Value="#E4F3EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stage1StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextPending}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Stage1Expanded}" Value="True"/>
                                                                <Condition Binding="{Binding Stage1Complete}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Stage1Complete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#9662;" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage1Expanded}" Value="False">
                                                        <Setter Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushCardBorder}"
                                Visibility="{Binding Stage1Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="14">

                            <!-- Titleblock + Margin -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Titleblock" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Titleblock (applies to all new sheets)" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Width="280" Style="{StaticResource StandardComboBox}"
                                                      ItemsSource="{Binding Titleblocks}"
                                                      SelectedItem="{Binding SelectedTitleblock}"
                                                      DisplayMemberPath="Name"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Margin (mm)" Style="{StaticResource FieldLabel}" Margin="0,14,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Top" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding MarginTopMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Bottom" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding MarginBottomMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Left" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding MarginLeftMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Right" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding MarginRightMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                               Text="Usable sheet area = titleblock's actual paper size minus each independent margin (Top / Bottom / Left / Right). Used directly by the packing calculation."/>
                                </StackPanel>
                            </Border>

                            <!-- Project Views grid -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Project Views" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                Command="{Binding SelectAllViewsCommand}"/>
                                        <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                Command="{Binding ClearSelectionCommand}"/>
                                        <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding RefreshViewsCommand}"/>
                                    </StackPanel>

                                    <!-- Always-visible filter row (V203) — sits directly above the DataGrid
                                         header, columns aligned to the DataGrid.Columns widths below
                                         (36 / * / 140 / 90 / 160), so each filter lines up under its column. -->
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="160"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox column — no filter -->

                                        <!-- View Name filter: live text box -->
                                        <TextBox Grid.Column="1" Style="{StaticResource StyledTextInput}"
                                                 Margin="2,0,4,0" MaxLength="25"
                                                 Text="{Binding ViewNameFilter, UpdateSourceTrigger=PropertyChanged}"/>

                                        <!-- View Type filter: button in filter row opens popover with checkbox list -->
                                        <ToggleButton x:Name="ViewTypeFilterToggle"
                                                      Grid.Column="2" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                                                      Height="28"
                                                      IsChecked="{Binding IsViewTypeFilterOpen, Mode=TwoWay}"
                                                      Background="{StaticResource BrushCardBackground}"
                                                      BorderBrush="{StaticResource BrushCardBorder}"
                                                      BorderThickness="1"
                                                      Cursor="Hand">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="View Type" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="&#9660;" FontSize="8" Margin="4,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{Binding IsViewTypeFilterActive,
                                                                        Converter={StaticResource BoolToHeaderIconBrushConverter}}"/>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Popup Grid.Column="2" PlacementTarget="{Binding ElementName=ViewTypeFilterToggle}"
                                               IsOpen="{Binding IsViewTypeFilterOpen, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               Placement="Bottom"
                                               HorizontalOffset="0"
                                               VerticalOffset="2">
                                            <Border Background="{StaticResource BrushCardBackground}"
                                                    BorderBrush="{StaticResource BrushCardBorder}"
                                                    BorderThickness="1" CornerRadius="8" Padding="0,6"
                                                    Width="190">
                                                <Border.Effect>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.25"/>
                                                </Border.Effect>
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Right"
                                                                Margin="10,0,10,6">
                                                        <Button Content="All" Style="{StaticResource SecondaryButton}"
                                                                Height="20" FontSize="10.5" Padding="4,0" Margin="0,0,4,0"
                                                                Command="{Binding CheckAllViewTypesCommand}"/>
                                                        <Button Content="None" Style="{StaticResource SecondaryButton}"
                                                                Height="20" FontSize="10.5" Padding="4,0"
                                                                Command="{Binding UncheckAllViewTypesCommand}"/>
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding ViewTypeFilters}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <CheckBox Content="{Binding Label}"
                                                                          IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                                                          FontSize="12"
                                                                          Padding="6,0,0,0"
                                                                          Margin="12,4"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <!-- Scale / Size on Sheet columns — no filter -->
                                    </Grid>

                                    <DataGrid ItemsSource="{Binding ViewsView}"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="False"
                                              MaxHeight="320"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="" Width="36" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>

                                            <!-- View Name column — plain header; live filter row sits directly
                                                 above the DataGrid, in the same column position (V203). -->
                                            <DataGridTextColumn Header="View Name" Width="*" Binding="{Binding Name}" IsReadOnly="True"/>

                                            <!-- View Type column — plain header; popover-button filter sits
                                                 directly above the DataGrid, in the same column position (V204). -->
                                            <DataGridTextColumn Header="View Type" Width="140" Binding="{Binding ViewTypeLabel}" IsReadOnly="True"/>

                                            <DataGridTextColumn Header="Scale" Width="90" Binding="{Binding ScaleLabel}" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Size on Sheet (mm)" Width="160" IsReadOnly="True">
                                                <DataGridTextColumn.Binding>
                                                    <MultiBinding StringFormat="{}{0:0} x {1:0}">
                                                        <Binding Path="WidthMm"/>
                                                        <Binding Path="HeightMm"/>
                                                    </MultiBinding>
                                                </DataGridTextColumn.Binding>
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0">
                                        <Run Text="{Binding SelectedViewCount, Mode=OneWay}"/>
                                        <Run Text=" view(s) selected of "/>
                                        <Run Text="{Binding TotalViewCount, Mode=OneWay}"/>
                                        <Run Text=" total"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- Footer -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                        Command="{Binding CloseCommand}"/>
                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding NextToStage2Command}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Loading..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        <TextBlock Text="Next: Preview Placement &gt;" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ STAGE 2: PREVIEW PLACEMENT (NEW) ═══════════ -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource StageHeaderToggle}"
                                      IsChecked="{Binding Stage2Expanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StageNumberCircleBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage2Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage2Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage2Complete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="2" Style="{StaticResource StageNumberText}"/>
                                    </Border>
                                    <TextBlock Text="Preview Placement" Style="{StaticResource StageTitleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Set gaps and preview sheet layout" Style="{StaticResource StageSubtitleText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage2Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage2Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage2Complete}" Value="True">
                                                        <Setter Property="Background" Value="#E4F3EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stage2StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextPending}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Stage2Expanded}" Value="True"/>
                                                                <Condition Binding="{Binding Stage2Complete}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Stage2Complete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#9662;" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage2Expanded}" Value="False">
                                                        <Setter Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushCardBorder}"
                                Visibility="{Binding Stage2Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="14">

                            <!-- Card 1: Packing Algorithm (incl. Gap Between Views) -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Packing Algorithm" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Algorithm" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="220" IsReadOnly="True" Text="Greedy Row Packing"
                                                     Style="{StaticResource BoxedTextInput}"
                                                     Background="{StaticResource BrushSystemSecondaryBackground}"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource BadgePill}" VerticalAlignment="Bottom" Margin="0,0,0,2">
                                            <TextBlock Style="{StaticResource BadgeText}">
                                                <Run Text="Suggested sheets: "/>
                                                <Run Text="{Binding SuggestedSheetCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="Gap Between Views (mm)" Style="{StaticResource FieldLabel}" Margin="0,14,0,2"/>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Horizontal" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding GapHorizontalMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Vertical" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Width="80" Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                                     Text="{Binding GapVerticalMm, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="Algorithm is fixed for this version. Each view group (by Revit ViewType) is always placed on its own set of sheets; same-group views can still pack together if they fit, but different groups never share a sheet. Gap is applied strictly between placed views/rows — a single view or row reserves no extra space."/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Sheet Preview — to-scale WPF canvas of the selected suggested sheet -->
                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Sheet Preview" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Sheet" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox Width="240" Style="{StaticResource StandardComboBox}"
                                                      ItemsSource="{Binding SuggestedSheets}"
                                                      SelectedItem="{Binding SelectedPreviewSheet}"
                                                      DisplayMemberPath="GeneratedName"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource BadgePill}" VerticalAlignment="Bottom" Margin="0,0,8,2">
                                            <TextBlock Style="{StaticResource BadgeText}">
                                                <Run Text="Views on sheet: "/>
                                                <Run Text="{Binding SelectedPreviewSheet.TotalViewCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>

                                    <!-- To-scale sheet canvas: outer border = full sheet, dashed rect =
                                         usable area (post-margin), inner rects = each placed view. All
                                         pixel geometry (Preview*Px on the ViewModel, Preview*Px on each
                                         ViewPlacement) is pre-computed in the VM's RecomputePreviewGeometry —
                                         plain OneWay bindings here, no converters needed. -->
                                    <Border Background="{StaticResource BrushSystemBackground}"
                                            BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                            CornerRadius="8" Padding="20" HorizontalAlignment="Center">
                                        <Border Width="{Binding PreviewSheetWidthPx}" Height="{Binding PreviewSheetHeightPx}"
                                                Background="White" BorderBrush="{StaticResource BrushTextTertiary}" BorderThickness="1.5">
                                            <Canvas>
                                                <!-- Usable-area outline (post-margin) -->
                                                <Border Canvas.Left="{Binding PreviewUsableLeftPx}" Canvas.Top="{Binding PreviewUsableTopPx}"
                                                        Width="{Binding PreviewUsableWidthPx}" Height="{Binding PreviewUsableHeightPx}"
                                                        BorderBrush="{StaticResource BrushAppleBlue}" BorderThickness="1" Opacity="0.6"/>

                                                <!-- One box per placed view on the selected sheet -->
                                                <ItemsControl ItemsSource="{Binding SelectedPreviewSheet.Placements}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><Canvas/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter">
                                                            <Setter Property="Canvas.Left" Value="{Binding PreviewLeftPx}"/>
                                                            <Setter Property="Canvas.Top" Value="{Binding PreviewTopPx}"/>
                                                        </Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="{Binding PreviewWidthPx}" Height="{Binding PreviewHeightPx}"
                                                                    BorderThickness="1.2" Background="{StaticResource BrushSystemTertiaryBackground}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BrushNavyLight}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Fits}" Value="False">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource BrushDanger}"/>
                                                                                <Setter Property="Background" Value="#FDEBEA"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <StackPanel VerticalAlignment="Center" Margin="4">
                                                                    <TextBlock Text="{Binding View.Name}" FontSize="10.5" FontWeight="SemiBold"
                                                                               Foreground="{StaticResource BrushTextPrimary}"
                                                                               TextAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextSecondary}" TextAlignment="Center" Margin="0,2,0,0">
                                                                        <Run Text="{Binding View.WidthMm, Mode=OneWay, StringFormat={}{0:0}}"/>
                                                                        <Run Text=" × "/>
                                                                        <Run Text="{Binding View.HeightMm, Mode=OneWay, StringFormat={}{0:0}}"/>
                                                                        <Run Text=" mm"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Border>
                                    </Border>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                               Text="Drawn to scale from the same margin/gap/offset values used by the packing calculation — this is a preview, not the final Revit sheet. Views outlined in red failed fit validation. Switching sheets or editing Gap fields above updates this canvas; it also updates live if a view is manually reassigned on the Suggested Placement stage."/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Left" Content="&lt; Back to Select Views" Style="{StaticResource OutlineButton}"
                                        Command="{Binding BackToStage1Command}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                            Command="{Binding CloseCommand}"/>
                                    <Button Content="Next: Suggested Placement &gt;" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding NextToStage3Command}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ STAGE 3: SUGGESTED PLACEMENT ═══════════ -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource StageHeaderToggle}"
                                      IsChecked="{Binding Stage3Expanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StageNumberCircleBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage3Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage3Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage3Complete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="3" Style="{StaticResource StageNumberText}"/>
                                    </Border>
                                    <TextBlock Text="Suggested Placement" Style="{StaticResource StageTitleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Review auto-packed sheet layout" Style="{StaticResource StageSubtitleText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage3Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage3Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage3Complete}" Value="True">
                                                        <Setter Property="Background" Value="#E4F3EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stage3StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextPending}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Stage3Expanded}" Value="True"/>
                                                                <Condition Binding="{Binding Stage3Complete}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Stage3Complete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#9662;" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage3Expanded}" Value="False">
                                                        <Setter Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushCardBorder}"
                                Visibility="{Binding Stage3Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="14">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Suggested Sheet Placement" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                    <ItemsControl ItemsSource="{Binding SuggestedSheets}" Margin="0,0,0,8">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource BadgePill}" Margin="0,0,8,6">
                                                    <TextBlock Style="{StaticResource BadgeText}">
                                                        <Run Text="Sheet "/>
                                                        <Run Text="{Binding SheetIndex, Mode=OneWay}"/>
                                                        <Run Text=": "/>
                                                        <Run Text="{Binding GeneratedName, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Single flat grid: all views across all sheets, per confirmed design -->
                                    <DataGrid ItemsSource="{Binding AllPlacements}"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              MaxHeight="360">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="View Name" Width="*" Binding="{Binding View.Name}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Suggested Sheet #" Width="240">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <ComboBox ItemsSource="{Binding AvailableSheets}"
                                                                  SelectedItem="{Binding AssignedSheet, UpdateSourceTrigger=PropertyChanged}"
                                                                  DisplayMemberPath="GeneratedName"
                                                                  Style="{StaticResource StandardComboBox}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Position on Sheet" Width="140" Binding="{Binding Position}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Scale" Width="80" Binding="{Binding View.ScaleLabel}" IsReadOnly="True"/>
                                            <DataGridTemplateColumn Header="Fit Status" Width="120">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="OK"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Fits}" Value="False">
                                                                            <Setter Property="Text" Value="⚠ Overflow"/>
                                                                            <Setter Property="Foreground" Value="{StaticResource BrushDanger}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,4,0,0"
                                               Text="Editing &quot;Suggested Sheet #&quot; manually re-validates fit and recomputes that sheet's name. The dropdown only offers sheets in that view's own ViewType group. Rows that no longer fit are flagged in red with an Overflow warning — placement can still proceed, but flagged views should be reviewed."/>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Left" Content="&lt; Back to Preview Placement" Style="{StaticResource OutlineButton}"
                                        Command="{Binding BackToStage2Command}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                            Command="{Binding CloseCommand}"/>
                                    <Button Content="Next: Confirm &amp; Place &gt;" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding NextToStage4Command}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ STAGE 4: CONFIRM & PLACE ═══════════ -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource StageHeaderToggle}"
                                      IsChecked="{Binding Stage4Expanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StageNumberCircleBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage4Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage4Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage4Complete}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="4" Style="{StaticResource StageNumberText}"/>
                                    </Border>
                                    <TextBlock Text="Confirm &amp; Place" Style="{StaticResource StageTitleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Review final plan and create sheets" Style="{StaticResource StageSubtitleText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Stage4Expanded}" Value="True"/>
                                                            <Condition Binding="{Binding Stage4Complete}" Value="False"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </MultiDataTrigger>
                                                    <DataTrigger Binding="{Binding Stage4Complete}" Value="True">
                                                        <Setter Property="Background" Value="#E4F3EA"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stage4StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextPending}">
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding Stage4Expanded}" Value="True"/>
                                                                <Condition Binding="{Binding Stage4Complete}" Value="False"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                        </MultiDataTrigger>
                                                        <DataTrigger Binding="{Binding Stage4Complete}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#9662;" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage4Expanded}" Value="False">
                                                        <Setter Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushCardBorder}"
                                Visibility="{Binding Stage4Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="14">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Final Placement Plan (Read-Only)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                                    <DataGrid ItemsSource="{Binding AllPlacements}"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              MaxHeight="360">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Sheet #" Width="70" Binding="{Binding AssignedSheet.SheetIndex}"/>
                                            <DataGridTextColumn Header="Sheet Name" Width="180" Binding="{Binding AssignedSheet.GeneratedName}"/>
                                            <DataGridTextColumn Header="View" Width="*" Binding="{Binding View.Name}"/>
                                            <DataGridTextColumn Header="Location" Width="140" Binding="{Binding Position}"/>
                                            <DataGridTextColumn Header="Scale" Width="80" Binding="{Binding View.ScaleLabel}"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource BrushLogBg}" CornerRadius="6" Padding="10" MaxHeight="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Logs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                                   Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&lt; Back to Suggested Placement" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                            Command="{Binding BackToStage3Command}"/>
                                    <Button Content="Export Logs (.txt)" Style="{StaticResource OutlineButton}"
                                            Command="{Binding ExportLogsCommand}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel" Style="{StaticResource OutlineButton}" Margin="0,0,8,0"
                                            Command="{Binding CloseCommand}"/>
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding PlaceViewsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Placing..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="Place Views" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ═══════════ STAGE 5: PLACEMENT COMPLETE ═══════════ -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource StageHeaderToggle}"
                                      IsChecked="{Binding Stage5Expanded, Mode=TwoWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StageNumberCircleBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage5Expanded}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushTextDisabled}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="5" Style="{StaticResource StageNumberText}"/>
                                    </Border>
                                    <TextBlock Text="Placement Complete" Style="{StaticResource StageTitleText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Open created sheets in Revit" Style="{StaticResource StageSubtitleText}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Margin="0,0,10,0">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource StatusBadgeBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage5Expanded}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                                <Setter Property="Background" Value="{StaticResource BrushSystemTertiaryBackground}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stage5StatusLabel}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusBadgeTextPending}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Stage5Expanded}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                    <TextBlock Text="&#9662;" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="0"/>
                                        </TextBlock.LayoutTransform>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Stage5Expanded}" Value="False">
                                                        <Setter Property="LayoutTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="-90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushCardBorder}"
                                Visibility="{Binding Stage5Expanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Margin="14">

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Newly Created Sheets" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                                Command="{Binding SelectAllSheetsToOpenCommand}"/>
                                        <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearSheetsToOpenCommand}"/>
                                    </StackPanel>

                                    <DataGrid ItemsSource="{Binding SuggestedSheets}"
                                              Style="{StaticResource StandardDataGrid}"
                                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                              CellStyle="{StaticResource StandardDataGridCell}"
                                              RowStyle="{StaticResource StandardDataGridRow}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridCheckBoxColumn Header="Open?" Width="70" Binding="{Binding OpenAfterPlacement, UpdateSourceTrigger=PropertyChanged}"/>
                                            <DataGridTextColumn Header="Sheet Number" Width="140" Binding="{Binding AssignedSheetNumber}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Sheet Name" Width="*" Binding="{Binding GeneratedName}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Views Placed" Width="110" Binding="{Binding TotalViewCount}" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="Status" Width="100" Binding="{Binding StatusText}" IsReadOnly="True"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                               Text="Check the sheets you want opened in Revit after closing this dialog. Unchecked sheets remain created but closed."/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource SectionCard}">
                                <StackPanel Margin="12">
                                    <TextBlock Text="Activity Log" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                    <Border Background="{StaticResource BrushLogBg}" CornerRadius="6" Padding="10" MaxHeight="140">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Logs}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock FontFamily="Consolas" FontSize="11"
                                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                                   Text="{Binding}" TextWrapping="Wrap"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Left" Content="Export Logs (.txt)" Style="{StaticResource OutlineButton}"
                                        Command="{Binding ExportLogsCommand}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Command="{Binding OpenSelectedAndCloseCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Opening..." Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <TextBlock Text="Open Selected &amp; Close" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Close" Style="{StaticResource OutlineButton}"
                                            Command="{Binding CloseCommand}"/>
                                </StackPanel>
                            </Grid>

                        </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
