<Window x:Class="Revit26_Plugin.Tools.ViewSheetPlacer.ViewSheetPlacerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Revit26_Plugin.Tools.ViewSheetPlacer"
        xmlns:models="clr-namespace:Revit26_Plugin.Shared.Models"
        mc:Ignorable="d"
        Title="View Sheet Placer  V001"
        Height="760" Width="1180"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        d:DataContext="{d:DesignInstance Type=local:ViewSheetPlacerViewModel}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <models:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <models:InverseBoolConverter x:Key="InverseBool"/>
            <models:StringEqualsConverter x:Key="StringEquals"/>
            <models:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="View Sheet Placer" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="V001" Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="14"
              IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: view grid -->
            <Border Grid.Column="0" Style="{StaticResource SectionCard}" Margin="0,0,12,0" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Project Views" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                    <!-- toolbar 1 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Width="280" Margin="0,0,8,0"
                                 Style="{StaticResource StyledTextInput}"
                                 Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Width="110" Margin="0,0,8,0"
                                  Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding PlacedFilterOptions}"
                                  SelectedItem="{Binding PlacedFilter}"/>
                        <Button Content="Select All" Command="{Binding SelectAllCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Clear" Command="{Binding ClearSelectionCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Refresh" Command="{Binding RefreshCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                    </StackPanel>

                    <!-- toolbar 2: custom parameter filter -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox Width="150" Margin="0,0,8,0"
                                  Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding ParameterNames}"
                                  SelectedItem="{Binding SelectedParameter}"/>
                        <TextBox Width="200" Margin="0,0,8,0"
                                 Style="{StaticResource StyledTextInput}"
                                 Text="{Binding ParameterValueFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Apply" Command="{Binding ApplyParameterFilterCommand}"
                                Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                        <Button Content="Clear" Command="{Binding ClearParameterFilterCommand}"
                                Style="{StaticResource SmallSecondaryButton}"/>
                    </StackPanel>

                    <!-- Navy header, checkbox-driven selection (no native row recolor):
                         ColumnHeaderStyle = navy Standard*, but RowStyle/CellStyle use the
                         lightweight set so clicking a row never fights the checkbox state. -->
                    <DataGrid Grid.Row="3"
                              ItemsSource="{Binding ViewsView}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              Style="{StaticResource StandardDataGrid}"
                              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Width="32"
                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"/>
                            <DataGridTextColumn Header="View Name" Width="*"
                                Binding="{Binding ViewName}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="View Type" Width="120"
                                Binding="{Binding ViewType}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Scale" Width="70"
                                Binding="{Binding Scale}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Placed?" Width="90"
                                Binding="{Binding PlacedDisplay}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Discipline" Width="120"
                                Binding="{Binding Discipline}" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: options -->
            <StackPanel Grid.Column="1">
                <Border Style="{StaticResource SectionCard}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Sheet Setup" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>

                        <TextBlock Text="Titleblock" Style="{StaticResource FieldLabel}"/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding Titleblocks}"
                                  SelectedItem="{Binding SelectedTitleblock}"
                                  DisplayMemberPath="Display" Margin="0,0,0,4"/>
                        <TextBlock Text="No titleblock types found in this project."
                                   Style="{StaticResource HintText}"
                                   Foreground="{StaticResource BrushDanger}"
                                   Visibility="{Binding NoTitleblocks, Converter={StaticResource BoolToVis}}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Sheet Name Prefix" Style="{StaticResource FieldLabel}"/>
                        <TextBox MaxLength="25" Style="{StaticResource BoxedTextInput}"
                                 Text="{Binding SheetNamePrefix, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Sheets auto-numbered: prefix + 001, 002..."
                                   Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Grouping" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <RadioButton Content="Group by Discipline" GroupName="grp" Margin="0,2"
                            IsChecked="{Binding Grouping, ConverterParameter=Discipline,
                                        Converter={StaticResource StringEquals}}"/>
                        <RadioButton Content="Group by View Type" GroupName="grp" Margin="0,2"
                            IsChecked="{Binding Grouping, ConverterParameter=ViewType,
                                        Converter={StaticResource StringEquals}}"/>
                        <TextBlock Text="Views sorted largest-first per group"
                                   Style="{StaticResource HintText}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Placement Options" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                        <CheckBox Content="Skip already-placed views" Margin="0,2"
                                  IsChecked="{Binding SkipAlreadyPlaced}"/>
                        <TextBlock Text="On: leave placed views where they are. Off: move them to a new sheet."
                                   Style="{StaticResource HintText}"/>
                        <CheckBox Content="Show viewport titles" Margin="0,6,0,2"
                                  IsChecked="{Binding ShowViewportTitles}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Metrics + Log -->
        <Grid Grid.Row="2" Margin="14,0,14,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <UniformGrid Grid.Row="0" Columns="3" Rows="1" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="PLACED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0,6,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="SKIPPED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="6,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        <TextBlock Text="FAILED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Log panel — always dark, per shared Log Panel brushes -->
            <Border Grid.Row="1" Background="{StaticResource BrushLogBg}" CornerRadius="10">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="110"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="RUN LOG" Foreground="{StaticResource BrushLogTextDim}"
                               FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                    <ListBox Grid.Row="1" x:Name="LogList"
                             ItemsSource="{Binding Logs}"
                             SelectionMode="Extended"
                             SelectionChanged="LogList_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="2,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="11"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}">
                                    <Run Text="["/><Run Text="{Binding Time, StringFormat=HH:mm:ss}"/><Run Text="] "/>
                                    <Run Text="{Binding Message}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Copy All" Command="{Binding CopyAllLogsCommand}"
                                Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                        <Button Content="Copy Selected" Command="{Binding CopySelectedLogsCommand}"
                                Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                        <Button Content="Export Logs (.txt)" Command="{Binding ExportLogsCommand}"
                                Style="{StaticResource DarkGhostButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="3" Background="{StaticResource BrushSystemSecondaryBackground}" Padding="14,10">
            <Grid>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource StatusText}">
                    <Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" view(s) selected"/>
                </TextBlock>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Dry Run" Command="{Binding DryRunCommand}"
                            Style="{StaticResource OutlineButton}" Margin="0,0,8,0"/>
                    <Button Content="Run" Command="{Binding RunCommand}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="Close_Click" IsCancel="True"
                            Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
