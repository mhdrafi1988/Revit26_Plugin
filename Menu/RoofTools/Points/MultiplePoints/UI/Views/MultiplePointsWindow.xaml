<Window x:Class="Revit26_Plugin.MultiplePoints.V001.UI.Views.MultiplePointsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Multiple Points — V001"
        Width="760" Height="700"
        MinWidth="760" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemSecondaryBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared converter: LogLevel → coloured brush -->
            <conv:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 header bar -->
            <RowDefinition Height="10"/>     <!-- 1 -->
            <RowDefinition Height="Auto"/>   <!-- 2 settings title -->
            <RowDefinition Height="Auto"/>   <!-- 3 settings panel -->
            <RowDefinition Height="8"/>      <!-- 4 -->
            <RowDefinition Height="Auto"/>   <!-- 5 edges toolbar -->
            <RowDefinition Height="*" MinHeight="150"/> <!-- 6 edges grid -->
            <RowDefinition Height="8"/>      <!-- 7 -->
            <RowDefinition Height="Auto"/>   <!-- 8 log title -->
            <RowDefinition Height="130"/>    <!-- 9 log panel -->
            <RowDefinition Height="12"/>     <!-- 10 -->
            <RowDefinition Height="Auto"/>   <!-- 11 close -->
        </Grid.RowDefinitions>

        <!-- ── Header bar ── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Multiple Points" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"
                           Text="Select a roof, then add shape-edit points at each edge's midpoint and/or quarter points. Optionally add extra points on edges longer than a threshold, so no gap exceeds it. Works at any slope; optionally cap it to exclude steeper facets. Applies to every edge type — lines, arcs, splines."/>
            </StackPanel>
        </Border>

        <!-- ── Settings ── -->
        <TextBlock Grid.Row="2" Text="POINTS TO ADD" Style="{StaticResource SectionTitle}"/>
        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Padding="12,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="Midpoint (1/2)" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.AddMidpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Quarter points (1/4, 3/4)" Margin="24,0,0,0" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.AddQuarterPoints, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <CheckBox Content="Add extra points on edges longer than:" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.AddExtraOnLongEdges, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="62" Margin="8,0,0,0"
                              IsEnabled="{Binding Settings.AddExtraOnLongEdges}"
                              Text="{Binding Settings.ThresholdMeters, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="m" Style="{StaticResource UnitLabel}"/>
                    <TextBlock Text="(max spacing on that edge is capped at the threshold)"
                               Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Limit to roof slope under:" VerticalAlignment="Center"
                              IsChecked="{Binding Settings.LimitMaxSlope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBox Style="{StaticResource BoxedTextInput}" Height="26" Padding="6,2" Width="62" Margin="8,0,0,0"
                              IsEnabled="{Binding Settings.LimitMaxSlope}"
                              Text="{Binding Settings.MaxSlopePercent, StringFormat=F2, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="%" Style="{StaticResource UnitLabel}"/>
                    <TextBlock Text="(edges on steeper facets are hidden and excluded from Apply)"
                               Style="{StaticResource HintText}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Edges toolbar ── -->
        <Grid Grid.Row="5" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="EDGES" Style="{StaticResource SectionTitle}" Margin="0,0,10,0"/>
                <Button Content="Select All"  Style="{StaticResource SmallSecondaryButton}" Width="86" Command="{Binding SelectAllCommand}"/>
                <Button Content="Select None" Style="{StaticResource SmallSecondaryButton}" Width="86" Margin="6,0,0,0" Command="{Binding SelectNoneCommand}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding TotalPreviewPoints, StringFormat='Total preview: {0} point(s)'}"
                       Style="{StaticResource HintText}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0"/>
            <Button Grid.Column="2" Content="Apply Points" Style="{StaticResource PrimaryButton}"
                    Width="150" Command="{Binding ApplyCommand}"/>
        </Grid>

        <!-- ── Edges grid ── -->
        <DataGrid Grid.Row="6" Margin="0,6,0,0"
                  ItemsSource="{Binding Edges}"
                  Style="{StaticResource StandardDataGrid}"
                  ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DataGridCellStyle}"
                  RowStyle="{StaticResource DataGridRowStyle}"
                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  RowHeight="34">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="✓" Width="40">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="#"        Binding="{Binding Index}"                          Width="40"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Type"     Binding="{Binding CurveTypeName}"                  Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="Len (m)"  Binding="{Binding LengthM, StringFormat=F3}"       Width="85"  IsReadOnly="True"/>
                <DataGridTextColumn Header="Slope %"  Binding="{Binding FacetSlopePercent, StringFormat=F1}" Width="75" IsReadOnly="True"/>
                <DataGridTextColumn Header="Points"   Binding="{Binding PreviewPointCount}"              Width="*"   IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ── Log ── -->
        <TextBlock Grid.Row="8" Text="ACTIVITY LOG" Style="{StaticResource SectionTitle}"/>
        <Border Grid.Row="9" Background="{StaticResource BrushLogBg}" CornerRadius="8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" Padding="10,8">
                <ItemsControl ItemsSource="{Binding LogEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                           FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- ── Close ── -->
        <StackPanel Grid.Row="11" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
