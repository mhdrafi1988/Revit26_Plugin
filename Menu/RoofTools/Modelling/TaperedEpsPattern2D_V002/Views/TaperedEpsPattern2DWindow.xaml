<Window
    x:Class="Revit26_Plugin.TaperedEpsPattern2D.V002.Views.TaperedEpsPattern2DWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:Revit26_Plugin.TaperedEpsPattern2D.V002.ViewModels"
    xmlns:views="clr-namespace:Revit26_Plugin.TaperedEpsPattern2D.V002.Views"
    Title="{Binding Title}"
    Width="1180" Height="800" MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterOwner">

    <!-- Plain WPF Window for now. To use the repo's ToolWindowShell, change the root element
         (and Window.Resources) to it and change the base class in the code-behind.
         Every style/brush below is a SharedStyles token via DynamicResource: a missing key
         falls back to WPF defaults instead of failing to load. No inline colours. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <DataTemplate DataType="{x:Type vm:NumericFieldViewModel}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Label}" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding RangeHint}" Style="{DynamicResource FieldTextBox}" />
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Style="{DynamicResource FieldLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Error}" TextWrapping="Wrap"
                           Style="{DynamicResource ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LayerRowTemplate" DataType="{x:Type vm:LayerOptionViewModel}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}"
                          DisplayMemberPath="Name" IsEnabled="{Binding IsEnabled}" ToolTip="Line style" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Title}" Style="{DynamicResource ToolHeaderTitle}" />
                <TextBlock Text="{Binding Version}" Margin="12,0,0,0" VerticalAlignment="Bottom" Style="{DynamicResource ToolHeaderMeta}" />
                <TextBlock Text="{Binding RevitVersion}" Margin="12,0,0,0" VerticalAlignment="Bottom" Style="{DynamicResource ToolHeaderMeta}" />
                <TextBlock Margin="12,0,0,0" VerticalAlignment="Bottom" Style="{DynamicResource ToolHeaderMeta}">
                    <Run Text="Build " /><Run Text="{Binding BuildDate, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:MetricTileViewModel}">
                        <Border Style="{DynamicResource MetricTile}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Value}" Style="{DynamicResource MetricTileValue}" />
                                <TextBlock Text="{Binding Label}" Style="{DynamicResource MetricTileLabel}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ── Body ───────────────────────────────────────────── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Roof card -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{DynamicResource Badge}">
                                    <TextBlock Text="{Binding Roof.ShapeBadge}" />
                                </Border>
                                <TextBlock Text="Roof" Style="{DynamicResource CardTitle}" />
                            </DockPanel>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="View" Style="{DynamicResource FieldLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding Roof.ViewName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="1" Text="Roof" Style="{DynamicResource FieldLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Roof.RoofName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Row="2" Text="Level" Style="{DynamicResource FieldLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Roof.LevelName}" />
                                <TextBlock Grid.Row="3" Text="Edges" Style="{DynamicResource FieldLabel}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Roof.Edges}" />
                            </Grid>
                            <TextBlock Text="{Binding Roof.ErrorText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Style="{DynamicResource ErrorText}"
                                       Visibility="{Binding Roof.HasError, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <!-- Board settings -->
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Board Settings" Style="{DynamicResource CardTitle}" Margin="0,0,0,8" />
                            <ContentControl Content="{Binding Board.Width}" />
                            <ContentControl Content="{Binding Board.Length}" />
                            <ContentControl Content="{Binding Board.Slope}" />
                            <ContentControl Content="{Binding Board.MinThickness}" />
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Grid direction" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Board.GridDirections}"
                                          SelectedItem="{Binding Board.SelectedGridDirection}" DisplayMemberPath="Label" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Align to edge" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Board.Edges}"
                                          SelectedItem="{Binding Board.SelectedEdge}" DisplayMemberPath="Label"
                                          IsEnabled="{Binding Board.IsEdgePickerEnabled}"
                                          ToolTip="The board grid runs parallel to this roof edge (highlighted in the preview)" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Grid origin" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Board.GridOrigins}"
                                          SelectedItem="{Binding Board.SelectedGridOrigin}" DisplayMemberPath="Label" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Water falls to" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1" Text="{Binding Board.WaterFallsTo, Mode=OneWay}" IsReadOnly="True"
                                         IsEnabled="False" ToolTip="Locked in this version" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Layers -->
                    <Border Style="{DynamicResource Card}">
                        <StackPanel>
                            <TextBlock Text="Layers" Style="{DynamicResource CardTitle}" Margin="0,0,0,8" />
                            <ContentControl Content="{Binding Layers.Grid}" ContentTemplate="{StaticResource LayerRowTemplate}" />
                            <ContentControl Content="{Binding Layers.HipRidge}" ContentTemplate="{StaticResource LayerRowTemplate}" />
                            <ContentControl Content="{Binding Layers.Contours}" ContentTemplate="{StaticResource LayerRowTemplate}" />
                            <ContentControl Content="{Binding Layers.ContourInterval}" IsEnabled="{Binding Layers.Contours.IsEnabled}" />

                            <Grid Margin="0,4,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Board labels" IsChecked="{Binding Layers.LabelsEnabled}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Layers.LabelModes}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Layers.SelectedLabelMode}" IsEnabled="{Binding Layers.LabelsEnabled}" />
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Text type" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Layers.TextTypes}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding Layers.SelectedTextType}" IsEnabled="{Binding Layers.LabelsEnabled}" />
                            </Grid>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output" Style="{DynamicResource FieldLabel}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding Layers.GroupingModes}" DisplayMemberPath="Label"
                                          SelectedItem="{Binding Layers.SelectedGrouping}"
                                          ToolTip="Per-layer groups or loose lines can be moved, rotated and aligned separately in Revit" />
                            </Grid>
                            <CheckBox Content="Replace previous pattern for this roof in this view"
                                      IsChecked="{Binding Layers.ReplacePrevious}" IsEnabled="{Binding Layers.CanReplace}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{DynamicResource Card}" Padding="0">
                    <Grid>
                        <views:PatternPreviewCanvas Result="{Binding Preview.Result}"
                                                    HighlightEdgeIndex="{Binding Board.HighlightEdgeIndex}"
                                                    HoverText="{Binding Preview.HoverText, Mode=TwoWay}"
                                                    ClipToBounds="True" />
                        <TextBlock Text="Updating…" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                   Style="{DynamicResource ToolHeaderMeta}"
                                   Visibility="{Binding Preview.IsComputing, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="{Binding Preview.HoverText}" Margin="2,6,0,6" Style="{DynamicResource FieldLabel}" />

                <DataGrid Grid.Row="2" ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" CanUserAddRows="False" Style="{DynamicResource SummaryGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" Width="*" />
                        <DataGridTextColumn Header="Lines" Binding="{Binding Lines}" Width="80" />
                        <DataGridTextColumn Header="Total length m" Binding="{Binding TotalLength}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>

                <Expander Grid.Row="3" Header="Log" IsExpanded="{Binding Log.IsExpanded}" Margin="0,8,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,4,0,4">
                            <Button Content="Copy All" Command="{Binding Log.CopyAllCommand}" Style="{DynamicResource SecondaryButton}" />
                            <Button Content="Copy Selected" Margin="6,0,0,0" Style="{DynamicResource SecondaryButton}"
                                    Command="{Binding Log.CopySelectedCommand}"
                                    CommandParameter="{Binding SelectedItems, ElementName=LogList}" />
                        </StackPanel>
                        <ListBox x:Name="LogList" ItemsSource="{Binding Log.Entries}" SelectionMode="Extended" Height="120" />
                    </DockPanel>
                </Expander>
            </Grid>
        </Grid>

        <!-- ── Footer ─────────────────────────────────────────── -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="Reset" Command="{Binding ResetCommand}" Style="{DynamicResource SecondaryButton}" />
            <Button DockPanel.Dock="Right" Content="Close" Command="{Binding CloseCommand}" Margin="8,0,0,0" Style="{DynamicResource SecondaryButton}" />
            <Button DockPanel.Dock="Right" Content="Run" Command="{Binding RunCommand}" Style="{DynamicResource RunButton}" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0" Style="{DynamicResource FieldLabel}" />
        </DockPanel>
    </Grid>
</Window>
