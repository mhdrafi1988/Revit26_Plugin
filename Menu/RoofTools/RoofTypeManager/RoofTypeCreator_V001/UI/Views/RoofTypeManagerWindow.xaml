<Window x:Class="Revit26_Plugin.RoofTypeCreator.V001.UI.Views.RoofTypeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:models="clr-namespace:Revit26_Plugin.RoofTypeCreator.V001.Core.Models"
        mc:Ignorable="d"
        Title="Roof Type Manager  ·  V001"
        Height="840" Width="980"
        MinHeight="640" MinWidth="820"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:LogLevelToColorConverter    x:Key="LogLevelToColorConverter"/>
            <converters:BoolToVisibilityConverter   x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter        x:Key="InverseBoolConverter"/>

            <!-- Status pill for ImportStatus enum -->
            <Style x:Key="StatusPillBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding"      Value="7,2"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment"   Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ Window Header Bar ══════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Roof Type Manager — V001" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Export and import roof type definitions via Excel"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕  Close"
                        Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource BrushAppleBlueLight}"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- ══ Scrollable Content ════════════════════════════= -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10,12,10">
            <StackPanel>

                <!-- ─── 1. Metrics Card ────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Model Summary" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="12,0,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="TOTAL ROOF TYPES" Style="{StaticResource MetricLabel}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalRoofTypes}" Style="{StaticResource MetricNumberAccent}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="in current model" Style="{StaticResource MetricUnit}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="LAST EXPORT" Style="{StaticResource MetricLabel}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastExportDate}" Style="{StaticResource MetricNumber}"
                                               FontSize="16" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="LAST IMPORT FILE" Style="{StaticResource MetricLabel}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding LastImportFile}" Style="{StaticResource MetricValue}"
                                               FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center"
                                               TextAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 2. Export Card ─────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <!-- Section header -->
                        <Grid Margin="12,10,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Export Roof Types" Style="{StaticResource SectionTitle}" Margin="0"/>
                            <Border Grid.Column="1" Style="{StaticResource BadgePill}">
                                <TextBlock Style="{StaticResource BadgeText}">
                                    <Run Text="{Binding TotalRoofTypes, Mode=OneWay}"/>
                                    <Run Text=" types loaded"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <!-- Toolbar -->
                        <Grid Margin="12,0,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox Style="{StaticResource StyledTextInput}" Width="180"
                                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="60" Margin="0,0,6,0"/>
                                <Button Content="Select All"    Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding SelectAllCommand}"    Margin="0,0,4,0"/>
                                <Button Content="Clear"         Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearSelectionCommand}" Margin="0,0,4,0"/>
                                <Border Width="1" Background="{StaticResource BrushSeparatorThin}" Margin="4,3"/>
                                <Button Content="↺  Refresh"   Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding RefreshCommand}"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       Foreground="{StaticResource BrushTextSecondary}" FontSize="11.5">
                                <Run Text="{Binding SelectedExportCount, Mode=OneWay}"/>
                                <Run Text=" of "/>
                                <Run Text="{Binding TotalRoofTypes, Mode=OneWay}"/>
                                <Run Text=" selected"/>
                            </TextBlock>
                        </Grid>

                        <!-- Export DataGrid -->
                        <DataGrid Margin="12,0,12,0"
                                  ItemsSource="{Binding FilteredRoofTypes}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MinHeight="140" MaxHeight="280">
                            <DataGrid.Columns>
                                <!-- Checkbox -->
                                <DataGridTemplateColumn Width="34" CanUserSort="False" CanUserResize="False">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding AllExportItemsSelected, Mode=TwoWay}"
                                                  ToolTip="Select / deselect all visible"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Type Name -->
                                <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}"
                                                    Width="2*" MinWidth="130" IsReadOnly="True"
                                                    SortMemberPath="TypeName"/>

                                <!-- Type Mark -->
                                <DataGridTextColumn Header="Type Mark" Binding="{Binding TypeMark}"
                                                    Width="80" MinWidth="60" IsReadOnly="True"
                                                    SortMemberPath="TypeMark"/>

                                <!-- Function -->
                                <DataGridTextColumn Header="Function" Binding="{Binding Function}"
                                                    Width="90" MinWidth="70" IsReadOnly="True"
                                                    SortMemberPath="Function"/>

                                <!-- Layer Count — right-aligned -->
                                <DataGridTextColumn Header="Layer Count" Binding="{Binding LayerCount}"
                                                    Width="80" MinWidth="60" IsReadOnly="True"
                                                    SortMemberPath="LayerCount">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding"       Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Total Thickness — right-aligned -->
                                <DataGridTextColumn Header="Thickness (mm)"
                                                    Binding="{Binding TotalThicknessMm, StringFormat=F1}"
                                                    Width="100" MinWidth="80" IsReadOnly="True"
                                                    SortMemberPath="TotalThicknessMm">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding"       Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- File path + Export button -->
                        <Grid Margin="12,8,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource BoxedTextInput}"
                                     Text="{Binding ExportFilePath}"
                                     IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button  Grid.Column="1"
                                     Content="Browse…" Style="{StaticResource OutlineButton}"
                                     Command="{Binding BrowseExportCommand}" Margin="0,0,6,0"/>
                            <Button  Grid.Column="2"
                                     Style="{StaticResource AccentButton}"
                                     Command="{Binding ExportSelectedCommand}">
                                <TextBlock>
                                    <Run Text="Export Selected ("/>
                                    <Run Text="{Binding SelectedExportCount, Mode=OneWay}"/>
                                    <Run Text=")"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 3. Import Card ─────────────────────────── -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Import Roof Types" Style="{StaticResource SectionTitle}"/>

                        <!-- File picker -->
                        <Grid Margin="12,0,12,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource BoxedTextInput}"
                                     Text="{Binding ImportFilePath}"
                                     IsReadOnly="True" Margin="0,0,6,0"/>
                            <Button  Grid.Column="1"
                                     Content="Browse…" Style="{StaticResource OutlineButton}"
                                     Command="{Binding BrowseImportCommand}"/>
                        </Grid>

                        <!-- Preview DataGrid -->
                        <DataGrid Margin="12,0,12,0"
                                  ItemsSource="{Binding ImportPreviewItems}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  MinHeight="80" MaxHeight="200">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Sheet Name" Binding="{Binding SheetName}"
                                                    Width="100" MinWidth="80" SortMemberPath="SheetName"/>
                                <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}"
                                                    Width="2*" MinWidth="130" SortMemberPath="TypeName"/>
                                <DataGridTextColumn Header="Layer Count" Binding="{Binding LayerCount}"
                                                    Width="80" MinWidth="60" SortMemberPath="LayerCount">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding"       Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Thickness (mm)"
                                                    Binding="{Binding TotalThicknessMm, StringFormat=F1}"
                                                    Width="100" MinWidth="80" SortMemberPath="TotalThicknessMm">
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader"
                                               BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                            <Setter Property="Padding"       Value="0,0,6,0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Status pill -->
                                <DataGridTemplateColumn Header="Status" Width="80" MinWidth="60"
                                                        CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="models:ImportPreviewItem">
                                            <Border x:Name="PillBorder"
                                                    Style="{StaticResource StatusPillBorder}">
                                                <TextBlock x:Name="PillText"
                                                           FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="New">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#E3F2FD"/>
                                                    <Setter TargetName="PillText"   Property="Foreground" Value="#1565C0"/>
                                                    <Setter TargetName="PillText"   Property="Text"       Value="NEW"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Dup">
                                                    <Setter TargetName="PillBorder" Property="Background" Value="#FFF3E0"/>
                                                    <Setter TargetName="PillText"   Property="Foreground" Value="#E65100"/>
                                                    <Setter TargetName="PillText"   Property="Text"       Value="DUP"/>
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Stats + Import button -->
                        <Grid Margin="12,8,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Style="{StaticResource HintText}" Margin="0">
                                <Run Text="{Binding ImportPreviewItems.Count, Mode=OneWay}"/>
                                <Run Text=" types previewed ·  "/>
                                <Run Text="{Binding NewImportCount, Mode=OneWay}"/>
                                <Run Text=" new"/>
                            </TextBlock>
                            <Button Grid.Column="1"
                                    Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ImportCommand}">
                                <TextBlock>
                                    <Run Text="Import ("/>
                                    <Run Text="{Binding NewImportCount, Mode=OneWay}"/>
                                    <Run Text=" New)"/>
                                </TextBlock>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ─── 4. Log Panel ───────────────────────────── -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,0,0,8">
                    <StackPanel>
                        <!-- Log title bar -->
                        <Border Background="{StaticResource BrushLogTitleBar}"
                                CornerRadius="10,10,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Operation Log" FontSize="11.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextOnDark}"
                                               VerticalAlignment="Center"/>
                                    <Border Style="{StaticResource BadgePill}"
                                            Background="#1D3A5C" Margin="8,0,0,0">
                                        <TextBlock Style="{StaticResource BadgeText}"
                                                   Foreground="{StaticResource BrushAppleBlueLight}">
                                            <Run Text="{Binding LogEntries.Count, Mode=OneWay}"/>
                                            <Run Text=" entries"/>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding CopyAllLogsCommand}" Margin="0,0,6,0"/>
                                    <Button x:Name="CopySelectedBtn"
                                            Content="Copy Selected" Style="{StaticResource DarkGhostButton}"
                                            Click="CopySelectedBtn_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Log entries list -->
                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 SelectionMode="Extended"
                                 Background="Transparent" BorderThickness="0"
                                 Height="160" Padding="8,4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding"          Value="0,1"/>
                                    <Setter Property="Background"       Value="Transparent"/>
                                    <Setter Property="BorderThickness"  Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#1D3A5C"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Completion summary bar -->
                        <Border Background="#0D1E30" CornerRadius="0,0,10,10" Padding="12,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                        <Run Text="{Binding ImportedCount, Mode=OneWay}"
                                             Foreground="{StaticResource BrushLogSuccess}"/>
                                        <Run Text=" created" Foreground="{StaticResource BrushLogTextDim}"/>
                                    </TextBlock>
                                    <TextBlock Text="  |  " Foreground="{StaticResource BrushLogTextDim}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                        <Run Text="{Binding DuplicateCount, Mode=OneWay}"
                                             Foreground="{StaticResource BrushLogWarning}"/>
                                        <Run Text=" dup" Foreground="{StaticResource BrushLogTextDim}"/>
                                    </TextBlock>
                                    <TextBlock Text="  |  " Foreground="{StaticResource BrushLogTextDim}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center">
                                        <Run Text="{Binding FailedCount, Mode=OneWay}"
                                             Foreground="{StaticResource BrushLogError}"/>
                                        <Run Text=" failed" Foreground="{StaticResource BrushLogTextDim}"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding LastRunTime}"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
