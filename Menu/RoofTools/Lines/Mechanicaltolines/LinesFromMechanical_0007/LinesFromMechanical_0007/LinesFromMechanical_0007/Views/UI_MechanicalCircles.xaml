<Window x:Class="Revit26_Plugin.LinesFromMechanical.V007.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Lines from Mechanical"
        Width="520" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibility"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColor"/>
            <converters:IntToVisibilityConverter         x:Key="IntToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrushSystemBackground}"/>
        </Style>
    </Window.Style>

    <StackPanel>

        <!-- ── Header bar with version badge ──────────────────────────────── -->
        <Border Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Lines from Mechanical" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Revit 2026  ·  Linked MEP Equipment"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}"
                        CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="V007" Style="{StaticResource BadgeText}"
                               Foreground="{StaticResource BrushAppleBlueLight}"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Margin="10,10,10,14">

            <!-- ── Active view pill ──────────────────────────────────────── -->
            <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Style="{StaticResource StatusDot}"/>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Active view: " Margin="0"/>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="12" FontWeight="SemiBold"
                               Text="{Binding ActiveViewName}"/>
                </StackPanel>
            </Border>

            <!-- ── View warning ──────────────────────────────────────────── -->
            <Border Background="{StaticResource BrushWarning}" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                    Visibility="{Binding ShowViewWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ViewWarning}" TextWrapping="Wrap" Foreground="White" FontSize="12"/>
            </Border>

            <!-- ── Mode toggle ───────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="CREATION MODE"/>
                    <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                    <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                            CornerRadius="8" Margin="10,8,10,10" Padding="4">
                        <UniformGrid Rows="1" Columns="2">
                            <RadioButton Content="Detail Lines" IsChecked="{Binding IsDetailLineMode}"
                                         GroupName="Mode" IsEnabled="{Binding IsNotProcessing}"/>
                            <RadioButton Content="Floors" IsChecked="{Binding IsFloorMode}"
                                         GroupName="Mode" IsEnabled="{Binding IsNotProcessing}"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── Source ────────────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SOURCE"/>
                    <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Linked model"/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding AvailableLinks}"
                                  SelectedItem="{Binding SelectedLink}"
                                  DisplayMemberPath="Name"
                                  IsEnabled="{Binding IsNotProcessing}"/>
                    </StackPanel>
                    <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Equipment family"/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding AvailableFamilies}"
                                  SelectedItem="{Binding SelectedFamily}"
                                  IsEnabled="{Binding IsNotProcessing}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Parameters ────────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PARAMETERS"/>
                    <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>

                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Radius"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Style="{StaticResource BoxedTextInput}" Width="120"
                                     Text="{Binding RadiusText, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding IsNotProcessing}"/>
                            <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Detail Lines: colour -->
                    <StackPanel Visibility="{Binding IsDetailLineMode, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Circle colour"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding ColorOptions}"
                                      SelectedItem="{Binding SelectedColorOption}"
                                      IsEnabled="{Binding IsNotProcessing}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="16" Height="16" CornerRadius="4" Margin="0,0,8,0">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{Binding Color}"/>
                                                </Border.Background>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Floors: family / type / offset -->
                    <StackPanel Visibility="{Binding IsFloorMode, Converter={StaticResource BoolToVisibility}}">
                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Floor family"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding AvailableFloorFamilies}"
                                      SelectedItem="{Binding SelectedFloorFamily}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsNotProcessing}"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Floor type"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding AvailableFloorTypes}"
                                      SelectedItem="{Binding SelectedFloorType}"
                                      DisplayMemberPath="Name"
                                      IsEnabled="{Binding IsNotProcessing}"/>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BrushSeparatorThin}" Margin="12,0"/>
                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Level offset"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Style="{StaticResource BoxedTextInput}" Width="120"
                                         Text="{Binding FloorOffsetText, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IsNotProcessing}"/>
                                <TextBlock Style="{StaticResource UnitLabel}" Text="mm"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── Input warning (item 7) ─────────────────────────────────── -->
            <Border Background="{StaticResource BrushDanger}" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                    Visibility="{Binding ShowInputWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding InputWarning}" TextWrapping="Wrap" Foreground="White" FontSize="12"/>
            </Border>

            <!-- ── No floor types warning ─────────────────────────────────── -->
            <Border Background="{StaticResource BrushWarning}" CornerRadius="8" Padding="10,7" Margin="0,0,0,8"
                    Visibility="{Binding ShowNoFloorTypeWarning, Converter={StaticResource BoolToVisibility}}">
                <TextBlock TextWrapping="Wrap" Foreground="White" FontSize="12"
                           Text="No floor types found. Activate a floor type to use Floor mode."/>
            </Border>

            <!-- ── Preview count ──────────────────────────────────────────── -->
            <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushCardBorder}"
                    BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8"
                    Visibility="{Binding PreviewCount, Converter={StaticResource IntToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Ready to create " Margin="0"/>
                        <TextBlock Style="{StaticResource MetricNumber}" FontSize="16" Text="{Binding PreviewCount}"/>
                        <TextBlock Style="{StaticResource FieldLabel}" Text=" elements" Margin="4,0,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                            Content="Highlight in view" Command="{Binding HighlightCommand}"/>
                </Grid>
            </Border>

            <!-- ── Action row (single Run button + Close) ─────────────────── -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PrimaryButton}"
                        Command="{Binding ProcessCommand}" Margin="0,0,8,0">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="Run"
                                       Visibility="{Binding IsNotProcessing, Converter={StaticResource BoolToVisibility}}"/>
                            <TextBlock VerticalAlignment="Center" Text="Processing…"
                                       Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                        Content="Close" Command="{Binding CancelCommand}"/>
            </Grid>

            <!-- ── Log panel ──────────────────────────────────────────────── -->
            <Border Style="{StaticResource ContentCard}" Margin="0"
                    Visibility="{Binding LogEntries.Count, Converter={StaticResource IntToVisibility}}">
                <StackPanel>
                    <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Operation Log"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource DarkGhostButton}" Content="Copy"
                                        Command="{Binding CopyLogCommand}" Margin="0,0,6,0"/>
                                <Button Style="{StaticResource DarkGhostButton}" Content="Clear"
                                        Command="{Binding ClearLogCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Background="{StaticResource BrushLogBg}" CornerRadius="0,0,10,10">
                        <ItemsControl ItemsSource="{Binding LogEntries}" MaxHeight="200" Padding="0,6">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="58"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                   FontFamily="Consolas" FontSize="10.5"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   Margin="14,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Level}"
                                                   FontFamily="Consolas" FontSize="10.5" FontWeight="SemiBold"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                   FontFamily="Consolas" FontSize="10.5"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   TextWrapping="Wrap" Margin="0,0,14,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</Window>
