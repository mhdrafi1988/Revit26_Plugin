<Window x:Class="Revit26_Plugin.RoofFromDetailLines.V007.RoofFromDetailLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofFromDetailLines.V007"
        Title="Roof From Detail Lines" Height="820" Width="980" MinHeight="640" MinWidth="840"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Local converters only — see Converters.cs for rationale (avoids cross-
                 assembly XAML resolution issues seen with the shared converters). -->
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <local:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titlebar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- ── Titlebar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <TextBlock Text="Roof From Detail Lines" Style="{StaticResource HeaderTitle}" VerticalAlignment="Center"/>
                <TextBlock Text="V007" Style="{StaticResource HeaderSubtitle}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ── Content (scrollable) ─────────────────────────────────────────── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>

                <!-- Roofs to Create + Line Processing Metrics + Stranded Items, same row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Roofs to Create" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="9,3,9,6">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding MetricRoofsToCreate}" Style="{StaticResource MetricNumberSuccess}"/>
                                    <TextBlock Text="Roofs to Create" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="0,1,14,1"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding MetricWithOpenings}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="With Openings" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ContentCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Line Processing Metrics" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="9,3,9,6">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding SelectedLineCount}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Lines Selected" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding SelectedArcCount}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Arcs in Selection" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding TinyElementCount}" Style="{StaticResource MetricNumberWarning}"/>
                                    <TextBlock Text="Tiny (&lt;10mm)" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="0,1,14,1"/>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding MetricClosedLoops}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Closed Loops" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding MetricAutoClosed}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Auto-Closed" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding MetricCornerTrimmed}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Corner-Trimmed" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Style="{StaticResource ContentCard}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="Stranded Items" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Margin="9,3,9,6">
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding MetricStrandedElements}" Style="{StaticResource MetricNumberWarning}"/>
                                    <TextBlock Text="Stranded Elements" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                                <Border Width="1" Background="{StaticResource BrushSeparator}" Margin="0,1,14,1"/>
                                <StackPanel>
                                    <TextBlock Text="{Binding MetricSkipped}" Style="{StaticResource MetricNumber}"/>
                                    <TextBlock Text="Skipped Groups" Style="{StaticResource MetricLabel}"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Active View Context card -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Active View Context" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="9,3,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Active Plan View" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ActiveViewName, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Attached Level (roofs created here)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding LevelDisplay, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Roof Type + Loop Processing Settings, same row -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Roof Type" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="9,3,9,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Roof Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding RoofTypes}"
                                              SelectedItem="{Binding SelectedRoofType}"
                                              Style="{StaticResource StandardComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Name, Mode=OneWay}"/>
                                                    <Run Text=" (id "/>
                                                    <Run Text="{Binding Id.Value, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Slope" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="None (flat)" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource ContentCard}" Margin="0" VerticalAlignment="Top">
                        <StackPanel>
                            <TextBlock Text="Loop Processing Settings" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Margin="9,3,9,6">
                                <StackPanel>
                                    <TextBlock Text="Corner Clean-up Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding CornerToleranceMmText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <CheckBox IsChecked="{Binding DeleteSourceLines}" VerticalAlignment="Top" Margin="0,2,5,0"/>
                                    <TextBlock TextWrapping="Wrap" MaxWidth="320">
                                        <Run Text="Delete source detail lines after roof creation" FontSize="11"/>
                                        <LineBreak/>
                                        <Run Text="(closed &amp; corner-trimmed loops only — auto-closed loop lines and skipped lines are always kept)"
                                             FontSize="10" Foreground="{StaticResource BrushTextTertiary}"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Roof Loops Preview grid — expanded on launch, collapses after a
                     successful Run (data becomes stale until Refresh Preview). -->
                <Border Style="{StaticResource ContentCard}">
                    <Expander IsExpanded="{Binding IsLoopsPreviewExpanded}" Header="Roof Loops Preview" FontWeight="SemiBold" FontSize="11"
                              Foreground="{StaticResource BrushNavyPrimary}" Margin="9,7,9,7">
                        <StackPanel Margin="0,7,0,0">
                            <DataGrid ItemsSource="{Binding PreviewRows}"
                                      Style="{StaticResource StandardDataGrid}"
                                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                      CellStyle="{StaticResource StandardDataGridCell}"
                                      RowStyle="{StaticResource StandardDataGridRow}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      MaxHeight="220"
                                      Margin="0,0,0,4"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Roof #" Binding="{Binding RoofNumber}" Width="60">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>

                                    <DataGridTemplateColumn Header="Status" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                                                        CornerRadius="9" Padding="7,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="100"/>
                                    <DataGridTextColumn Header="Boundary Line IDs" Binding="{Binding BoundaryLineIds}" Width="200"/>
                                    <DataGridTextColumn Header="Opening Line IDs" Binding="{Binding OpeningLineIds}" Width="200"/>

                                    <DataGridTextColumn Header="Area (m²)" Binding="{Binding AreaSqM, StringFormat={}{0:0.0}}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                        <DataGridTextColumn.HeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                                <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                            </Style>
                                        </DataGridTextColumn.HeaderStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>
                </Border>

                <!-- Copiable ID outputs -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Element ID Outputs (copiable)" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="9,3,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="Auto-Closed Lines" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyAutoClosedLinesCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding AutoClosedLinesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Roofs From Auto-Closed Loops" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyRoofsFromAutoClosedCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding RoofsFromAutoClosedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="4">
                                <Grid>
                                    <TextBlock Text="Skipped Lines" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopySkippedLinesCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding SkippedLinesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="All Created Roofs" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyAllCreatedRoofsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding AllCreatedRoofsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Roofs With Openings" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyRoofsWithOpeningsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding RoofsWithOpeningsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Activity Log — collapsible, closed by default on launch (confirmed spec) -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,4">
                    <Expander IsExpanded="False" Header="Activity Log" FontWeight="SemiBold" FontSize="11"
                              Foreground="{StaticResource BrushNavyPrimary}" Margin="9,7,9,7">
                        <StackPanel Margin="0,7,0,0">
                            <Border Background="{StaticResource BrushLogBg}" Padding="6,5" CornerRadius="6">
                                <ListBox x:Name="LogListBox" ItemsSource="{Binding Logs}" Height="130"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionMode="Extended"
                                         FontFamily="Consolas" FontSize="10">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                       Text="{Binding}" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Copy All" Command="{Binding CopyAllLogsCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,5,0"/>
                                <Button x:Name="CopySelectedButton" Content="Copy Selected" Click="CopySelectedLogs_Click" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,5,0"/>
                                <Button Content="Export Logs (.txt)" Command="{Binding ExportLogsCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Footer ───────────────────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="{StaticResource BrushSystemSecondaryBackground}"
                BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid>
                <TextBlock Text="{Binding SummaryText}" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibilityConverter}}"
                           Style="{StaticResource StatusText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh Preview" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,7,0"/>
                    <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                    <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource OutlineButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
