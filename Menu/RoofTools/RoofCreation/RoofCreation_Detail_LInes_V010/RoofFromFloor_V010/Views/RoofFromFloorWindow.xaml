<Window x:Class="Revit26_Plugin.RoofFromFloor.V010.Views.RoofFromFloorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Roof From Floor"
        Height="540"
        Width="620"
        MinHeight="460"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter      x:Key="BoolToVisibility"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <converters:InverseBoolConverter           x:Key="InverseBool"/>
            <converters:LogLevelToColorConverter       x:Key="LogLevelColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Style>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrushSystemBackground}"/>
        </Style>
    </Window.Style>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar -->
            <RowDefinition Height="Auto"/>  <!-- Step 1 card -->
            <RowDefinition Height="Auto"/>  <!-- Step 2 card -->
            <RowDefinition Height="*"/>     <!-- Log panel  -->
            <RowDefinition Height="Auto"/>  <!-- Action bar -->
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER BAR ══════════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Roof From Floor Profiles" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="Revit26_Plugin.RoofFromFloor.V010  ·  Revit 2026"
                           Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- ══════════════ STEP 1 · SELECT ROOF ══════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="12,10,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Card header row -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushSystemSecondaryBackground}"
                        CornerRadius="10,10,0,0"
                        Padding="12,8">
                    <TextBlock Text="Step 1 · Select Roof  (Plan View Required)"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"/>
                </Border>

                <!-- Content row -->
                <Grid Grid.Row="1" Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active View -->
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Active View" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ActiveViewName}"
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{Binding ViewStatusColor}"/>
                    </StackPanel>

                    <!-- Selected Roof -->
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Selected Roof" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SelectedRoofName}"
                                   Style="{StaticResource FieldValue}"
                                   Foreground="{Binding RoofStatusColor}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="Select Roof"
                            Style="{StaticResource OutlineButton}"
                            Width="110"
                            VerticalAlignment="Center"
                            Command="{Binding SelectRoofCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════ STEP 2 · LINKED MODEL ══════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="12,8,12,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BrushSystemSecondaryBackground}"
                        CornerRadius="10,10,0,0"
                        Padding="12,8">
                    <TextBlock Text="Step 2 · Linked Model"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"/>
                </Border>

                <Grid Grid.Row="1" Margin="12,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="Linked Instance" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding SelectedLinkName}"
                                   Style="{StaticResource FieldValue}"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Select Link"
                            Style="{StaticResource OutlineButton}"
                            Width="110"
                            VerticalAlignment="Center"
                            Command="{Binding SelectLinkCommand}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════ LOG PANEL ══════════════ -->
        <Border Grid.Row="3"
                Margin="12,8,12,0"
                Background="{StaticResource BrushLogBg}"
                CornerRadius="10"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Log title bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushLogTitleBar}"
                        CornerRadius="10,10,0,0"
                        Padding="12,7">
                    <Grid>
                        <TextBlock Text="Live Log"
                                   Foreground="{StaticResource BrushLogText}"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Copy"
                                    Style="{StaticResource DarkGhostButton}"
                                    Margin="0,0,6,0"
                                    Command="{Binding CopyLogCommand}"/>
                            <Button Content="Clear"
                                    Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log entries -->
                <ScrollViewer Grid.Row="1"
                              x:Name="LogScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="12,8">
                    <ItemsControl ItemsSource="{Binding LogEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas"
                                           FontSize="11.5"
                                           Margin="0,1"
                                           TextWrapping="NoWrap">
                                    <Run Text="{Binding Time, StringFormat=HH:mm:ss, Mode=OneWay}"
                                         Foreground="{StaticResource BrushLogTextDim}"/>
                                    <Run Text="  "/>
                                    <Run Text="{Binding Message, Mode=OneWay}"
                                         Foreground="{Binding Level, Converter={StaticResource LogLevelColor}}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══════════════ ACTION BAR ══════════════ -->
        <Border Grid.Row="4" Margin="12,8,12,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Summary badge (shown after first run) -->
                <Border Grid.Column="0"
                        Style="{StaticResource BadgePill}"
                        HorizontalAlignment="Left"
                        Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SummaryText}"
                               Style="{StaticResource BadgeText}"/>
                </Border>

                <Button Grid.Column="1"
                        Content="▶  Start Processing"
                        Style="{StaticResource PrimaryButton}"
                        Width="148"
                        IsEnabled="{Binding CanStart}"
                        Command="{Binding StartCommand}"/>

                <Button Grid.Column="3"
                        Content="Close"
                        Style="{StaticResource OutlineButton}"
                        Width="80"
                        Command="{Binding CloseCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
