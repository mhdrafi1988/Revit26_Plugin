<Window x:Class="Revit26_Plugin.RoofFromLinkedRooms.V001.RoofFromLinkedRoomsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofFromLinkedRooms.V001"
        xmlns:shell="clr-namespace:Revit26_Plugin.Shared.Controls"
        Title="Roof From Linked Rooms" Height="820" Width="1000" MinHeight="760" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <local:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Roof From Linked Rooms"
                           Subtitle="Linked room boundaries → flat roofs, with openings"
                           Version="V001"
                           IsRunning="{Binding IsBusy}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- HEADER -->
        <shell:ToolWindowShell.HeaderContent>
            <UniformGrid Columns="6" Margin="0,0,0,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Rooms" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricTotal}" Style="{StaticResource MetricNumber}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricSelected}" Style="{StaticResource MetricNumber}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Roofs to Create" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricRoofsToCreate}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Unmapped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricUnmapped}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Created (last run)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricCreated}" Style="{StaticResource MetricNumber}" FontSize="18"/></StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel><TextBlock Text="Failed (last run)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricFailed}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/></StackPanel>
                </Border>
            </UniformGrid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- BODY -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Source &amp; Settings" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="9,3,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Linked model" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding LinkedDocuments}" SelectedItem="{Binding SelectedLinkedDocument}"
                                          DisplayMemberPath="DisplayName" Style="{StaticResource StandardComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Link instance" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding AvailableInstances}" SelectedItem="{Binding SelectedInstance}"
                                          DisplayMemberPath="DisplayName" Style="{StaticResource StandardComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Roof type (flat)" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding RoofTypes}" SelectedItem="{Binding SelectedRoofType}"
                                          DisplayMemberPath="Name" Style="{StaticResource StandardComboBox}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="Level tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding ToleranceMmText, UpdateSourceTrigger=PropertyChanged}" MaxLength="10"
                                         Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Rooms" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="9,3,9,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource BoxedTextInput}"
                                     ToolTip="Filter by room number, name or linked level"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="Select all shown" Command="{Binding SelectAllVisibleCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                                <Button Content="Clear" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid ItemsSource="{Binding FilteredRooms}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  MinHeight="160"
                                  shell:ShellBehaviors.MaxHeightRatio="0.35"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  Margin="9,0,9,8"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                                <DataGridTextColumn Header="Room" Binding="{Binding DisplayName}" IsReadOnly="True" Width="*"/>
                                <DataGridTextColumn Header="Linked level" Binding="{Binding LinkedLevelName}" IsReadOnly="True" Width="120"/>
                                <DataGridTextColumn Header="Host level (auto)" Binding="{Binding HostLevelName}" IsReadOnly="True" Width="130"/>
                                <DataGridTextColumn Header="Area" Binding="{Binding AreaDisplay, StringFormat={}{0:0.0}}" IsReadOnly="True" Width="70"/>
                                <DataGridTextColumn Header="Openings" Binding="{Binding OpeningsText}" IsReadOnly="True" Width="70"/>
                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                                                    CornerRadius="9" Padding="7,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Element ID Outputs (copiable)" Style="{StaticResource SectionTitle}"/>
                        <Grid Margin="9,3,9,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid>
                                    <TextBlock Text="All Created Roofs" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyAllCreatedRoofsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding AllCreatedRoofsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid>
                                    <TextBlock Text="Roofs With Openings" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                    <Button Content="Copy" Command="{Binding CopyRoofsWithOpeningsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                </Grid>
                                <TextBox Text="{Binding RoofsWithOpeningsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Export Logs (.txt)" Style="{StaticResource DarkGhostButton}" Command="{Binding ExportLogsCommand}" Margin="0,0,6,0"/>
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogsCommand}"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLogs_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding Logs}" MinHeight="110"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2" shell:ShellBehaviors.ForwardMouseWheel="True"
                                 Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,1"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- FOOTER -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Refresh Preview" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,7,0"/>
                <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource OutlineButton}"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
