<!--
=======================================================
File: RoofFromDetailLinesWindow.xaml
Changes vs V007 (layout only, per Revit_Plugin_UI_Standard.md):
  - Three-zone layout: fixed top (title bar + version, compact metrics
    card with every line/roof metric), middle (view context, roof type,
    loop settings, ID outputs in a ScrollViewer; loops preview grid in its
    own row — not inside the ScrollViewer), fixed footer (always-visible
    log with Copy All / Copy Selected / Export, summary, Refresh Preview ·
    Run → Close).
  - MinWidth/MinHeight = default size.
  - No behaviour change — every binding/command is the V007 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin.RoofFromDetailLines.V008.RoofFromDetailLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofFromDetailLines.V008"
        Title="Roof From Detail Lines — V008" Height="860" Width="1000" MinHeight="860" MinWidth="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Local converters only — see Converters.cs for rationale (avoids cross-
                 assembly XAML resolution issues seen with the shared converters). -->
            <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <local:StatusKindToBrushConverter x:Key="StatusKindToBrushConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Roof From Detail Lines" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Closed detail-line loops → flat roofs, with openings" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V008" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="5" Margin="12,10,12,4">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Roofs to Create" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricRoofsToCreate}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="With Openings" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricWithOpenings}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Lines Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedLineCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Arcs in Selection" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedArcCount}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Tiny (&lt;10mm)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TinyElementCount}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <UniformGrid Columns="5" Margin="12,4,12,8">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Closed Loops" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricClosedLoops}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Auto-Closed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricAutoClosed}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Corner-Trimmed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricCornerTrimmed}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Stranded Elements" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricStrandedElements}" Style="{StaticResource MetricNumberWarning}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Skipped Groups" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding MetricSkipped}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="160"/>  <!-- settings + outputs (scroll) -->
                <RowDefinition Height="Auto"/>               <!-- loops preview (grid scrolls itself) -->
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="12,0,12,0">
                <StackPanel>
                    <!-- Active View Context card -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Active View Context" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="9,3,9,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Active Plan View" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding ActiveViewName, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Attached Level (roofs created here)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding LevelDisplay, Mode=OneWay}" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Roof Type + Loop Processing Settings, same row -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource ContentCard}" Margin="0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Roof Type" Style="{StaticResource SectionTitle}"/>
                                <Grid Margin="9,3,9,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Roof Type" Style="{StaticResource FieldLabel}"/>
                                        <ComboBox ItemsSource="{Binding RoofTypes}"
                                                  SelectedItem="{Binding SelectedRoofType}"
                                                  Style="{StaticResource StandardComboBox}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock>
                                                        <Run Text="{Binding Name, Mode=OneWay}"/>
                                                        <Run Text=" (id "/>
                                                        <Run Text="{Binding Id.Value, Mode=OneWay}"/>
                                                        <Run Text=")"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Slope" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="None (flat)" IsReadOnly="True" IsEnabled="False" Style="{StaticResource BoxedTextInput}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource ContentCard}" Margin="0" VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Loop Processing Settings" Style="{StaticResource SectionTitle}"/>
                                <StackPanel Margin="9,3,9,6">
                                    <StackPanel>
                                        <TextBlock Text="Corner Clean-up Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding CornerToleranceMmText, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="10" Style="{StaticResource BoxedTextInput}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                        <CheckBox IsChecked="{Binding DeleteSourceLines}" VerticalAlignment="Top" Margin="0,2,5,0"/>
                                        <TextBlock TextWrapping="Wrap" MaxWidth="320">
                                            <Run Text="Delete source detail lines after roof creation" FontSize="11"/>
                                            <LineBreak/>
                                            <Run Text="(closed &amp; corner-trimmed loops only — auto-closed loop lines and skipped lines are always kept)"
                                                 FontSize="10" Foreground="{StaticResource BrushTextTertiary}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Copiable ID outputs -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Element ID Outputs (copiable)" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="9,3,9,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <Grid>
                                        <TextBlock Text="Auto-Closed Lines" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                        <Button Content="Copy" Command="{Binding CopyAutoClosedLinesCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Text="{Binding AutoClosedLinesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Roofs From Auto-Closed Loops" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                        <Button Content="Copy" Command="{Binding CopyRoofsFromAutoClosedCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Text="{Binding RoofsFromAutoClosedText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <Grid>
                                        <TextBlock Text="Skipped Lines" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                        <Button Content="Copy" Command="{Binding CopySkippedLinesCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Text="{Binding SkippedLinesText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <Grid>
                                        <TextBlock Text="All Created Roofs" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                        <Button Content="Copy" Command="{Binding CopyAllCreatedRoofsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Text="{Binding AllCreatedRoofsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <Grid>
                                        <TextBlock Text="Roofs With Openings" Style="{StaticResource FieldLabel}" HorizontalAlignment="Left"/>
                                        <Button Content="Copy" Command="{Binding CopyRoofsWithOpeningsCommand}" Style="{StaticResource SmallSecondaryButton}" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <TextBox Text="{Binding RoofsWithOpeningsText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                             AcceptsReturn="True" Height="38" VerticalScrollBarVisibility="Auto" Style="{StaticResource BoxedTextInput}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Roof Loops Preview grid — expanded on launch, collapses after a
                 successful Run (data becomes stale until Refresh Preview). -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="12,0,12,8">
                <Expander IsExpanded="{Binding IsLoopsPreviewExpanded}" Header="Roof Loops Preview" FontWeight="SemiBold" FontSize="11"
                          Foreground="{StaticResource BrushNavyPrimary}" Margin="9,7,9,7">
                    <StackPanel Margin="0,7,0,0">
                        <DataGrid ItemsSource="{Binding PreviewRows}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  MaxHeight="220"
                                  Margin="0,0,0,4"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Roof #" Binding="{Binding RoofNumber}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="140">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding StatusKind, Converter={StaticResource StatusKindToBrushConverter}}"
                                                    CornerRadius="9" Padding="7,1" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="100"/>
                                <DataGridTextColumn Header="Boundary Line IDs" Binding="{Binding BoundaryLineIds}" Width="200"/>
                                <DataGridTextColumn Header="Opening Line IDs" Binding="{Binding OpeningLineIds}" Width="200"/>

                                <DataGridTextColumn Header="Area (m²)" Binding="{Binding AreaSqM, StringFormat={}{0:0.0}}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Expander>
            </Border>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2">
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8" Margin="12,0,12,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                   FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Export Logs (.txt)" Style="{StaticResource DarkGhostButton}" Command="{Binding ExportLogsCommand}" Margin="0,0,6,0"/>
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogsCommand}"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLogs_Click" Margin="6,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1" x:Name="LogListBox" ItemsSource="{Binding Logs}" Height="110"
                             Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                    BorderBrush="{StaticResource BrushSeparator}" BorderThickness="0,1,0,0" Padding="14,8">
                <Grid>
                    <TextBlock Text="{Binding SummaryText}" Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibilityConverter}}"
                               Style="{StaticResource StatusText}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Refresh Preview" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource OutlineButton}" Margin="0,0,7,0"/>
                        <Button Content="Run" Command="{Binding RunCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,7,0"/>
                        <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource OutlineButton}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</Window>
