<Window x:Class="Revit26_Plugin.AutoSlopeByDrain.V004.UI.Views.AutoSlopeDrainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        mc:Ignorable="d"
        Title="AutoSlope By Drain — Revit 2026 · V004"
        Width="1080"
        Height="800"
        MinWidth="900"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated here only — never inside SharedStyles.xaml -->
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════
             LEFT PANEL — CONTROLS
        ════════════════════════════════════════ -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- App Identity Card -->
                <Border Style="{StaticResource AppIdentityCard}">
                    <StackPanel>
                        <TextBlock Text="AutoSlope by Drain" Style="{StaticResource AppName}"/>
                        <TextBlock Text="{Binding RoofSubtitle}" Style="{StaticResource AppSubtitle}"/>
                    </StackPanel>
                </Border>

                <!-- Slope Section -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Slope" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Percentage" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SlopeOptions}"
                                      Text="{Binding SlopeInput}"
                                      IsEditable="True"
                                      Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Connection Threshold" Style="{StaticResource FieldLabel}"/>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="Meters" Style="{StaticResource UnitLabel}" DockPanel.Dock="Right"/>
                                <TextBox Style="{StaticResource BorderlessTextInput}"
                                         MaxLength="10"
                                         Text="{Binding ConnectionThresholdInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Path Samples" Style="{StaticResource FieldLabel}"/>
                            <DockPanel LastChildFill="True">
                                <TextBlock Text="per edge" Style="{StaticResource UnitLabel}" DockPanel.Dock="Right"/>
                                <TextBox Style="{StaticResource BorderlessTextInput}"
                                         MaxLength="10"
                                         Text="{Binding PathSampleCountInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="Points sampled along each candidate edge to confirm it lies on the roof face. Min 2, recommended 5-20."
                                   Style="{StaticResource HintText}"
                                   Margin="12,0,12,10"/>
                    </StackPanel>
                </Border>

                <!-- Drain Detection Section -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Drain Detection" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Detection logic is unchanged — grid, filter, sort and select-all controls are in the right panel."
                                   Style="{StaticResource HintText}"
                                   Margin="12,0,12,10"/>
                    </StackPanel>
                </Border>

                <!-- Export Section -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel>
                        <TextBlock Text="Export" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource AppleToggleRow}">
                            <TextBlock Text="Export to CSV" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                            <ToggleButton Style="{StaticResource AppleToggleButton}"
                                          IsChecked="{Binding ExportToCsv}"
                                          Margin="8,0,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource SeparatorLine}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                            <DockPanel LastChildFill="True">
                                <Button Content="Browse"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource SecondaryButton}"
                                        Margin="6,0,0,0"
                                        Command="{Binding BrowseFolderCommand}"/>
                                <TextBox Style="{StaticResource BorderlessTextInput}"
                                         Text="{Binding ExportFolderPath, Mode=TwoWay}"
                                         IsReadOnly="True"
                                         Foreground="{StaticResource BrushAppleBlue}"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Run Button -->
                <Button Command="{Binding RunCommand}"
                        ToolTip="Calculate and apply slope to the selected drains"
                        Margin="0,0,0,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Run AutoSlope"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="Processing...">
                                    <Setter Property="Content" Value="Processing..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusMessage}" Value="Completed">
                                    <Setter Property="Content" Value="✓ Complete"/>
                                    <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Export Results Button -->
                <Button Content="Open Export Folder"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportResultsCommand}"
                        Margin="0,0,0,10"/>

                <!-- Status Card -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel Style="{StaticResource StatusRow}">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Note: vertices are reset to zero at drains; slope is applied outward from there."
                           Style="{StaticResource HintText}"
                           Margin="12,0,12,10"/>
            </StackPanel>
        </ScrollViewer>

        <GridSplitter Grid.Column="1"
                      Width="1"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BrushSeparator}"/>

        <!-- ════════════════════════════════════════
             RIGHT PANEL — METRICS, DRAIN GRID, LOG
        ════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Longest Path | Max Offset | Drains Selected | Slope -->
            <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Longest Path" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LongestPathDisplay}" Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="Meters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Max Offset" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding HighestElevationDisplay}" Style="{StaticResource MetricNumber}"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Drains Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedDrainsCount}" Style="{StaticResource MetricNumberSuccess}"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Slope" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SlopeInput}" Style="{StaticResource MetricNumber}"/>
                        <TextBlock Text="Percent" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2: Highest Elevation | Run Duration | Final Drain Count -->
            <UniformGrid Grid.Row="2" Columns="3" Rows="1">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Highest Elevation" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding HighestElevationDisplay}" Style="{StaticResource MetricNumberDanger}"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Run Duration" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunDuration_sec, FallbackValue=0}" Style="{StaticResource MetricNumberSuccess}"/>
                        <TextBlock Text="Seconds" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Final Drain Count" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FinalDrainCount, FallbackValue=0}" Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 4: Detected Drains grid header (filter + select all/none/invert) -->
            <Border Grid.Row="4" Style="{StaticResource ContentCard}" Margin="0">
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Detected Drains" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox ItemsSource="{Binding SizeFilters}"
                                  SelectedItem="{Binding SelectedSizeFilter}"
                                  Width="140"
                                  Style="{StaticResource StandardComboBox}"
                                  Margin="0,0,8,0"/>
                        <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                        <Button Content="Select None" Command="{Binding SelectNoneCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                        <Button Content="Invert" Command="{Binding InvertSelectionCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 6: Detected Drains DataGrid — sortable, filterable via FilteredDrainsView -->
            <DataGrid Grid.Row="6"
                      ItemsSource="{Binding FilteredDrainsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserSortColumns="True"
                      Style="{StaticResource StandardDataGrid}"
                      ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                      CellStyle="{StaticResource StandardDataGridCell}"
                      RowStyle="{StaticResource StandardDataGridRow}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="✓" Width="36" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Shape"     Binding="{Binding ShapeType}"    SortMemberPath="ShapeType"    Width="90"/>
                    <DataGridTextColumn Header="Size (mm)" Binding="{Binding SizeCategory}" SortMemberPath="SizeCategory" Width="120"/>
                    <DataGridTextColumn Header="W (mm)"    Binding="{Binding Width,  StringFormat={}{0:F0}}" SortMemberPath="Width"  Width="70"/>
                    <DataGridTextColumn Header="H (mm)"    Binding="{Binding Height, StringFormat={}{0:F0}}" SortMemberPath="Height" Width="70"/>
                    <DataGridTextColumn Header="X" Binding="{Binding CenterPoint.X, StringFormat={}{0:F0}}" Width="70"/>
                    <DataGridTextColumn Header="Y" Binding="{Binding CenterPoint.Y, StringFormat={}{0:F0}}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Row 8: Log header -->
            <Border Grid.Row="8" Background="{StaticResource BrushLogBg}" CornerRadius="6,6,0,0" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="Processing log"
                               Style="{StaticResource FieldLabel}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy selected"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopySelectedLogs_Click"
                                Width="100" Margin="0,0,6,0"/>
                        <Button Content="Copy all"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopyAllLogs_Click"
                                Width="70" Margin="0,0,6,0"/>
                        <Button Content="Clear"
                                Command="{Binding ClearLogCommand}"
                                Style="{StaticResource DarkGhostButton}"
                                Width="70"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Row 9: Log body — ListBox (multi-select) bound to LogEntries -->
            <Border Grid.Row="9" Background="{StaticResource BrushLogBg}">
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
