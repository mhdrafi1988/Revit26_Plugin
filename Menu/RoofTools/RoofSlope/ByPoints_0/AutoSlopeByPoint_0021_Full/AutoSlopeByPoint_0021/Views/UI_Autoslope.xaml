<Window x:Class="Revit26_Plugin.AutoSlopeByPoint.V021.UI.Views.AutoSlopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"       
        mc:Ignorable="d"
        Title="Auto Slope Engine - Revit 2026"
        Width="1080"
        Height="670"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SharedStyles provides all theme brushes, card styles, button styles, etc. -->
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Converters from Shared.Models registered here (NOT inside SharedStyles.xaml).
                Rule: never instantiate converters inside a shared ResourceDictionary.
            -->
            <shared:InverseBoolConverter            x:Key="InverseBool"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <shared:LogLevelToColorConverter        x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════
             LEFT PANEL — CONTROLS + LOG
        ════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- App Identity Card — title + version -->
            <Border Grid.Row="0" Style="{StaticResource AppIdentityCard}">
                <StackPanel>
                    <TextBlock Text="Auto Slope" Style="{StaticResource AppName}"/>
                    <TextBlock Text="Revit 2026 · V021" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </Border>

            <!-- Slope Section — Percentage + Threshold in one row -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Text="Slope" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Percentage" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SlopeOptions}"
                                      SelectedItem="{Binding SlopePercent, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0}%}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Threshold (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding ThresholdMeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drain Detection Section — tolerance toggle + radius in one row -->
            <Border Grid.Row="4" Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Text="Drain Detection" Style="{StaticResource SectionTitle}"/>

                    <Grid Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Tolerance" Style="{StaticResource FieldLabel}"/>
                            <ToggleButton Style="{StaticResource AppleToggleButton}"
                                          IsChecked="{Binding EnableDrainTolerance}"
                                          HorizontalAlignment="Left"
                                          Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding DrainToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EnableDrainTolerance}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Finds plumbing fixtures and roof drains within the radius of selected points."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,10"
                               Visibility="{Binding EnableDrainTolerance, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- Ridge Point Detection — V021, opt-in, off by default.
                         Reuses AppleToggleButton (same style as Tolerance above)
                         rather than introducing a new checkbox control, per the
                         "SharedStyles.xaml only" convention. -->
                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="12,0,12,0">
                        <TextBlock Text="Ridge Point Detection"
                                   Style="{StaticResource FieldValue}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding EnableRidgePointDetection}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Groups drains by proximity (using the Tolerance radius above), finds adjacent group pairs, and raises a ridge vertex between them using the farther group's Dijkstra distance."
                               Style="{StaticResource HintText}"
                               Margin="12,2,12,10"
                               Visibility="{Binding EnableRidgePointDetection, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- V021 sub-toggle: independent of the checkbox above, so ridge
                         detection can run without drawing markers. Default TRUE
                         (opt-out) whenever ridge detection itself is enabled — hence
                         only shown/relevant while EnableRidgePointDetection is checked.
                         Indented (34,0,12,0) to read as nested under the parent toggle. -->
                    <StackPanel Style="{StaticResource AppleToggleRow}"
                                Margin="34,0,12,0"
                                Visibility="{Binding EnableRidgePointDetection, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Mark ridge points in active view"
                                   Style="{StaticResource FieldLabel}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding MarkRidgePointsInView}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="Draws a red circle at each resolved ridge point, in the active view only (style, color, and size selectable below)."
                               Style="{StaticResource HintText}"
                               Margin="34,2,12,6"
                               Visibility="{Binding EnableRidgePointDetection, Converter={StaticResource BoolToVisibility}}"/>

                    <!-- V021: line style / color / radius selectors — shown only when
                         BOTH ridge detection and the marking sub-toggle are on
                         (ShowRidgeMarkerOptions computed property, see ViewModel). -->
                    <Grid Margin="34,0,12,6"
                          Visibility="{Binding ShowRidgeMarkerOptions, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Line Style" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding AvailableLineStyles}"
                                      SelectedItem="{Binding SelectedLineStyleName, Mode=TwoWay}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding AvailableMarkerColors}"
                                      SelectedItem="{Binding SelectedMarkerColorName, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>

                    <!-- V021: this field now sets the proximity tolerance against
                         the REAL Voronoi ridge line between two adjacent drain
                         groups (repurposed from the original wide-band "Corridor
                         Width" search around a straight midpoint-perpendicular
                         line) — paired with circle radius since both are size inputs. -->
                    <Grid Margin="34,0,12,6"
                          Visibility="{Binding ShowRidgeMarkerOptions, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Ridge Edge Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding RidgeCorridorWidthMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Circle Radius (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding RidgePointCircleRadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Every roof vertex within this distance of the real Voronoi ridge line between two adjacent drain groups becomes a ridge point (no limit on count)."
                               Style="{StaticResource HintText}"
                               Margin="34,0,12,6"
                               Visibility="{Binding ShowRidgeMarkerOptions, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="No line styles currently in use were found — pick a different active view/project, or draw a detail line first."
                               Style="{StaticResource HintText}"
                               Foreground="{StaticResource BrushDanger}"
                               Margin="34,0,12,6"
                               Visibility="{Binding ShowNoLineStylesWarning, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Note: Ensure roof shape editing is enabled in Revit before running."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,10"/>
                </StackPanel>
            </Border>

            <!-- Log Header -->
            <Border Grid.Row="6" Background="{StaticResource BrushLogBg}" CornerRadius="6,6,0,0" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="Processing log"
                               Style="{StaticResource FieldLabel}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy selected"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopySelectedLogs_Click"
                                Width="100" Margin="0,0,6,0"/>
                        <Button Content="Copy all"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopyAllLogs_Click"
                                Width="70" Margin="0,0,6,0"/>
                        <Button Content="Clear"
                                Command="{Binding ClearLogCommand}"
                                Width="70" Height="28"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--
                Log Panel — ListBox (multi-select) bound to LogEntries (ObservableCollection<LogEntry>).
                Each entry's foreground is driven by LogLevelToColorConverter (from Shared.Models).
                ListBox (rather than ItemsControl) so rows can be selected for "Copy selected".
                Fills remaining left-panel height (star row).
            -->
            <Border Grid.Row="7" Background="{StaticResource BrushLogBg}">
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Menlo, Monaco, Courier New, monospace"
                         FontSize="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Separator between panels -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BrushSeparator}"/>

        <!-- ════════════════════════════════════════
             RIGHT PANEL — OUTPUT + ACTIONS
        ════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Longest Path | Tolerance | Highest Elevation | Avg Slope -->
            <UniformGrid Grid.Row="0" Columns="4" Rows="1" Margin="0,0,0,6">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Longest Path" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding LongestPath_m, StringFormat=F2, FallbackValue=0.00}"
                                   Style="{StaticResource MetricNumber}" Foreground="Orange"/>
                        <TextBlock Text="Meters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Tolerance Applied" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding DrainToleranceMm, StringFormat=F0, FallbackValue=0}"
                                   Style="{StaticResource MetricNumber}" Foreground="Orange"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Highest elevation" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding HighestElevation_mm, StringFormat=F0, FallbackValue=0}"
                                   Style="{StaticResource MetricNumber}" Foreground="Red"/>
                        <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Avg slope applied" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding AvgSlopePercent, FallbackValue=0, StringFormat=F1}"
                                   Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="Percent" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2: Run duration | Vertices skipped | Picked Drain | Final Drain -->
            <UniformGrid Grid.Row="2" Columns="4" Rows="1" Margin="0,0,0,6">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Run duration" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunDuration_sec, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSuccess}"/>
                        <TextBlock Text="Seconds" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Vertices skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VerticesSkipped, FallbackValue=0}"
                                   Style="{StaticResource MetricNumber}" Foreground="BlueViolet"/>
                        <TextBlock Text="Boundary" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Picked Drain" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PickedDrainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricNumber}" Foreground="Cyan"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Final Drain Count" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FinalDrainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricNumber}" Foreground="YellowGreen"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 4: Percentage applied | Vertices processed | Ridge Points Resolved | Ridge Pairs Skipped -->
            <!-- V021: extended from 2 to 4 columns to add the two new Ridge Point
                 Detection metric cards, per confirmed decision (add extra cards,
                 don't replace existing ones). -->
            <UniformGrid Grid.Row="4" Columns="4" Rows="1" Margin="0,0,0,6">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Percentage applied" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SlopePercent, FallbackValue=0, StringFormat=F1}"
                                   Style="{StaticResource MetricNumber}" Foreground="DarkOrange"/>
                        <TextBlock Text="Percent" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Vertices processed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding VerticesProcessed, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberAccent}"/>
                        <TextBlock Text="Vertices" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Ridge Points" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RidgePointsResolved, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSuccess}"/>
                        <TextBlock Text="Resolved" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Ridge Pairs Skipped" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RidgePairsSkipped, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberWarning}"/>
                        <TextBlock Text="No vertex found" Style="{StaticResource MetricUnit}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!--
                Row 6: Merged bottom card — Curve handling, Ready status, Export settings,
                Run button, Export Results button. Fills remaining right-panel height (star row).
            -->
            <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="12" VerticalAlignment="Stretch">
                <StackPanel>

                    <!-- Curve Handling toggle -->
                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="0,0,0,0">
                        <TextBlock Text="Curve handling — insert intersection points"
                                   Style="{StaticResource FieldValue}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding InsertCurveIntersectionPoints}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>

                    <TextBlock Text="When a path edge overlaps an arc (boundary or opening), inserts real roof shape points at the entry/exit locations so distances and elevations follow the true arc length instead of a straight chord."
                               Style="{StaticResource HintText}"
                               Margin="0,0,0,8"
                               Visibility="{Binding InsertCurveIntersectionPoints, Converter={StaticResource BoolToVisibility}}"/>

                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                    <!-- Ready / status -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                    <!-- Export -->
                    <TextBlock Text="Export" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>

                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="0,0,0,4">
                        <TextBlock Text="Export to Excel" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding ExportToExcel}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                        <DockPanel LastChildFill="True">
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Margin="6,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding ExportFolderPath, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     Foreground="{StaticResource BrushAppleBlue}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Run Button -->
                    <Button Command="{Binding RunCommand}"
                            ToolTip="Calculate and apply slope to roof"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Run AutoSlope"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Processing...">
                                        <Setter Property="Content" Value="Processing..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Completed">
                                        <Setter Property="Content" Value="✓ Complete"/>
                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Export Summary Button -->
                    <Button Content="Export Results"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportResultsCommand}"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
