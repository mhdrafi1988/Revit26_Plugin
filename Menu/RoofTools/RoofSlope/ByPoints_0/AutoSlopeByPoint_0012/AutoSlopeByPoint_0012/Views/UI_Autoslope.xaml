<Window x:Class="Revit26_Plugin.AutoSlopeByPoint.V012.UI.Views.AutoSlopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"       
        mc:Ignorable="d"
        Title="Auto Slope Engine - Revit 2026"
        Width="1080"
        Height="700"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SharedStyles provides all theme brushes, card styles, button styles, etc. -->
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Converters from Shared.Models registered here (NOT inside SharedStyles.xaml).
                Rule: never instantiate converters inside a shared ResourceDictionary.
            -->
            <shared:InverseBoolConverter            x:Key="InverseBool"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <shared:LogLevelToColorConverter        x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════
             HEADER — navy bar with title + version badge
        ════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Right"
                        Background="#1FFFFFFF"
                        CornerRadius="9"
                        Padding="9,3"
                        VerticalAlignment="Center">
                    <TextBlock Text="V012" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextOnDark}"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Auto Slope Engine" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Revit 2026 · stale editor + window owner fix" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ════════════════════════════════════════
             BODY
        ════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="14,0,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="222"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ════════════════════════════════════════
                 LEFT PANEL — CONTROLS
            ════════════════════════════════════════ -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Slope Section -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Slope" Style="{StaticResource SectionTitle}" Margin="10,8,10,4"/>

                            <StackPanel Margin="10,2,10,4">
                                <TextBlock Text="Percentage" Style="{StaticResource FieldLabel}" FontSize="10"/>
                                <ComboBox FontSize="10" Height="24"
                                          ItemsSource="{Binding SlopeOptions}"
                                          SelectedItem="{Binding SlopePercent, Mode=TwoWay}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StringFormat={}{0}%}" FontSize="10"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}" Margin="10,0"/>

                            <StackPanel Margin="10,4,10,8">
                                <TextBlock Text="Threshold distance" Style="{StaticResource FieldLabel}" FontSize="10"/>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Meters" Style="{StaticResource UnitLabel}" FontSize="10" DockPanel.Dock="Right"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             FontSize="10"
                                             MaxLength="10"
                                             Text="{Binding ThresholdMeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Drain Detection Section -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Drain Detection" Style="{StaticResource SectionTitle}" Margin="10,8,10,4"/>

                            <StackPanel Orientation="Horizontal" Margin="10,4" VerticalAlignment="Center">
                                <TextBlock Text="enable tolerance" FontSize="10" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding EnableDrainTolerance}"
                                              Margin="8,0,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}" Margin="10,0"/>

                            <StackPanel Margin="10,4,10,4">
                                <TextBlock Text="tolerance radius" Style="{StaticResource FieldLabel}" FontSize="10"/>
                                <DockPanel LastChildFill="True">
                                    <TextBlock Text="Milli Meters" Style="{StaticResource UnitLabel}" FontSize="10" DockPanel.Dock="Right"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             FontSize="10"
                                             MaxLength="10"
                                             Text="{Binding DrainToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding EnableDrainTolerance}"/>
                                </DockPanel>
                            </StackPanel>

                            <TextBlock Text="Finds plumbing fixtures and roof drains within the radius of selected points."
                                       Style="{StaticResource HintText}"
                                       FontSize="9.5"
                                       Margin="10,0,10,8"
                                       Visibility="{Binding EnableDrainTolerance, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Curve Handling Section -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Curve Handling" Style="{StaticResource SectionTitle}" Margin="10,8,10,4"/>

                            <StackPanel Orientation="Horizontal" Margin="10,4,10,8" VerticalAlignment="Center">
                                <TextBlock Text="insert intersection points on curves" FontSize="10"
                                           Style="{StaticResource FieldValue}" VerticalAlignment="Center"
                                           TextWrapping="Wrap" Width="150"/>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding InsertCurveIntersectionPoints}"
                                              Margin="8,0,0,0" VerticalAlignment="Top"/>
                            </StackPanel>

                            <TextBlock Text="Inserts real roof shape points at arc entry/exit locations so distances and elevations follow the true arc length."
                                       Style="{StaticResource HintText}"
                                       FontSize="9.5"
                                       Margin="10,0,10,8"
                                       Visibility="{Binding InsertCurveIntersectionPoints, Converter={StaticResource BoolToVisibility}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Export Settings Section -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel>
                            <TextBlock Text="Export" Style="{StaticResource SectionTitle}" Margin="10,8,10,4"/>

                            <StackPanel Orientation="Horizontal" Margin="10,4" VerticalAlignment="Center">
                                <TextBlock Text="Export to Excel" FontSize="10" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                                <ToggleButton Style="{StaticResource AppleToggleButton}"
                                              IsChecked="{Binding ExportToExcel}"
                                              Margin="8,0,0,0"/>
                            </StackPanel>

                            <Border Style="{StaticResource SeparatorLine}" Margin="10,0"/>

                            <StackPanel Margin="10,4,10,8">
                                <TextBlock Text="Folder" Style="{StaticResource FieldLabel}" FontSize="10"/>
                                <DockPanel LastChildFill="True">
                                    <Button Content="Browse"
                                            FontSize="10"
                                            DockPanel.Dock="Right"
                                            Margin="6,0,0,0"
                                            Command="{Binding BrowseFolderCommand}"/>
                                    <TextBox Style="{StaticResource BorderlessTextInput}"
                                             FontSize="10"
                                             MaxLength="25"
                                             Text="{Binding ExportFolderPath, Mode=TwoWay}"
                                             IsReadOnly="True"
                                             Foreground="{StaticResource BrushAppleBlue}"/>
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Run Button -->
                    <Button Command="{Binding RunCommand}"
                            ToolTip="Calculate and apply slope to roof"
                            Height="34"
                            Margin="0,0,0,6">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Run AutoSlope"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Processing...">
                                        <Setter Property="Content" Value="Processing..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Completed">
                                        <Setter Property="Content" Value="✓ Complete"/>
                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Export Summary Button -->
                    <Button Content="Export Results"
                            FontSize="10.5"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportResultsCommand}"
                            Margin="0,0,0,8"/>

                    <!-- Status Card -->
                    <Border Style="{StaticResource ContentCard}">
                        <StackPanel Orientation="Horizontal" Margin="10,7">
                            <Ellipse Style="{StaticResource StatusDot}"/>
                            <TextBlock Text="{Binding StatusMessage}" FontSize="10" Style="{StaticResource StatusText}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Note: Ensure roof shape editing is enabled in Revit before running."
                               Style="{StaticResource HintText}"
                               FontSize="9.5"
                               Margin="10,0,10,8"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Separator between panels -->
            <GridSplitter Grid.Column="1"
                          Width="1"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BrushSeparator}"/>

            <!-- ════════════════════════════════════════
                 RIGHT PANEL — OUTPUT
            ════════════════════════════════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Longest Path | Highest Elevation | Vertices Processed | Vertices Skipped -->
                <UniformGrid Grid.Row="0" Columns="4" Rows="1">
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Longest Path" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding LongestPath_m, StringFormat=F2, FallbackValue=0.00}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="Orange"/>
                            <TextBlock Text="Meters" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Highest elevation" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding HighestElevation_mm, StringFormat=F0, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="Red"/>
                            <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Vertices processed" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding VerticesProcessed, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumberAccent}"/>
                            <TextBlock Text="Vertices" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Vertices skipped" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding VerticesSkipped, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="BlueViolet"/>
                            <TextBlock Text="Boundary" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 2: Tolerance Applied | Picked Drain | Final Drain Count | Percentage Applied -->
                <UniformGrid Grid.Row="2" Columns="4" Rows="1">
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="0,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Tolerance Applied" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding DrainToleranceMm, StringFormat=F0, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="Orange"/>
                            <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Picked Drain" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding PickedDrainCount, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="Cyan"/>
                            <TextBlock Text="Detected" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="Final Drain Count" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding FinalDrainCount, FallbackValue=0}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="YellowGreen"/>
                            <TextBlock Text="Detected" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Padding="8,8" Margin="3,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Percentage Applied" Style="{StaticResource MetricLabel}" FontSize="9"/>
                            <TextBlock Text="{Binding SlopePercent, FallbackValue=0, StringFormat=F1}"
                                       FontSize="17" Style="{StaticResource MetricNumber}" Foreground="DarkOrange"/>
                            <TextBlock Text="Percent" Style="{StaticResource MetricUnit}" FontSize="8.5"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Row 4: Log Header -->
                <Border Grid.Row="4" Background="{StaticResource BrushLogBg}" CornerRadius="6,6,0,0" Padding="9,6">
                    <DockPanel>
                        <TextBlock Text="Processing log"
                                   FontSize="10"
                                   Style="{StaticResource FieldLabel}"
                                   Foreground="{StaticResource BrushLogTextDim}"
                                   VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Copy All"
                                    Style="{StaticResource DarkGhostButton}"
                                    Width="62" Height="22" Margin="0,0,5,0"
                                    Click="CopyAllLogs_Click"/>
                            <Button Content="Copy Selected"
                                    Style="{StaticResource DarkGhostButton}"
                                    Width="86" Height="22" Margin="0,0,5,0"
                                    Click="CopySelectedLogs_Click"/>
                            <Button Content="Clear"
                                    Style="{StaticResource DarkGhostButton}"
                                    Width="56" Height="22"
                                    Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--
                    Row 5: Log Panel — ListBox bound to LogEntries (ObservableCollection<LogEntry>).
                    ListBox (not ItemsControl) so rows are individually selectable for "Copy Selected".
                    Each entry's foreground is driven by LogLevelToColorConverter (from Shared.Models).
                -->
                <Border Grid.Row="5" Background="{StaticResource BrushLogBg}">
                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding LogEntries}"
                             SelectionMode="Extended"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas, Menlo, Monaco, Courier New, monospace"
                             FontSize="10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
