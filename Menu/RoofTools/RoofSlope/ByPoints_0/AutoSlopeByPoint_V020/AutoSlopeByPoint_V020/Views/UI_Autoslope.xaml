<Window x:Class="Revit26_Plugin.AutoSlopeByPoint.V020.UI.Views.AutoSlopeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"       
        mc:Ignorable="d"
        Title="Auto Slope Engine - Revit 2026"
        Width="1080"
        Height="670"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- SharedStyles provides all theme brushes, card styles, button styles, etc. -->
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Converters from Shared.Models registered here (NOT inside SharedStyles.xaml).
                Rule: never instantiate converters inside a shared ResourceDictionary.
            -->
            <shared:InverseBoolConverter            x:Key="InverseBool"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <shared:LogLevelToColorConverter        x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

            <!--
                V020 group-color accents — local to THIS window only, per the
                "never declare shared-looking resources in SharedStyles.xaml
                for single-tool concepts" convention. These color the Slope /
                Drain / Ridge+Curve card groups distinctly from the navy base
                theme, purely for visual grouping — SharedStyles.xaml's own
                brushes (BrushNavyPrimary etc.) are untouched and still used
                everywhere else (log panel, buttons, metric cards).
            -->
            <Color x:Key="GroupSlopeBg">#F2F7FE</Color>
            <Color x:Key="GroupSlopeBorder">#BFDBFE</Color>
            <Color x:Key="GroupSlopeAccent">#1E4FB8</Color>

            <Color x:Key="GroupDrainBg">#F1FBF6</Color>
            <Color x:Key="GroupDrainBorder">#B7E4CB</Color>
            <Color x:Key="GroupDrainAccent">#1F7A45</Color>

            <Color x:Key="GroupRidgeBg">#FFF6EE</Color>
            <Color x:Key="GroupRidgeBorder">#F5D2A8</Color>
            <Color x:Key="GroupRidgeAccent">#B3600A</Color>

            <Color x:Key="GroupCurveBg">#F5F0FF</Color>
            <Color x:Key="GroupCurveBorder">#D9C9FA</Color>
            <Color x:Key="GroupCurveAccent">#6D28D9</Color>

            <SolidColorBrush x:Key="BrushGroupSlopeBg"     Color="{StaticResource GroupSlopeBg}"/>
            <SolidColorBrush x:Key="BrushGroupSlopeBorder" Color="{StaticResource GroupSlopeBorder}"/>
            <SolidColorBrush x:Key="BrushGroupSlopeAccent" Color="{StaticResource GroupSlopeAccent}"/>

            <SolidColorBrush x:Key="BrushGroupDrainBg"     Color="{StaticResource GroupDrainBg}"/>
            <SolidColorBrush x:Key="BrushGroupDrainBorder" Color="{StaticResource GroupDrainBorder}"/>
            <SolidColorBrush x:Key="BrushGroupDrainAccent" Color="{StaticResource GroupDrainAccent}"/>

            <SolidColorBrush x:Key="BrushGroupRidgeBg"     Color="{StaticResource GroupRidgeBg}"/>
            <SolidColorBrush x:Key="BrushGroupRidgeBorder" Color="{StaticResource GroupRidgeBorder}"/>
            <SolidColorBrush x:Key="BrushGroupRidgeAccent" Color="{StaticResource GroupRidgeAccent}"/>

            <SolidColorBrush x:Key="BrushGroupCurveBg"     Color="{StaticResource GroupCurveBg}"/>
            <SolidColorBrush x:Key="BrushGroupCurveBorder" Color="{StaticResource GroupCurveBorder}"/>
            <SolidColorBrush x:Key="BrushGroupCurveAccent" Color="{StaticResource GroupCurveAccent}"/>

            <!--
                Compact metric card style — smaller padding/font than the shared
                MetricCard/MetricLabel/MetricNumber/MetricUnit styles, needed so
                14 metric cards fit into exactly 3 rows (5+5+4) instead of 5 rows.
                Local to this window since it's a size variant specific to this
                tool's metric count, not a general-purpose style.
            -->
            <Style x:Key="MetricCardSmall" TargetType="Border" BasedOn="{StaticResource MetricCard}">
                <Setter Property="Padding" Value="8,7"/>
            </Style>
            <Style x:Key="MetricLabelSmall" TargetType="TextBlock" BasedOn="{StaticResource MetricLabel}">
                <Setter Property="FontSize" Value="9"/>
                <Setter Property="Margin" Value="0,0,0,3"/>
            </Style>
            <Style x:Key="MetricNumberSmall" TargetType="TextBlock" BasedOn="{StaticResource MetricNumber}">
                <Setter Property="FontSize" Value="17"/>
            </Style>
            <Style x:Key="MetricUnitSmall" TargetType="TextBlock" BasedOn="{StaticResource MetricUnit}">
                <Setter Property="FontSize" Value="9"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════
             LEFT PANEL — CONTROLS + LOG
        ════════════════════════════════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- App Identity Card — title + version -->
            <Border Grid.Row="0" Style="{StaticResource AppIdentityCard}">
                <StackPanel>
                    <TextBlock Text="Auto Slope" Style="{StaticResource AppName}"/>
                    <TextBlock Text="Revit 2026 · V020" Style="{StaticResource AppSubtitle}"/>
                </StackPanel>
            </Border>

            <!-- Slope Section — Percentage + Threshold in one row (BLUE group) -->
            <Border Grid.Row="2" Style="{StaticResource ContentCard}"
                    Background="{StaticResource BrushGroupSlopeBg}"
                    BorderBrush="{StaticResource BrushGroupSlopeBorder}">
                <StackPanel>
                    <TextBlock Text="Slope" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource BrushGroupSlopeAccent}"/>

                    <Grid Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Percentage" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding SlopeOptions}"
                                      SelectedItem="{Binding SlopePercent, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0}%}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Threshold (m)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding ThresholdMeters, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drain Detection Section — tolerance toggle + radius in one row (GREEN group) -->
            <Border Grid.Row="4" Style="{StaticResource ContentCard}"
                    Background="{StaticResource BrushGroupDrainBg}"
                    BorderBrush="{StaticResource BrushGroupDrainBorder}">
                <StackPanel>
                    <TextBlock Text="Drain Detection" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource BrushGroupDrainAccent}"/>

                    <Grid Margin="12,0,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                            <TextBlock Text="Tolerance" Style="{StaticResource FieldLabel}"/>
                            <ToggleButton Style="{StaticResource AppleToggleButton}"
                                          IsChecked="{Binding EnableDrainTolerance}"
                                          HorizontalAlignment="Left"
                                          Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding DrainToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding EnableDrainTolerance}"
                                     MaxLength="10"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Finds plumbing fixtures and roof drains within the radius of selected points."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,10"
                               Visibility="{Binding EnableDrainTolerance, Converter={StaticResource BoolToVisibility}}"/>

                    <TextBlock Text="Note: Ensure roof shape editing is enabled in Revit before running."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,10"/>
                </StackPanel>
            </Border>

            <!-- Ridge Detection (placeholder) + Curve Handling (real) — MERGED card
                 per confirmed compromise: both are secondary/placeholder-ish, and
                 merging saves a row. PURPLE group theme (Curve's color, since Curve
                 is the "real" half of this card). -->
            <Border Grid.Row="6" Style="{StaticResource ContentCard}"
                    Background="{StaticResource BrushGroupCurveBg}"
                    BorderBrush="{StaticResource BrushGroupCurveBorder}">
                <StackPanel>
                    <TextBlock Text="Ridge Detection" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource BrushGroupRidgeAccent}"/>
                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="12,0,12,4">
                        <TextBlock Text="Enable ridge detection"
                                   Style="{StaticResource FieldValue}"
                                   VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding RidgeDetectionEnabled}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="UI only — ridge algorithm not yet implemented."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,8"/>

                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                    <TextBlock Text="Curve Handling" Style="{StaticResource SectionTitle}"
                               Foreground="{StaticResource BrushGroupCurveAccent}"/>
                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="12,0,12,4">
                        <TextBlock Text="Insert intersection points on curves"
                                   Style="{StaticResource FieldValue}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding InsertCurveIntersectionPoints}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock Text="Inserts real roof shape points where a path edge crosses an arc, so distances follow the true arc length."
                               Style="{StaticResource HintText}"
                               Margin="12,0,12,8"
                               Visibility="{Binding InsertCurveIntersectionPoints, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- Log Header -->
            <Border Grid.Row="8" Background="{StaticResource BrushLogBg}" CornerRadius="6,6,0,0" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="Processing log"
                               Style="{StaticResource FieldLabel}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Copy selected"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopySelectedLogs_Click"
                                Width="100" Margin="0,0,6,0"/>
                        <Button Content="Copy all"
                                Style="{StaticResource DarkGhostButton}"
                                Click="CopyAllLogs_Click"
                                Width="70" Margin="0,0,6,0"/>
                        <Button Content="Clear"
                                Command="{Binding ClearLogCommand}"
                                Width="70" Height="28"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!--
                Log Panel — ListBox (multi-select) bound to LogEntries (ObservableCollection<LogEntry>).
                Each entry's foreground is driven by LogLevelToColorConverter (from Shared.Models).
                ListBox (rather than ItemsControl) so rows can be selected for "Copy selected".
                Fills remaining left-panel height (star row).
            -->
            <Border Grid.Row="9" Background="{StaticResource BrushLogBg}">
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Menlo, Monaco, Courier New, monospace"
                         FontSize="10">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BrushLogTitleBar}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                       TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Separator between panels -->
        <GridSplitter Grid.Column="1"
                      Width="1"
                      HorizontalAlignment="Stretch"
                      Background="{StaticResource BrushSeparator}"/>

        <!-- ════════════════════════════════════════
             RIGHT PANEL — OUTPUT + ACTIONS
        ════════════════════════════════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 1 of 3 (5 cards): Longest Path | Tolerance Applied | Highest Elevation | Run Duration | Vertices Skipped -->
            <UniformGrid Grid.Row="0" Columns="5" Rows="1" Margin="0,0,0,5">
                <Border Style="{StaticResource MetricCardSmall}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Longest Path" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding LongestPath_m, StringFormat=F1, FallbackValue=0.0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="Orange"/>
                        <TextBlock Text="Meters" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Tolerance" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding DrainToleranceMm, StringFormat=F0, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupDrainAccent}"/>
                        <TextBlock Text="mm" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Highest Elev." Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding HighestElevation_mm, StringFormat=F0, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="Red"/>
                        <TextBlock Text="mm" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Run Duration" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding RunDuration_sec, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushSuccess}"/>
                        <TextBlock Text="Sec" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding VerticesSkipped, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="BlueViolet"/>
                        <TextBlock Text="Boundary" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 2 of 3 (5 cards): Picked Drain | Final Drain | Percentage Applied | Vertices Processed | Curves Found -->
            <UniformGrid Grid.Row="2" Columns="5" Rows="1" Margin="0,0,0,5">
                <Border Style="{StaticResource MetricCardSmall}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Picked Drain" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding PickedDrainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="Cyan"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Final Drain" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding FinalDrainCount, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="YellowGreen"/>
                        <TextBlock Text="Detected" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="% Applied" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding SlopePercent, FallbackValue=0, StringFormat=F1}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupSlopeAccent}"/>
                        <TextBlock Text="Percent" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Processed" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding VerticesProcessed, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushNavyPrimary}"/>
                        <TextBlock Text="Vertices" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Curves Found" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding CurvesFound, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupCurveAccent}"/>
                        <TextBlock Text="Arcs" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Row 3 of 3 (4 cards + 1 empty slot): Tangent Added | Tangent Path Used | Tangent Curve Count | Ridge Points Found (placeholder) -->
            <UniformGrid Grid.Row="4" Columns="5" Rows="1" Margin="0,0,0,5">
                <Border Style="{StaticResource MetricCardSmall}" Margin="0,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Tangent Added" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding TangentAdded, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupCurveAccent}"/>
                        <TextBlock Text="Hops" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Tangent Path" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding TangentPathUsed, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupCurveAccent}"/>
                        <TextBlock Text="Vertices" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="Tan. Curve Ct" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="{Binding TangentCurveCount, FallbackValue=0}"
                                   Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupCurveAccent}"/>
                        <TextBlock Text="Points" Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCardSmall}" Margin="3,0,3,0" Opacity="0.55">
                    <StackPanel>
                        <TextBlock Text="Ridge Pts (N/A)" Style="{StaticResource MetricLabelSmall}"/>
                        <TextBlock Text="—" Style="{StaticResource MetricNumberSmall}" Foreground="{StaticResource BrushGroupRidgeAccent}"/>
                        <TextBlock Text="Not impl." Style="{StaticResource MetricUnitSmall}"/>
                    </StackPanel>
                </Border>
                <Border Margin="3,0,0,0" Background="Transparent"/>
            </UniformGrid>

            <!--
                Row 6: Merged bottom card — Ready status, Export settings,
                Run button, Export Results button. Fills remaining right-panel height (star row).
                (Curve Handling toggle moved to the left-panel Ridge+Curve merged card.)
            -->
            <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="12" VerticalAlignment="Stretch">
                <StackPanel>

                    <!-- Ready / status -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Style="{StaticResource StatusDot}"/>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"/>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,8"/>

                    <!-- Export -->
                    <TextBlock Text="Export" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>

                    <StackPanel Style="{StaticResource AppleToggleRow}" Margin="0,0,0,4">
                        <TextBlock Text="Export to Excel" Style="{StaticResource FieldValue}" VerticalAlignment="Center"/>
                        <ToggleButton Style="{StaticResource AppleToggleButton}"
                                      IsChecked="{Binding ExportToExcel}"
                                      Margin="8,0,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Folder" Style="{StaticResource FieldLabel}"/>
                        <DockPanel LastChildFill="True">
                            <Button Content="Browse"
                                    DockPanel.Dock="Right"
                                    Margin="6,0,0,0"
                                    Command="{Binding BrowseFolderCommand}"/>
                            <TextBox Style="{StaticResource BorderlessTextInput}"
                                     Text="{Binding ExportFolderPath, Mode=TwoWay}"
                                     IsReadOnly="True"
                                     Foreground="{StaticResource BrushAppleBlue}"/>
                        </DockPanel>
                    </StackPanel>

                    <!-- Run Button -->
                    <Button Command="{Binding RunCommand}"
                            ToolTip="Calculate and apply slope to roof"
                            Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="Run AutoSlope"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Processing...">
                                        <Setter Property="Content" Value="Processing..."/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Setter Property="Background" Value="{StaticResource BrushWarning}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusMessage}" Value="Completed">
                                        <Setter Property="Content" Value="✓ Complete"/>
                                        <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Export Summary Button -->
                    <Button Content="Export Results"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportResultsCommand}"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
