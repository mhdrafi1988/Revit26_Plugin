<Window x:Class="Revit26_Plugin.RoofPointComparison.V001.UI.Views.RoofComparisonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        mc:Ignorable="d"
        Title="Compare Roofs — V001"
        Width="980"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="White"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ METRICS CARD — row 1: totals / differences / matched / match% ═══════════════ -->
        <UniformGrid Grid.Row="0" Columns="4" Rows="1">
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="0,0,3,0">
                <StackPanel>
                    <TextBlock Text="Total Points — A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumberAccent}">
                        <Run Text="{Binding Metrics.TotalPointsA, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.TotalPointsB, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Shape points" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Differences Found" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Metrics.DifferencesCount, Mode=OneWay}" Style="{StaticResource MetricNumber}" Foreground="Red"/>
                    <TextBlock Text="Missing + Mismatched" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Matched Points" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Metrics.MatchedCount, Mode=OneWay}" Style="{StaticResource MetricNumberSuccess}"/>
                    <TextBlock Text="Same position &amp; elevation" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,0,0">
                <StackPanel>
                    <TextBlock Text="Match Percentage" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Metrics.MatchPercentage, StringFormat=F1, Mode=OneWay}" Style="{StaticResource MetricNumber}" Foreground="DarkOrange"/>
                    <TextBlock Text="Percent" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════ METRICS CARD — row 2: elevation stats, A vs B side by side ═══════════════ -->
        <UniformGrid Grid.Row="2" Columns="5" Rows="1">
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="0,0,3,0">
                <StackPanel>
                    <TextBlock Text="Highest Elevation A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumber}" Foreground="Blue">
                        <Run Text="{Binding Metrics.HighestElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.HighestElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Lowest Elevation A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumber}" Foreground="Blue">
                        <Run Text="{Binding Metrics.LowestElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.LowestElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Average Elevation A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumber}" Foreground="BlueViolet">
                        <Run Text="{Binding Metrics.AverageElevationA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.AverageElevationB_mm, StringFormat=F0, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,3,0">
                <StackPanel>
                    <TextBlock Text="Elevation Range A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumber}" Foreground="Orange">
                        <Run Text="{Binding Metrics.ElevationRangeA_mm, StringFormat=F0, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.ElevationRangeB_mm, StringFormat=F0, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource MetricCard}" Padding="12,10" Margin="3,0,0,0">
                <StackPanel>
                    <TextBlock Text="Std Dev A / B" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Style="{StaticResource MetricNumber}" Foreground="Cyan">
                        <Run Text="{Binding Metrics.StdDevElevationA_mm, StringFormat=F1, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Metrics.StdDevElevationB_mm, StringFormat=F1, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ═══════════════ METRICS CARD — row 3: avg elevation diff (matched only) ═══════════════ -->
        <Border Grid.Row="4" Style="{StaticResource MetricCard}" Padding="12,10" HorizontalAlignment="Left" Width="280">
            <StackPanel>
                <TextBlock Text="Avg Elevation Difference (Matched, B − A)" Style="{StaticResource MetricLabel}"/>
                <TextBlock Text="{Binding Metrics.AverageElevationDiffMatched_mm, StringFormat=F2, Mode=OneWay}" Style="{StaticResource MetricNumberAccent}"/>
                <TextBlock Text="Millimeters" Style="{StaticResource MetricUnit}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════════ CONTROLS — tolerances + marker styles + actions ═══════════════ -->
        <Border Grid.Row="6" Style="{StaticResource ContentCard}" Padding="12">
            <StackPanel>
                <TextBlock Text="Comparison Tolerances" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Position Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding PositionToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Elevation Tolerance (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding ElevationToleranceMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SeparatorLine}" Margin="4,0,4,8"/>

                <TextBlock Text="Visual Markers" Style="{StaticResource SectionTitle}"
                           ToolTip="Placed in the active plan view when 'Place Markers' is run. Skipped with a warning if the active view is not a plan view."/>

                <!-- Missing Point marker -->
                <TextBlock Text="Missing Point" Style="{StaticResource FieldValue}" FontWeight="SemiBold" Margin="4,4,4,0"/>
                <Grid Margin="4,4,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ColorPalette}"
                                  SelectedItem="{Binding MissingMarkerGroup.ColorName, Mode=TwoWay}"
                                  Padding="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding MissingMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10" Padding="2"/>
                    </StackPanel>
                </Grid>

                <!-- Mismatched Elevation marker -->
                <TextBlock Text="Mismatched Elevation" Style="{StaticResource FieldValue}" FontWeight="SemiBold" Margin="4,0,4,0"/>
                <Grid Margin="4,4,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Color" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding ColorPalette}"
                                  SelectedItem="{Binding MismatchMarkerGroup.ColorName, Mode=TwoWay}"
                                  Padding="2"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Radius (mm)" Style="{StaticResource FieldLabel}"/>
                        <TextBox Style="{StaticResource BorderlessTextInput}"
                                 Text="{Binding MismatchMarkerGroup.RadiusMm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10" Padding="2"/>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SeparatorLine}" Margin="4,0,4,8"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FieldValue}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Recalculate" Command="{Binding RecalculateCommand}"
                            Style="{StaticResource OutlineButton}" Height="32" Width="120" Margin="0,0,8,0"/>
                    <Button Content="Place Markers" Command="{Binding PlaceMarkersCommand}"
                            Style="{StaticResource PrimaryButton}" Height="32" Width="130" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                            Style="{StaticResource OutlineButton}" Height="32" Width="90"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══════════════ LOG ═══════════════ -->
        <Grid Grid.Row="7" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushLogBg}" CornerRadius="6,6,0,0" Padding="10,8">
                <DockPanel>
                    <TextBlock Text="Processing log" Style="{StaticResource FieldLabel}" Foreground="{StaticResource BrushLogTextDim}" VerticalAlignment="Center"/>
                    <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearLogCommand}" Width="70" Height="28"/>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Background="{StaticResource BrushLogBg}" CornerRadius="0,0,10,10">
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding LogEntries}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontFamily="Menlo, Monaco, Courier New, monospace"
                         FontSize="10">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}" TextWrapping="Wrap">
                                <Run Text="{Binding Time, Mode=OneWay, StringFormat=[HH:mm:ss]}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding Message, Mode=OneWay}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </Grid>
</Window>
