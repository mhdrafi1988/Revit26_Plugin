<Window x:Class="Revit26_Plugin.RoomToRoofOrFloor.V001.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Room To Roof Or Floor"
        Width="480" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>

        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:LogLevelToColorConverter  x:Key="LogLevelToColorConverter"/>
    </Window.Resources>

    <StackPanel Margin="10">

        <!-- HEADER -->
        <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Room To Roof Or Floor" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Repairs room boundary, creates roof, falls back to floor"
                               Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePill}" VerticalAlignment="Center">
                    <TextBlock Text="V001" Style="{StaticResource BadgeText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ROOMS CARD -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel>
                <Grid Margin="12,10,12,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Rooms" Style="{StaticResource SectionTitle}" Margin="0"/>
                    <Border Grid.Column="1" Style="{StaticResource BadgePill}">
                        <TextBlock Text="{Binding TotalRooms, StringFormat='{}{0} selected'}" Style="{StaticResource BadgeText}"/>
                    </Border>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="12,0,12,8">
                    <TextBox Style="{StaticResource StyledTextInput}" Width="180"
                             MaxLength="25" FontSize="10"
                             Text="{Binding RoomFilter, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="All"  Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                            Command="{Binding SelectAllCommand}"/>
                    <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                            Command="{Binding SelectNoneCommand}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Rooms}"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}"
                          AutoGenerateColumns="False"
                          MaxHeight="170" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="30" Header=""/>
                        <DataGridTextColumn Binding="{Binding RoomName}" Header="Room Name" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding RoomNumber}" Header="Number" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Binding="{Binding LevelName}" Header="Level" Width="80" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- ROOF TYPE CARD -->
        <Border Style="{StaticResource SectionCard}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="Roof Type" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                    <TextBlock Text="Type used for all" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="90"/>
                    <ComboBox Style="{StaticResource StandardComboBox}" Width="230"
                              ItemsSource="{Binding RoofTypes}"
                              SelectedItem="{Binding SelectedRoofType}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
                <TextBlock Style="{StaticResource HintText}" Margin="12,4,12,0"
                           Text="If roof creation fails for a room, a floor is placed instead using the same repaired boundary and the first available floor type."/>
            </StackPanel>
        </Border>

        <!-- SUMMARY METRICS -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding TotalRooms}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                    <TextBlock Text="ROOMS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding RoofsCreated}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                    <TextBlock Text="ROOFS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="4,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding FloorsCreatedFallback}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                    <TextBlock Text="FLOORS (FALLBACK)" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="4,0,0,0">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Skipped}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                    <TextBlock Text="SKIPPED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- PROGRESS -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource HintText}" Margin="0"/>
        </StackPanel>

        <!-- RUN / CLOSE -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Run" Style="{StaticResource PrimaryButton}" Width="200"
                    Command="{Binding RunCommand}"/>
            <Button Content="Close" Style="{StaticResource OutlineButton}" Margin="8,0,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>

        <!-- LOG PANEL -->
        <Border CornerRadius="10" Background="{StaticResource BrushLogBg}">
            <StackPanel>
                <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="10,7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Activity Log" Foreground="{StaticResource BrushLogText}"
                                   FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,5,0"
                                    Click="CopyAll_Click"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,5,0"
                                    Click="CopySelected_Click"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                    Click="Clear_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="LogListBox" ItemsSource="{Binding Logs}"
                         Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended"
                         MaxHeight="130" Padding="6">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                           Foreground="{StaticResource BrushLogTextDim}" FontSize="10" FontFamily="Consolas" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Level}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           FontSize="10" FontFamily="Consolas" FontWeight="SemiBold" Width="60"/>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"
                                           FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

    </StackPanel>
</Window>
