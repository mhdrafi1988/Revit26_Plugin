<Window x:Class="Revit26_Plugin.RoomToRoofUI.RoomToRoofWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Room to Roof Tool" Height="600" Width="800"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Linked Model:" />
            <ComboBox ItemsSource="{Binding LinkedModels}" SelectedItem="{Binding SelectedLinkedModel}"  />

            <TextBlock Text="Level:" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding AvailableLevels}" SelectedItem="{Binding SelectedLevel}" />

            <TextBlock Text="Roof Type:" Margin="0,10,0,0"/>
            <ComboBox ItemsSource="{Binding RoofTypes}" SelectedItem="{Binding SelectedRoofType}" />

            <TextBlock Text="Rooms:" Margin="0,10,0,0"/>
            <DataGrid Name="RoomGrid"
                      ItemsSource="{Binding Rooms}"
                      SelectionMode="Extended"
                      AutoGenerateColumns="False"
                      SelectionChanged="RoomGrid_SelectionChanged"
                      Height="250">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding SerialNumber}" Width="30"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="100"/>
                    <DataGridTextColumn Header="Name" Binding="{Binding RoomName}" Width="200"/>
                    <DataGridTextColumn Header="Number" Binding="{Binding RoomNumber}" Width="100"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Create Roofs" Command="{Binding CreateRoofsCommand}" Margin="0,10,0,0" Width="120"/>
            <Button Content="Close" Click="Close_Click" Width="120" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>