<Window x:Class="Revit26_Plugin.RoofEdgeSections.V002.RoofEdgeSectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofEdgeSections.V002"
        Title="Roof Edge Sections — V002"
        Width="960" Height="880" MinWidth="960" MinHeight="880"
        WindowStartupLocation="Manual"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <local:StatusToEnabledConverter x:Key="StatusToEnabledConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- SELECTION SUMMARY — 5 metrics -->
        <Border Grid.Row="0" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Selection Summary" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="12,4,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="TOTAL ROOFS" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding TotalRoofsCount}" Style="{StaticResource MetricNumber}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="SECTIONS DETECTED" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding SectionsDetectedCount}" Style="{StaticResource MetricNumber}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="SECTIONS SUGGESTED" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding SectionsSuggestedCount}" Style="{StaticResource MetricNumberAccent}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="6" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="FINALLY CREATED" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding FinallyCreatedCount}" Style="{StaticResource MetricNumberSuccess}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="8" Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="8" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="SKIPPED" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- SECTION PARAMETERS — 4 per row -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Section Parameters" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="12,4,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Style="{StaticResource FieldLabel}" ToolTip="Distance the section origin is pulled back from the roof edge before the crop begins.">
                            <Run Text="Offset From Edge (mm)"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                 Text="{Binding OffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Distance the section origin is pulled back from the roof edge before the crop begins."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How far to search inward from the edge to find a nearby wall. Also used as fallback crop width if no wall is found.">
                            <Run Text="Search Distance (mm)"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                 Text="{Binding SearchDistanceMm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How far to search inward from the edge to find a nearby wall. Also used as fallback crop width if no wall is found."/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Style="{StaticResource FieldLabel}" ToolTip="Extra distance added past the found wall's far face.">
                            <Run Text="Margin Offset (mm)"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                 Text="{Binding MarginOffsetMm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Extra distance added past the found wall's far face."/>
                    </StackPanel>

                    <StackPanel Grid.Column="6">
                        <TextBlock Style="{StaticResource FieldLabel}" ToolTip="How much of the edge length is visible. Used as both tangent-axis crop width and camera far-clip depth.">
                            <Run Text="Edge Depth (mm)"/>
                        </TextBlock>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                 Text="{Binding EdgeDepthMm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="How much of the edge length is visible. Used as both tangent-axis crop width and camera far-clip depth."/>
                    </StackPanel>
                </Grid>

                <Grid Margin="12,4,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Crop Height (mm)" Style="{StaticResource FieldLabel}" ToolTip="Vertical extent of the section crop box."/>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10"
                                 Text="{Binding CropHeightMm, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Vertical extent of the section crop box."/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="View Template" Style="{StaticResource FieldLabel}" ToolTip="Optional view template applied to created section views."/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  ItemsSource="{Binding ViewTemplateNames}"
                                  SelectedItem="{Binding SelectedViewTemplateName}"
                                  ToolTip="Optional view template applied to created section views."/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Open Views After Creation" Style="{StaticResource FieldLabel}" ToolTip="Controls whether created views open automatically, ask first, or stay closed."/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  SelectedValue="{Binding OpenViewsMode}" SelectedValuePath="Tag"
                                  ToolTip="Controls whether created views open automatically, ask first, or stay closed.">
                            <ComboBoxItem Content="Ask Me" Tag="AskMe"/>
                            <ComboBoxItem Content="Open All" Tag="OpenAll"/>
                            <ComboBoxItem Content="Don't Open" Tag="DontOpen"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Column 6 intentionally blank — 7 fields laid out 4+3 per confirmed row split -->
                    <StackPanel Grid.Column="6"/>
                </Grid>

                <TextBlock Text="All fields editable — defaults shown are starting suggestions, not fixed values."
                           Style="{StaticResource HintText}" Margin="12,0,12,10"/>
            </StackPanel>
        </Border>

        <!-- PROXIMITY MERGE -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Proximity Merge" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal" Margin="12,4,12,12">
                    <CheckBox Content="Merge nearby sections" VerticalAlignment="Center"
                              IsChecked="{Binding MergeEnabled, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Merge Distance (mm)" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="20,0,8,0"/>
                    <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="10" Width="90"
                             Text="{Binding MergeDistanceMm, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding MergeEnabled}"
                             ToolTip="If two planned sections' edge midpoints fall within this distance, only the first-found one is kept."/>

                    <TextBlock Text="Applies across all selected roofs when enabled"
                               Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="16,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- SECTION NAMING PATTERN -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Section Naming Pattern" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="Click a token to include/exclude it. Order below = order in the built name."
                           Style="{StaticResource HintText}" Margin="12,0,12,6"/>

                <ItemsControl ItemsSource="{Binding NamingTokenChips}" Margin="12,0,12,8">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,8,8" Padding="10,6" Cursor="Hand"
                                    Command="{Binding DataContext.ToggleNamingTokenCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding DisplayLabel}">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="ChipBg" CornerRadius="8" Padding="10,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border x:Name="OrderBadge" CornerRadius="8" Width="16" Height="16" Margin="0,0,6,0">
                                                                <TextBlock Text="{Binding Order}" FontSize="9" FontWeight="Bold"
                                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock x:Name="ChipText" Text="{Binding DisplayLabel}" FontSize="12" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                            <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource BrushNavyPrimary}"/>
                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource BrushTextOnDark}"/>
                                                            <Setter TargetName="OrderBadge" Property="Background" Value="#33FFFFFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                            <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                            <Setter TargetName="ChipBg" Property="BorderBrush" Value="{StaticResource BrushSeparator}"/>
                                                            <Setter TargetName="ChipBg" Property="BorderThickness" Value="1"/>
                                                            <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                                                            <Setter TargetName="OrderBadge" Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="12,0,12,8">
                    <TextBlock Text="Separator" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Style="{StaticResource StandardComboBox}" Width="140"
                              SelectedValue="{Binding NamingSeparator}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="_ (underscore)" Tag="_"/>
                        <ComboBoxItem Content="- (hyphen)" Tag="-"/>
                        <ComboBoxItem Content="  (space)" Tag=" "/>
                    </ComboBox>
                </StackPanel>

                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Margin="12,0,12,10" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="LIVE PREVIEW" FontSize="10" Foreground="{StaticResource BrushLogTextDim}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding NamingPreviewText}" FontFamily="Consolas" FontSize="12.5"
                                   Foreground="{StaticResource BrushLogSuccess}"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource BrushSystemSecondaryBackground}" CornerRadius="6" Margin="12,0,12,12" Padding="10,8">
                    <TextBlock Style="{StaticResource HintText}" Margin="0" TextWrapping="Wrap">
                        On duplicate name: a D-series suffix (D1, D2, ...) is appended automatically and the view is still created — no view is ever skipped or overwritten.
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- PLANNED SECTIONS TABLE -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}" Margin="0,0,0,8" Height="260">
            <Grid Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Planned Sections" Style="{StaticResource SectionTitle}"/>

                <Grid Grid.Row="1" Margin="12,0,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Style="{StaticResource StyledTextInput}"
                             HorizontalAlignment="Left" Width="200"
                             Tag="Filter roof / direction..."/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                Command="{Binding SelectAllCommand}"/>
                        <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                Command="{Binding ClearAllCommand}"/>
                        <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding RefreshCommand}"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="2" Margin="12,0,12,0"
                          ItemsSource="{Binding PlannedSections}"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}"
                          AutoGenerateColumns="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                              IsChecked="{Binding IsIncluded, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding Status, Converter={StaticResource StatusToEnabledConverter}}"
                                              PreviewMouseLeftButtonDown="CheckBox_PreviewMouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Roof" Binding="{Binding RoofDisplayName}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Section View Name" Binding="{Binding SectionViewName}" Width="2*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Edge Length (mm)" Binding="{Binding EdgeLengthMm, StringFormat={}{0:F0}}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="Margin" Value="0,0,10,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="180" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- LOG PANEL -->
        <Border Grid.Row="5" Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="130"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0" Command="{Binding CopyAllLogsCommand}"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                    Command="{Binding CopySelectedLogsCommand}" CommandParameter="{Binding SelectedItems, ElementName=LogListBox}"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogsCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="LogListBox" Margin="12,8" Background="Transparent" BorderThickness="0"
                          ItemsSource="{Binding LogEntries}" SelectionMode="Extended"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11" Width="60"/>
                                <TextBlock Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Width="60"/>
                                <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding LastRunSummary, StringFormat='Last run: {0}'}" Style="{StaticResource StatusText}" VerticalAlignment="Center" Margin="2,0,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,8,0" Click="CloseButton_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Width="130"
                        Command="{Binding RunCommand}">
                    <Button.Content>
                        <TextBlock Text="{Binding SectionsSuggestedCount, StringFormat='Run ({0})'}"/>
                    </Button.Content>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
