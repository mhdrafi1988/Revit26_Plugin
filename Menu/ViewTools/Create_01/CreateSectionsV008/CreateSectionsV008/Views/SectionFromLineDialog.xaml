<Window x:Class="Revit26_Plugin.CreateSectionsFromDetailLines.V008.Views.SectionFromLineDialog.SectionFromLineDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Create Sections From Detail Lines"
        Width="620"
        Height="800"
        MinWidth="620"
        MinHeight="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <!-- Load shared styles from the embedded resource (Build Action = Resource) -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= HEADER BAR ================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Create Sections From Detail Lines"
                           Style="{StaticResource HeaderTitle}"/>
                <Border Grid.Column="1" Style="{StaticResource BadgePill}" Background="#142A44">
                    <TextBlock Text="V008" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAppleBlueLight}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ================= BODY ================= -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== METRIC CARDS ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Selected" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CreatedCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Created" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="4,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="4,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding RenamedCount}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Renamed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== OPTIONS (independent scroll) ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                <StackPanel Orientation="Vertical">

                    <!-- Section Setup: Type / Template / Prefix, 3-across -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Margin="0,0,0,4">
                            <TextBlock Text="Section Setup" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Section Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}"
                                              ItemsSource="{Binding SectionTypes}"
                                              SelectedItem="{Binding SelectedSectionType}"
                                              DisplayMemberPath="Name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="View Template" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}"
                                              ItemsSource="{Binding ViewTemplates}"
                                              SelectedItem="{Binding SelectedTemplate}"
                                              DisplayMemberPath="Name"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="Section Prefix" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}"
                                              Text="{Binding SectionPrefix}"
                                              MaxLength="25"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Host Source: 2x2 checkbox grid -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Host Source" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Floor (Host)"
                                          IsChecked="{Binding SearchFloorHost}" Margin="0,0,0,6"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Roof (Host)"
                                          IsChecked="{Binding SearchRoofHost}" Margin="0,0,0,6"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Floor (Linked)"
                                          IsChecked="{Binding SearchFloorLinked}"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Roof (Linked)"
                                          IsChecked="{Binding SearchRoofLinked}"/>
                            </Grid>
                            <TextBlock Style="{StaticResource HintText}" Margin="12,6,12,0"
                                       Text="Only checked categories are searched. Nearest qualifying element (below the line, or the line passing through it) is used."/>
                        </StackPanel>
                    </Border>

                    <!-- Geometry Settings: 2 per row, 3 rows -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Geometry Settings" Style="{StaticResource SectionTitle}"/>
                            <Grid Margin="12,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,6">
                                    <TextBlock Text="Far Clip (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding FarClipMm}" MaxLength="10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Search Threshold (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding SearchThresholdMm}" MaxLength="10"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,6">
                                    <TextBlock Text="Top Padding (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding TopPaddingMm}" MaxLength="10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,6">
                                    <TextBlock Text="Bottom Padding (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding BottomPaddingMm}" MaxLength="10"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0">
                                    <TextBlock Text="Bottom Offset (mm)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding BottomOffsetMm}" MaxLength="10"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="2">
                                    <TextBlock Text="View Scale (1:x)" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Style="{StaticResource BoxedTextInput}" Text="{Binding ViewScale}" MaxLength="10"/>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource SeparatorLine}" Margin="12,10,12,10"/>

                            <CheckBox Content="Use Search Threshold if no host found"
                                      IsChecked="{Binding UseThresholdFallback}"
                                      Margin="12,0,12,6"/>
                            <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                                    BorderBrush="{StaticResource BrushSeparator}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Margin="12,0,12,0"
                                    Padding="8,6">
                                <TextBlock Style="{StaticResource HintText}" Margin="0" TextWrapping="Wrap">
                                    If no qualifying element is found in the checked categories above, the section
                                    is still created — centered on the line's own elevation, using the
                                    Search Threshold (mm) value as the height span, instead of skipping the line.
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Post Creation Options -->
                    <Border Style="{StaticResource SectionCard}">
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Post Creation Options" Style="{StaticResource SectionTitle}"/>
                            <StackPanel Margin="12,0,12,0">
                                <CheckBox Content="Open sections after creation"
                                          IsChecked="{Binding OpenAllAfterCreate}" Margin="0,0,0,6"/>
                                <CheckBox Content="Delete source detail lines"
                                          IsChecked="{Binding DeleteLinesAfterCreate}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ===== LIVE LOG (accordion, collapsed by default) ===== -->
            <Border Grid.Row="2" Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,0,0,8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0"
                            Padding="12,8" Cursor="Hand"
                            MouseLeftButtonUp="LogHeader_MouseLeftButtonUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="LogChevron" Text="▶" Foreground="{StaticResource BrushLogTextDim}"
                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Live Log" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Click="CopyAll_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"
                                        Click="CopySelected_Click"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                        Click="Clear_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LogListBox"
                             Grid.Row="1"
                             Visibility="Collapsed"
                             Height="220"
                             Background="Transparent"
                             BorderThickness="0"
                             SelectionMode="Extended"
                             ItemsSource="{Binding LiveLog}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"                                           
                                           FontFamily="Consolas"
                                           FontSize="11.5"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===== BUTTONS ===== -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="140"
                        Margin="0,0,8,0"
                        Command="{Binding CreateCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Content" Value="Create (Running…)"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                    <Setter Property="Content" Value="Create"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Width="90"
                        Command="{Binding CancelDialogCommand}"/>
            </StackPanel>

            <TextBlock Grid.Row="4" Text="Metric cards reset to 0 at the start of each Create run"
                       Style="{StaticResource HintText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>

        </Grid>
    </Grid>
</Window>