<Window x:Class="Revit26_Plugin.RoofDrainCalloutPlacing.VByDrain.V004.Views.RoofDrainCalloutPlacingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofDrainCalloutPlacing.VByDrain.V004.Views"
        xmlns:vm="clr-namespace:Revit26_Plugin.RoofDrainCalloutPlacing.VByDrain.V004.ViewModels"
        Title="RoofDrainCalloutPlacing — VByDrain.V004"
        Height="950" Width="700" MinHeight="750" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Group card border, matches ContentCard but with tighter padding for nested content -->
            <Style x:Key="GroupCardBorder" TargetType="Border">
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>

            <Style x:Key="GroupHeaderBorder" TargetType="Border">
                <Setter Property="Background" Value="#F5F5F5"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

            <!-- Sizing sub-section background under each group's grid -->
            <Style x:Key="GroupSizingBorder" TargetType="Border">
                <Setter Property="Background" Value="#FBFBFD"/>
                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                <Setter Property="Padding" Value="10,9"/>
            </Style>

            <!-- Toggle-style radio button rendered as a segmented button -->
            <Style x:Key="SizingToggleButton" TargetType="ToggleButton">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="BorderBrush" Value="#C0C0C0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#EEF2FF"/>
                                    <Setter Property="Foreground" Value="#2563EB"/>
                                    <Setter Property="BorderBrush" Value="#2563EB"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Inverse bool-to-visibility for the Fixed-mode detail panel -->
            <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

            <!-- Plain bool inverter for the Fixed toggle button's IsChecked -->
            <local:InverseBoolConverter x:Key="InverseBoolConverter"/>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RoofDrainCalloutPlacing" Style="{StaticResource HeaderTitle}" FontSize="14"/>
                    <TextBlock Text="Select openings, then place callouts" Style="{StaticResource HeaderSubtitle}" FontSize="10.5"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePill}" Background="#22FFFFFF" VerticalAlignment="Top">
                    <TextBlock Text="VByDrain.V004" Foreground="{StaticResource BrushTextOnDark}" FontSize="10" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
            <StackPanel>

                <!-- Roof Summary + Drafting View (merged card) -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="Roof" Style="{StaticResource SectionTitle}" Margin="10,8,10,4"/>

                        <Grid Margin="10,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource HintText}" VerticalAlignment="Center">
                                <Run Text="Roof "/>
                                <Run Text="{Binding SelectedRoof.Id, Mode=OneWay}" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold"/>
                                <Run Text=" — shape editing enabled."/>
                            </TextBlock>
                            <Border Grid.Column="1" Style="{StaticResource BadgePill}" Background="#EEF2FF" BorderBrush="#C7D5F9" BorderThickness="1">
                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#2563EB">
                                    <Run Text="View: "/>
                                    <Run Text="{Binding CurrentViewName, Mode=OneWay}"/>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Border BorderBrush="#E0E0E0" BorderThickness="0,1,0,0" Margin="10,0,10,0" Padding="0,10,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Drafting view" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox Grid.Column="1" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding DraftingViews}"
                                          SelectedItem="{Binding SelectedDraftingView}"
                                          DisplayMemberPath="Name"
                                          HorizontalAlignment="Stretch"
                                          ToolTip="Drafting view where placed callouts will be displayed."/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Metrics -->
                <Border Style="{StaticResource MetricCard}" Margin="0,0,0,8" Padding="10,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MetricRoofs, Mode=OneWay}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Roof" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MetricDetected, Mode=OneWay}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Detected" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MetricSelected, Mode=OneWay}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Selected" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MetricCallouts, Mode=OneWay}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Callouts" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Openings list header (count only) + Search & Global Toolbar -->
                <Border Style="{StaticResource ContentCard}" Margin="0,0,0,8">
                    <StackPanel Margin="10,10,10,8">
                        <TextBlock Margin="0,0,0,10" Style="{StaticResource HintText}">
                            <Run Text="{Binding MetricDetected, Mode=OneWay}"/>
                            <Run Text=" total, grouped by type"/>
                        </TextBlock>

                        <TextBlock Text="Search by type" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                        <TextBox Style="{StaticResource BoxedTextInput}" MaxLength="50" Height="28"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10"
                                 ToolTip="Filter by shape type (Circle, Rectangle, Other) or loop identifier."/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Global selection" Style="{StaticResource HintText}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"/>
                                <Button Content="Select None" Command="{Binding SelectNoneCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Grouped Openings: one collapsible card per group (Circle / Rectangle / Other) -->
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OpeningGroupViewModel}">
                            <Border Style="{StaticResource GroupCardBorder}">
                                <StackPanel>

                                    <!-- Group header: expand/collapse toggle + count + local Select All/None -->
                                    <Border Style="{StaticResource GroupHeaderBorder}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsExpanded}"
                                                          Width="18" Height="18" Margin="0,0,8,0"
                                                          Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock Text="▼" FontSize="10" Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </TextBlock.RenderTransform>
                                                            <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                                                                            <Setter Property="RenderTransform">
                                                                                <Setter.Value>
                                                                                    <RotateTransform Angle="-90"/>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="{Binding GroupKey, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Margin="4,0,0,0" FontSize="10.5" Foreground="#888888">
                                                    <Run Text="("/>
                                                    <Run Text="{Binding Count, Mode=OneWay}"/>
                                                    <Run Text=")"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Content="All" Style="{StaticResource SmallSecondaryButton}" Padding="8,3" FontSize="10.5" Margin="0,0,4,0"
                                                        Click="GroupSelectAll_Click"/>
                                                <Button Content="None" Style="{StaticResource SmallSecondaryButton}" Padding="8,3" FontSize="10.5"
                                                        Click="GroupSelectNone_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Collapsible body: grid + per-group sizing controls -->
                                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">

                                        <DataGrid ItemsSource="{Binding Openings}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserSortColumns="False"
                                                  EnableRowVirtualization="True"
                                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                                  Style="{StaticResource StandardDataGrid}"
                                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                                  CellStyle="{StaticResource StandardDataGridCell}"
                                                  RowStyle="{StaticResource StandardDataGridRow}"
                                                  MaxHeight="260"
                                                  FontSize="10.5">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="✓" Width="28" CanUserSort="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      PreviewMouseLeftButtonDown="OpeningCheckBox_PreviewMouseLeftButtonDown"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>

                                                <DataGridTextColumn Header="Loop" Binding="{Binding LoopIdentifier}" Width="60"/>

                                                <!-- Shape-specific columns; only meaningful for their own group but harmless if blank in others -->
                                                <DataGridTextColumn Header="Dia (mm)" Binding="{Binding Diameter, StringFormat={}{0:F1}}" Width="70">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Length (mm)" Binding="{Binding Width, StringFormat={}{0:F1}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Width (mm)" Binding="{Binding Height, StringFormat={}{0:F1}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Area (mm²)" Binding="{Binding Area, StringFormat={}{0:N0}}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Perimeter (mm)" Binding="{Binding Perimeter, StringFormat={}{0:F1}}" Width="90">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <!-- Per-group callout sizing -->
                                        <Border Style="{StaticResource GroupSizingBorder}">
                                            <StackPanel DataContext="{Binding Sizing}">
                                                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="#555555" Margin="0,0,0,6">
                                                    <Run Text="Callout sizing — "/>
                                                    <Run Text="{Binding GroupKey, Mode=OneWay}"/>
                                                    <Run Text=" group"/>
                                                </TextBlock>

                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="6"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton Grid.Column="0" Content="Auto" Style="{StaticResource SizingToggleButton}"
                                                                  IsChecked="{Binding IsAutoMode, Mode=OneWay}"
                                                                  Click="GroupSizingModeAuto_Click"/>
                                                    <ToggleButton Grid.Column="2" Content="Fixed" Style="{StaticResource SizingToggleButton}"
                                                                  IsChecked="{Binding IsAutoMode, Converter={StaticResource InverseBoolConverter}, Mode=OneWay}"
                                                                  Click="GroupSizingModeFixed_Click"/>
                                                </Grid>

                                                <!-- Auto mode detail -->
                                                <Grid Visibility="{Binding IsAutoMode, Converter={StaticResource BoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Bounding box of selected openings in this group + margin."
                                                               Style="{StaticResource HintText}" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="Margin" Style="{StaticResource FieldLabel}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Style="{StaticResource BoxedTextInput}" Width="70" Height="24" MaxLength="6"
                                                                 Text="{Binding MarginMmText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="mm" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Fixed mode detail -->
                                                <Grid Visibility="{Binding IsAutoMode, Converter={StaticResource InverseBoolToVis}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Fixed callout box size for this group (square, W = H)."
                                                               Style="{StaticResource HintText}" FontSize="10.5" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <TextBlock Text="Size" Style="{StaticResource FieldLabel}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBox Style="{StaticResource BoxedTextInput}" Width="70" Height="24" MaxLength="6"
                                                                 Text="{Binding FixedSizeMmText, UpdateSourceTrigger=PropertyChanged}"/>
                                                        <TextBlock Text="mm" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="4,0,4,8" Style="{StaticResource HintText}"
                           Text="Groups sorted by type (Circle, Rectangle, Other); rows within each group sorted by area, largest first. Each group's callout box is sized independently — Auto uses that group's selected-opening bounding box + margin; Fixed uses a set square size."/>

                <!-- Run Button -->
                <Button Content="Place callouts on selected openings" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunCommand}"
                        Margin="0,0,0,4"/>
                <TextBlock Margin="0,0,0,8" Style="{StaticResource HintText}" HorizontalAlignment="Center"
                           Text="Disabled until at least one opening is selected, a drafting view is chosen, and the operation has not already run."/>

                <!-- Log Panel -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,0,0,0">
                    <StackPanel>
                        <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="9,5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log" Foreground="{StaticResource BrushLogText}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy all" Style="{StaticResource DarkGhostButton}" Margin="4,0,0,0" Command="{Binding CopyAllLogsCommand}"/>
                                    <Button x:Name="CopySelectedButton" Content="Copy selected" Style="{StaticResource DarkGhostButton}" Margin="4,0,0,0" Click="CopySelectedButton_Click"/>
                                    <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Margin="4,0,0,0" Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ListBox x:Name="LogListBox" ItemsSource="{Binding Logs}"
                                 Background="Transparent" BorderThickness="0"
                                 MaxHeight="140" SelectionMode="Extended"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="9.5" Foreground="{StaticResource BrushLogText}"
                                               Text="{Binding Mode=OneWay}" TextWrapping="Wrap" Margin="4,1"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
