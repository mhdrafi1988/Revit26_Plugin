<Window x:Class="Revit26_Plugin.RoofDrainCalloutPlacing.V001.Views.RoofDrainCalloutPlacingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="RoofDrainCalloutPlacing"
        Width="420" SizeToContent="Height"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="0">

        <!-- Header -->
        <Border Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="RoofDrainCalloutPlacing" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Zero-offset clustering + reference callout placement" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource BadgePill}" VerticalAlignment="Top">
                    <TextBlock Text="V001" Style="{StaticResource BadgeText}"/>
                </Border>
            </Grid>
        </Border>

        <StackPanel Margin="10">

            <!-- View selection -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="View selection" Style="{StaticResource SectionTitle}"/>
                    <StackPanel Style="{StaticResource FieldRow}">
                        <TextBlock Text="Plan view (scope + callout parent)" Style="{StaticResource FieldLabel}" FontSize="10"/>
                        <ComboBox Style="{StaticResource StandardComboBox}"
                                  FontSize="10"
                                  ItemsSource="{Binding PlanViews}"
                                  SelectedItem="{Binding SelectedPlanView}"
                                  DisplayMemberPath="Name"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Style="{StaticResource FieldRow}" HorizontalAlignment="Right">
                        <TextBlock Text="Roofs found in view: " Style="{StaticResource StatusText}" FontSize="10"/>
                        <TextBlock Text="{Binding RoofsFoundCount}" Style="{StaticResource FieldValue}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Parameters -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Parameters" Style="{StaticResource SectionTitle}"/>
                    <Grid Margin="12,4,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Grouping tolerance (mm)" Style="{StaticResource FieldLabel}" FontSize="10"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" FontSize="10" MaxLength="10"
                                     Text="{Binding GroupingToleranceMmText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Callout size (mm)" Style="{StaticResource FieldLabel}" FontSize="10"/>
                            <TextBox Style="{StaticResource BoxedTextInput}" FontSize="10" MaxLength="10"
                                     Text="{Binding CalloutSizeMmText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Drafting view -->
            <Border Style="{StaticResource ContentCard}">
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Drafting view (callout reference)" Style="{StaticResource SectionTitle}"/>
                    <ListBox Margin="12,0,12,10" MaxHeight="90" FontSize="10"
                             ItemsSource="{Binding DraftingViews}"
                             SelectedItem="{Binding SelectedDraftingView}"
                             DisplayMemberPath="Name"/>
                </StackPanel>
            </Border>

            <!-- Run button -->
            <Button Content="Find points and place callouts"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding RunCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    Margin="0,0,0,8"/>

            <!-- Summary -->
            <Border Style="{StaticResource ContentCard}">
                <Grid Margin="4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MetricRoofs}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Roofs" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" FontSize="9.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MetricZeroPoints}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Zero pts" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" FontSize="9.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MetricGroups}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Groups" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" FontSize="9.5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding MetricCallouts}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Callouts" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center" FontSize="9.5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Log panel -->
            <Border Background="{StaticResource BrushLogBg}" CornerRadius="10">
                <StackPanel>
                    <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Log" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextOnDark}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy all" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogsCommand}" Margin="0,0,4,0"/>
                                <Button Content="Copy selected" Style="{StaticResource DarkGhostButton}"
                                        Click="CopySelectedButton_Click" Margin="0,0,4,0"/>
                                <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding ClearLogsCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox x:Name="LogListBox"
                             ItemsSource="{Binding Logs}"
                             SelectionMode="Extended"
                             MaxHeight="140"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="10"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                           Text="{Binding}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

        </StackPanel>
    </StackPanel>
</Window>
