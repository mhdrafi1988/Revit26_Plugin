<Window x:Class="Revit26_Plugin.SheetAutoRearrange.V008.UI.Views.SheetAutoRearrangeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Revit26_Plugin.SheetAutoRearrange.V008.Core.Models"
        xmlns:local="clr-namespace:Revit26_Plugin.SheetAutoRearrange.V008.UI.Views"
        xmlns:conv="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Sheet Auto Rearrange — V008"
        Height="800" Width="1180"
        MinHeight="800" MinWidth="1180"
        Background="{DynamicResource BrushSystemBackground}"
        FontFamily="{DynamicResource SystemFont}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally only, per suite convention -->
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <local:StatusToFitTextConverter x:Key="StatusToFitTextConverter"/>
            <local:StatusToFitBrushConverter x:Key="StatusToFitBrushConverter"/>
            <local:SizeCategoryToTagTextConverter x:Key="SizeCategoryToTagTextConverter"/>
            <local:SizeCategoryToTagVisibilityConverter x:Key="SizeCategoryToTagVisibilityConverter"/>
            <local:SizeCategoryToTagBrushConverter x:Key="SizeCategoryToTagBrushConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <!-- ObjectDataProvider-free enum sources for ComboBoxes -->
            <x:Array x:Key="RowAlignmentValues" Type="{x:Type models:RowAlignment}">
                <models:RowAlignment>Top</models:RowAlignment>
                <models:RowAlignment>Center</models:RowAlignment>
                <models:RowAlignment>Bottom</models:RowAlignment>
            </x:Array>
            <x:Array x:Key="BlockAlignmentHValues" Type="{x:Type models:BlockAlignmentH}">
                <models:BlockAlignmentH>Left</models:BlockAlignmentH>
                <models:BlockAlignmentH>Center</models:BlockAlignmentH>
                <models:BlockAlignmentH>Right</models:BlockAlignmentH>
            </x:Array>
            <x:Array x:Key="BlockAlignmentVValues" Type="{x:Type models:BlockAlignmentV}">
                <models:BlockAlignmentV>Top</models:BlockAlignmentV>
                <models:BlockAlignmentV>Center</models:BlockAlignmentV>
                <models:BlockAlignmentV>Bottom</models:BlockAlignmentV>
            </x:Array>
            <x:Array x:Key="GapModeValues" Type="{x:Type models:GapMode}">
                <models:GapMode>Fixed</models:GapMode>
                <models:GapMode>Even</models:GapMode>
            </x:Array>

            <!-- ═══════════════════════════════════════════════════════════
                 LOCAL EXPANDER STYLE (V006 — NEW)
                 Tool-local override per suite convention: SharedStyles.xaml
                 has no Expander style, so this lives here rather than being
                 added to the shared dictionary. Navy chevron rotates via a
                 RenderTransform on IsExpanded; header row hosts an optional
                 status badge (Border+TextBlock) supplied per-instance in the
                 Header content, not baked into the template.
            ═══════════════════════════════════════════════════════════ -->
            <Style x:Key="CardExpander" TargetType="Expander">
                <Setter Property="Background" Value="{StaticResource BrushCardBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushCardBorder}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <DockPanel>
                                    <ToggleButton x:Name="HeaderToggle"
                                                  DockPanel.Dock="Top"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  Background="Transparent" BorderThickness="0"
                                                  Padding="12,10" Cursor="Hand"
                                                  HorizontalContentAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="HeaderBg" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Path x:Name="Chevron" Grid.Column="0"
                                                              Data="M 0,0 L 5,5 L 0,10"
                                                              Stroke="{StaticResource BrushTextTertiary}"
                                                              StrokeThickness="1.6"
                                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                              VerticalAlignment="Center" Width="8" Height="10"
                                                              Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                                                            <Path.RenderTransform>
                                                                <RotateTransform Angle="0"/>
                                                            </Path.RenderTransform>
                                                        </Path>

                                                        <ContentPresenter Grid.Column="1" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="HeaderBg" Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <RotateTransform Angle="90"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton>

                                    <ContentPresenter x:Name="Body" DockPanel.Dock="Top" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="Body" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ExpanderTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
            </Style>

            <!-- Small status badge shown in a collapsed/expanded expander header, e.g. "Sheet Order", "Auto-detected" -->
            <Style x:Key="ExpanderHeaderBadge" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="7,2"/>
            </Style>
            <Style x:Key="ExpanderHeaderBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Sheet Auto Rearrange — V008" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Reselect, remove &amp; repack views on the active sheet" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1" CornerRadius="10" Padding="12,5" VerticalAlignment="Center"
                        Background="#14FFFFFF" BorderBrush="#2EFFFFFF" BorderThickness="1">
                    <TextBlock Text="{Binding SheetChipText}" FontSize="11.5" Foreground="{StaticResource BrushTextOnDark}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════ BODY ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="500"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- ── LEFT: Metrics + Grid + Log (UNCHANGED from V002) ──────── -->
            <Grid Grid.Column="0" Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>

                <!-- Metric cards -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="TOTAL VIEWS" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalViewsMetric}" Style="{StaticResource MetricNumber}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="SELECTED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedMetric}" Style="{StaticResource MetricNumberAccent}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="REMOVED" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding RemovedMetric}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource MetricCard}" Margin="4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PLACED OK" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PlacedOkMetric}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Style="{StaticResource MetricCard}" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FAILED TO FIT" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FailedToFitMetric}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Views on Sheet grid card -->
                <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Views on Sheet" Style="{StaticResource SectionTitle}"/>

                        <!-- Toolbar -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="12,0,12,6">
                            <TextBox Width="160" Style="{StaticResource StyledTextInput}"
                                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25" Margin="0,0,6,0"/>
                            <Button Content="View Types ▾" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                    Click="ViewTypesButton_Click"/>
                            <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="Clear" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearAllCommand}" Margin="0,0,6,0"/>
                            <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}" Command="{Binding RefreshCommand}"/>

                            <!-- View Type filter popover -->
                            <Popup x:Name="ViewTypesPopup" PlacementTarget="{Binding ElementName=ViewTypesPopup}"
                                   StaysOpen="False" Width="220">
                                <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}"
                                        BorderThickness="1" CornerRadius="8" Padding="8">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="2" BlurRadius="10" Opacity="0.2"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <CheckBox Content="Floor Plan" IsChecked="{Binding ShowFloorPlan}" Margin="4,3"/>
                                        <CheckBox Content="Section" IsChecked="{Binding ShowSection}" Margin="4,3"/>
                                        <CheckBox Content="Elevation" IsChecked="{Binding ShowElevation}" Margin="4,3"/>
                                        <CheckBox Content="3D View" IsChecked="{Binding Show3D}" Margin="4,3"/>
                                        <CheckBox Content="Legend" IsChecked="{Binding ShowLegend}" Margin="4,3"/>
                                        <CheckBox Content="Schedule" IsChecked="{Binding ShowSchedule}" Margin="4,3"/>
                                        <CheckBox Content="Drafting View" IsChecked="{Binding ShowDrafting}" Margin="4,3"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="2" Margin="0,0,0,0"
                                  ItemsSource="{Binding FilteredViews}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="22" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                                      PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTemplateColumn Header="View Name" Width="3*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ViewName}" VerticalAlignment="Center"/>
                                                <Border Margin="5,0,0,0" CornerRadius="6" Padding="5,1"
                                                        Background="{Binding SizeCategory, Converter={StaticResource SizeCategoryToTagBrushConverter}}"
                                                        Visibility="{Binding SizeCategory, Converter={StaticResource SizeCategoryToTagVisibilityConverter}}">
                                                    <TextBlock Text="{Binding SizeCategory, Converter={StaticResource SizeCategoryToTagTextConverter}}"
                                                               FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Scale" Width="1.1*" Binding="{Binding ScaleDisplay}" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Size on Sheet (mm)" Width="1.8*" IsReadOnly="True">
                                    <DataGridTextColumn.Binding>
                                        <MultiBinding StringFormat="{}{0:0}×{1:0}">
                                            <Binding Path="WidthMm"/>
                                            <Binding Path="HeightMm"/>
                                        </MultiBinding>
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Type" Width="1.1*" Binding="{Binding ViewTypeName}" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="Fit" Width="1*" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2" HorizontalAlignment="Center"
                                                    Background="{Binding FitStatus, Converter={StaticResource StatusToFitBrushConverter}}"
                                                    Opacity="0.15">
                                                <TextBlock Text="{Binding FitStatus, Converter={StaticResource StatusToFitTextConverter}}"
                                                           FontSize="9.5" FontWeight="SemiBold"
                                                           Foreground="{Binding FitStatus, Converter={StaticResource StatusToFitBrushConverter}}"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Log panel -->
                <Border Grid.Row="2" Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Activity Log" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyAllLogCommand}" Margin="0,0,6,0"/>
                                    <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Log}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  SelectionMode="Extended" Padding="6">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="{StaticResource BrushLogText}">
                                        <Run Text="{Binding Time, StringFormat='HH:mm:ss  ', Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                                        <Run Text="{Binding Level, Mode=OneWay}" FontWeight="SemiBold"
                                             Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"/>
                                        <Run Text="{Binding Message, Mode=OneWay, StringFormat='  {0}'}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RIGHT: 7 Expanders (V007 — all collapsed by default, independent multi-expand) ──────── -->
            <ScrollViewer Grid.Column="1" Margin="0,12,12,12" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Expander 1: Rearrange Method -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsRearrangeMethodExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rearrange Method" Style="{StaticResource ExpanderTitleText}"/>
                                <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                    <TextBlock Text="{Binding SelectedAlgorithm}" Style="{StaticResource ExpanderHeaderBadgeText}"/>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">
                            <!-- Algorithm selection: two RadioButtons sharing GroupName="Algo",
                                 routed through Checked event handlers (code-behind) rather than
                                 an enum-to-bool converter, for clarity and to avoid a converter
                                 with baked-in ConverterParameter per radio. -->

                            <RadioButton x:Name="AlgoReadingOrderRadio" GroupName="Algo" Margin="12,2,12,2"
                                         Checked="AlgoRadio_Checked" Tag="ReadingOrder">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="A. Reading Order Placement" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Sorts by crop-box position and repacks in two-phase rows — ported from SmartViewToSheetPlacer V213."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="AlgoSheetOrderRadio" GroupName="Algo" Margin="12,6,12,2" IsChecked="True"
                                         Checked="AlgoRadio_Checked" Tag="SheetOrder">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock FontSize="12.5" FontWeight="SemiBold">
                                        <Run Text="B. Sheet Order Rearrange"/>
                                        <Run Text=" (default)" FontWeight="Normal" Foreground="{StaticResource BrushTextTertiary}"/>
                                    </TextBlock>
                                    <TextBlock Text="Groups current viewports into rows by vertical position (top row first), orders each row right→left, then repacks with row + block alignment."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="Sheet Order Rearrange settings:" Style="{StaticResource HintText}" Margin="12,10,12,2"/>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Row Tolerance" Width="90" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="60" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding RowToleranceMm}"/>
                                <TextBlock Text="mm — same-row grouping range" Style="{StaticResource HintText}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Row Align" Width="90" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Width="110" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding Source={StaticResource RowAlignmentValues}}"
                                          SelectedItem="{Binding RowAlignment}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Block H" Width="60" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Width="90" Style="{StaticResource StandardComboBox}" Margin="0,0,10,0"
                                          ItemsSource="{Binding Source={StaticResource BlockAlignmentHValues}}"
                                          SelectedItem="{Binding BlockAlignH}"/>
                                <TextBlock Text="Block V" Width="50" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Width="90" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding Source={StaticResource BlockAlignmentVValues}}"
                                          SelectedItem="{Binding BlockAlignV}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 2: Placeable Area (V006 — NEW) -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsPlaceableAreaExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Placeable Area" Style="{StaticResource ExpanderTitleText}"/>

                                <!-- Status pill: success (green) when auto-detected/manual-applied, warning (orange) when undetected/multiple -->
                                <Border Grid.Column="1" CornerRadius="10" Padding="8,3">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1F2E9E64"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDetectionSuccess}" Value="False">
                                                    <Setter Property="Background" Value="#26E0922E"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDetectionSuccess}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource BrushWarning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding DetectionStatusText}" FontSize="10.5" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDetectionSuccess}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushWarning}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">

                            <!-- Detection result row -->
                            <Border Margin="12,8,12,2" Padding="9,8" Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="1" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="Title Block Position" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding TitleBlockPositionText}" Style="{StaticResource FieldValue}" FontSize="12.5"/>
                                </StackPanel>
                            </Border>

                            <!-- Mini region preview canvas — drawn in code-behind (DrawRegionPreview),
                                 shows Large rect (solid), Small rect (dashed, if L-shape), title block hatch. -->
                            <Border Margin="12,8,12,0" Height="100" Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">
                                <Canvas x:Name="RegionPreviewCanvas" ClipToBounds="True"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,6,12,0">
                                <Button Content="Re-detect" Style="{StaticResource OutlineButton}" Command="{Binding RedetectCommand}"/>
                            </StackPanel>

                            <!-- Manual fallback fields — visible only when IsManualFallback is true -->
                            <StackPanel Visibility="{Binding IsManualFallback, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Title block not auto-classified (or manual override active). Enter the usable rectangle directly:"
                                           Style="{StaticResource HintText}" Margin="12,10,12,4"/>

                                <Border Margin="12,2,12,2" Padding="9,8" Background="{StaticResource BrushSystemBackground}"
                                        BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="1" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="Manual Usable Area (mm)" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,3,6,3">
                                                <TextBlock Text="Min X" Width="40" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                         Text="{Binding ManualMinXMm}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="6,3,0,3">
                                                <TextBlock Text="Min Y" Width="40" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                         Text="{Binding ManualMinYMm}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,3,6,3">
                                                <TextBlock Text="Max X" Width="40" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                         Text="{Binding ManualMaxXMm}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="6,3,0,3">
                                                <TextBlock Text="Max Y" Width="40" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                                         Text="{Binding ManualMaxYMm}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,6,12,0">
                                    <Button Content="Apply Manual Area" Style="{StaticResource AccentButton}" Command="{Binding ApplyManualAreaCommand}"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Rows pack against whichever rect their band falls in; block alignment uses the large rect only."
                                       Style="{StaticResource HintText}" Margin="12,10,12,0"
                                       Visibility="{Binding IsRegionLShape, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 3: Tall View Detection (V007 — NEW) -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsTallViewDetectionExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Tall View Detection" Style="{StaticResource ExpanderTitleText}"/>
                                <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                    <TextBlock Style="{StaticResource ExpanderHeaderBadgeText}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}x · ±{1}%">
                                                <Binding Path="TallDetectionSettings.Multiplier"/>
                                                <Binding Path="TallDetectionSettings.TolerancePercent"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="12,8,12,4">
                                <TextBlock Text="Enable Tall View Detection" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="180"/>
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding TallDetectionSettings.IsEnabled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Size Multiplier" Width="100" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="55" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding TallDetectionSettings.Multiplier}"/>
                                <TextBlock Text="× mode height" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Tolerance" Width="100" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="55" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding TallDetectionSettings.TolerancePercent}"/>
                                <TextBlock Text="%" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="If a tall view overflows:" Style="{StaticResource HintText}" Margin="12,10,12,2" FontWeight="SemiBold"/>

                            <RadioButton x:Name="TallKeepShelfRadio" GroupName="TallOverflow" Margin="12,4,12,2" IsChecked="True"
                                         Checked="TallOverflowRadio_Checked" Tag="KeepShelfTogether">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <Run Text="Keep Shelf Together"/>
                                        <Run Text=" (default)" FontWeight="Normal" Foreground="{StaticResource BrushTextTertiary}"/>
                                    </TextBlock>
                                    <TextBlock Text="Tall view + shelved views move to overflow together."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TallRepackRadio" GroupName="TallOverflow" Margin="12,6,12,2"
                                         Checked="TallOverflowRadio_Checked" Tag="RepackIndividually">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Repack Individually" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Only the tall view overflows; shelved views repack normally."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 4: Wide View Detection (V007 — NEW) -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsWideViewDetectionExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wide View Detection" Style="{StaticResource ExpanderTitleText}"/>
                                <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                    <TextBlock Style="{StaticResource ExpanderHeaderBadgeText}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0}x · ±{1}%">
                                                <Binding Path="WideDetectionSettings.Multiplier"/>
                                                <Binding Path="WideDetectionSettings.TolerancePercent"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal" Margin="12,8,12,4">
                                <TextBlock Text="Enable Wide View Detection" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Width="180"/>
                                <ToggleButton Style="{StaticResource AppleToggleButton}" IsChecked="{Binding WideDetectionSettings.IsEnabled}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Size Multiplier" Width="100" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="55" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding WideDetectionSettings.Multiplier}"/>
                                <TextBlock Text="× mode width" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="12,4,12,4">
                                <TextBlock Text="Tolerance" Width="100" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="55" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding WideDetectionSettings.TolerancePercent}"/>
                                <TextBlock Text="%" Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>

                            <TextBlock Text="If a wide view overflows:" Style="{StaticResource HintText}" Margin="12,10,12,2" FontWeight="SemiBold"/>

                            <RadioButton x:Name="WideKeepShelfRadio" GroupName="WideOverflow" Margin="12,4,12,2" IsChecked="True"
                                         Checked="WideOverflowRadio_Checked" Tag="KeepShelfTogether">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock FontSize="12" FontWeight="SemiBold">
                                        <Run Text="Keep Shelf Together"/>
                                        <Run Text=" (default)" FontWeight="Normal" Foreground="{StaticResource BrushTextTertiary}"/>
                                    </TextBlock>
                                    <TextBlock Text="Wide view + shelved views move to overflow together."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="WideRepackRadio" GroupName="WideOverflow" Margin="12,6,12,2"
                                         Checked="WideOverflowRadio_Checked" Tag="RepackIndividually">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Repack Individually" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Only the wide view overflows; shelved views repack normally."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 5: Live Sheet Preview -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsLiveSheetPreviewExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <TextBlock Text="Live Sheet Preview" Style="{StaticResource ExpanderTitleText}"/>
                        </Expander.Header>
                        <StackPanel Margin="0,0,0,10">
                            <Border Margin="12,4,12,4" Height="200" Background="{StaticResource BrushSystemBackground}"
                                    BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="6">

                                <Canvas x:Name="PreviewCanvas" ClipToBounds="True"/>
                            </Border>
                            <TextBlock Text="Preview updates on algorithm / alignment / gap change."
                                       Style="{StaticResource HintText}" Margin="12,0,12,0"/>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 4: Overflow Handling -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsOverflowHandlingExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Overflow Handling" Style="{StaticResource ExpanderTitleText}"/>
                                <Border Grid.Column="1" Style="{StaticResource ExpanderHeaderBadge}">
                                    <TextBlock Text="{Binding OverflowHandlingMode}" Style="{StaticResource ExpanderHeaderBadgeText}"/>
                                </Border>
                            </Grid>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">
                            <RadioButton x:Name="OverflowForceFitRadio" GroupName="Overflow" Margin="12,4,12,2"
                                         Checked="OverflowRadio_Checked" Tag="ForceFit">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Force-Fit Anyway" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Not yet implemented in V006 — logs a warning and falls back to Place What's Placeable."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="OverflowAutoSheetRadio" GroupName="Overflow" Margin="12,6,12,2"
                                         Checked="OverflowRadio_Checked" Tag="AutoOverflowSheet">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Auto-Create Overflow Sheet" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Not yet implemented in V006 — logs a warning and falls back to Place What's Placeable."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="OverflowPlaceablePlaceableRadio" GroupName="Overflow" Margin="12,6,12,2" IsChecked="True"
                                         Checked="OverflowRadio_Checked" Tag="PlaceWhatsPlaceable">
                                <StackPanel Margin="4,0,0,0">
                                    <TextBlock Text="Place What's Placeable" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Views that don't fit are placed just below the sheet, continuing the layout; they stay ticked but flagged Failed."
                                               Style="{StaticResource HintText}" MaxWidth="300"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Expander>

                    <!-- Expander 5: Gap & Margin Settings -->
                    <Expander Style="{StaticResource CardExpander}" IsExpanded="{Binding IsGapMarginExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <TextBlock Text="Gap &amp; Margin Settings" Style="{StaticResource ExpanderTitleText}"/>
                        </Expander.Header>

                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Titleblock margins (usable area offset):" Style="{StaticResource HintText}" Margin="12,2,12,4"/>
                            <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                <TextBlock Text="Top" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding GapSettings.MarginTopMm}" Margin="0,0,16,0"/>
                                <TextBlock Text="Bottom" Width="56" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding GapSettings.MarginBottomMm}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                <TextBlock Text="Left" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding GapSettings.MarginLeftMm}" Margin="0,0,16,0"/>
                                <TextBlock Text="Right" Width="56" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding GapSettings.MarginRightMm}"/>
                            </StackPanel>

                            <TextBlock Text="Gap between views — per View Type group:" Style="{StaticResource HintText}" Margin="12,8,12,4"/>
                            <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                <TextBlock Text="Group" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox x:Name="GapGroupCombo" Width="180" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding GapSettings.Groups}" DisplayMemberPath="GroupName"
                                          SelectedIndex="0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,2,12,2">
                                <TextBlock Text="Mode" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <ComboBox Width="120" Style="{StaticResource StandardComboBox}"
                                          ItemsSource="{Binding Source={StaticResource GapModeValues}}"
                                          SelectedItem="{Binding ElementName=GapGroupCombo, Path=SelectedItem.Mode}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="12,2,12,4">
                                <TextBlock Text="H Gap" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding ElementName=GapGroupCombo, Path=SelectedItem.HorizontalGapMm}" Margin="0,0,16,0"/>
                                <TextBlock Text="V Gap" Width="46" Style="{StaticResource FieldLabel}" VerticalAlignment="Center"/>
                                <TextBox Width="70" MaxLength="10" FontSize="11" Style="{StaticResource StyledTextInput}"
                                         Text="{Binding ElementName=GapGroupCombo, Path=SelectedItem.VerticalGapMm}"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- V008 NEW: copiable log file path, shown once a log has been saved (auto-save or manual export) -->
                    <StackPanel Margin="0,4,0,0" Visibility="{Binding LastLogFilePath, Converter={StaticResource StringToVisibilityConverter}}">
                        <TextBlock Text="Log saved to:" Style="{StaticResource HintText}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding LastLogFilePath, Mode=OneWay}" IsReadOnly="True"
                                 FontSize="10.5" Background="{StaticResource BrushSystemSecondaryBackground}"
                                 BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                 Padding="6,4" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Run bar -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Export Log" Style="{StaticResource OutlineButton}" Command="{Binding ExportLogCommand}" Margin="0,0,8,0"/>
                        <Button Content="Run" Style="{StaticResource PrimaryButton}" Command="{Binding RunCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
