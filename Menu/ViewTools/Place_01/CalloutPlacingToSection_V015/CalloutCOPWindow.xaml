<Window x:Class="Revit26_Plugin.CalloutCOP.V015.Views.CalloutCOPWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        mc:Ignorable="d"
        Title="Callout COP V015"
        Height="860"
        Width="1080"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========================= -->
        <!-- HEADER -->
        <!-- ========================= -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Callout COP" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Reference callout placement - per-view mapping" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource BadgePill}"
                        Background="{StaticResource BrushNavyLight}"
                        VerticalAlignment="Center">
                    <TextBlock Text="V015" Foreground="{StaticResource BrushTextOnDark}"
                               FontSize="11" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- ========================= -->
        <!-- BODY -->
        <!-- ========================= -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="200"/>
            </Grid.RowDefinitions>

            <!-- CONFIG CARD -->
            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Padding="12">
                <StackPanel>

                    <!-- Bulk-fill toolbar -->
                    <TextBlock Text="Bulk-fill (applies to all checked rows)"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <ComboBox ItemsSource="{Binding DraftingViews}"
                                  SelectedItem="{Binding BulkFillLeftView}"
                                  DisplayMemberPath="Name"
                                  FontSize="10" Width="150" Height="24" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding DraftingViews}"
                                  SelectedItem="{Binding BulkFillCenterView}"
                                  DisplayMemberPath="Name"
                                  FontSize="10" Width="150" Height="24" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding DraftingViews}"
                                  SelectedItem="{Binding BulkFillRightView}"
                                  DisplayMemberPath="Name"
                                  FontSize="10" Width="150" Height="24" Margin="0,0,10,0"/>
                        <Button Content="Apply to checked"
                                Command="{Binding ApplyBulkFillCommand}"
                                Style="{StaticResource AccentButton}"
                                Height="24" Width="130" FontSize="10"/>
                    </StackPanel>

                    <Border Style="{StaticResource SeparatorLine}" Margin="0,0,0,9"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                        <TextBlock Text="Sheet filter" FontSize="10"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Width="150" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding SheetFilterItems}"
                                  SelectedItem="{Binding SheetFilterText}"
                                  FontSize="10" Width="140" Height="26"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <TextBlock Text="Callout size (mm)" FontSize="10"
                                   Foreground="{StaticResource BrushTextSecondary}"
                                   Width="150" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding CalloutSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="10" FontSize="10" Width="80" Height="26"
                                 VerticalContentAlignment="Center" Padding="6,0"/>
                        <TextBlock Text="suggested from view scale" FontSize="10"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{Binding IsSizeAutoSuggested, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Content="Reset to suggested"
                                Command="{Binding ResetSizeToSuggestedCommand}"
                                Style="{StaticResource SmallSecondaryButton}"
                                Margin="12,0,0,0" Padding="9,0" FontSize="10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox Content="Show placed" IsChecked="{Binding ShowPlaced}"
                                  FontSize="10" Margin="0,0,16,0"/>
                        <CheckBox Content="Show unplaced" IsChecked="{Binding ShowUnplaced}"
                                  FontSize="10" Margin="0,0,16,0"/>
                        <CheckBox Content="Show sections" IsChecked="{Binding ShowSections}"
                                  FontSize="10" Margin="0,0,16,0"/>
                        <CheckBox Content="Show elevations" IsChecked="{Binding ShowElevations}"
                                  FontSize="10"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- VIEW GRID CARD -->
            <Border Grid.Row="1" Style="{StaticResource ContentCard}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="10,8,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Select all"
                                    Command="{Binding SelectAllCommand}"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Margin="0,0,6,0" Padding="9,0" FontSize="9.5"/>
                            <Button Content="Select none"
                                    Command="{Binding SelectNoneCommand}"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Margin="0,0,6,0" Padding="9,0" FontSize="9.5"/>
                            <Button Content="Inverse selection"
                                    Command="{Binding InverseSelectionCommand}"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Padding="9,0" FontSize="9.5"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="Scoped to visible/filtered rows"
                                   FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                <DataGrid ItemsSource="{Binding ViewsCollection}"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>

                        <DataGridCheckBoxColumn Header="&#10003;"
                                                 Binding="{Binding IsSelected, Mode=TwoWay}"
                                                 Width="34"/>

                        <DataGridTextColumn Header="View name"
                                             Binding="{Binding Name}"
                                             Width="*"/>

                        <DataGridTextColumn Header="Type"
                                             Binding="{Binding ViewType}"
                                             Width="90"/>

                        <DataGridTextColumn Header="Sheets"
                                             Binding="{Binding SheetNumbers}"
                                             Width="110"/>

                        <!-- LEFT -->
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Left" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextOnDark}"/>
                                    <TextBlock Text="-50mm" FontSize="9"
                                               Foreground="{StaticResource BrushAppleBlueLight}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding LeftView, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              FontSize="10" Height="24" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- CENTER -->
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Center" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextOnDark}"/>
                                    <TextBlock Text="0mm" FontSize="9"
                                               Foreground="{StaticResource BrushAppleBlueLight}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding CenterView, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              FontSize="10" Height="24" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- RIGHT -->
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.Header>
                                <StackPanel>
                                    <TextBlock Text="Right" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushTextOnDark}"/>
                                    <TextBlock Text="+50mm" FontSize="9"
                                               Foreground="{StaticResource BrushAppleBlueLight}"/>
                                </StackPanel>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.DraftingViews,
                                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                              SelectedItem="{Binding RightView, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              FontSize="10" Height="24" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="Placed" Width="80" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="8" Padding="7,2" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                        <Setter Property="Background" Value="#EAF6F0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="9.5">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Unplaced"/>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPlaced}" Value="True">
                                                            <Setter Property="Text" Value="Placed"/>
                                                            <Setter Property="Foreground" Value="#1F6B45"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>
                </DockPanel>
            </Border>

            <!-- SUMMARY CARDS -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Selected" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding SelectedCount}" Style="{StaticResource MetricNumber}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Already placed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberAccent}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Placed this run" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunSuccessCount}" Style="{StaticResource MetricNumberSuccess}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Failed this run" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunFailedCount}" Style="{StaticResource MetricNumberDanger}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="8" Style="{StaticResource MetricCard}">
                    <StackPanel>
                        <TextBlock Text="Skipped (no views)" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding RunSkippedCount}" Style="{StaticResource MetricNumberWarning}"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- ACTION BAR -->
            <DockPanel Grid.Row="3" Margin="0,10,0,8">
                <TextBlock Text="{Binding ProgressText}"
                           FontSize="10.5" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushNavyPrimary}"
                           VerticalAlignment="Center"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <Button Content="Place reference callouts"
                        Command="{Binding PlaceCalloutsCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Width="220" DockPanel.Dock="Right"/>
            </DockPanel>

            <!-- LOG PANEL -->
            <Border Grid.Row="4" Background="{StaticResource BrushLogBg}" CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}"
                            CornerRadius="10,10,0,0" Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Log" FontSize="10.5" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushLogText}" VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy all"
                                        Command="{Binding CopyAllLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                                <Button Content="Copy selected"
                                        Click="CopySelectedLogs_Click"
                                        Style="{StaticResource DarkGhostButton}" Margin="0,0,6,0"/>
                                <Button Content="Clear"
                                        Command="{Binding ClearLogsCommand}"
                                        Style="{StaticResource DarkGhostButton}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="LogListBox" Grid.Row="1"
                             ItemsSource="{Binding Logs}"
                             SelectionMode="Extended"
                             Background="Transparent" BorderThickness="0"
                             Padding="10,4">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="Consolas" FontSize="10.5"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0:HH:mm:ss}  {1,-7}  {2}">
                                            <Binding Path="Time"/>
                                            <Binding Path="Level"/>
                                            <Binding Path="Message"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
