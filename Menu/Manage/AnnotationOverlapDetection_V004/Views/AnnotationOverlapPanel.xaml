<!--
=======================================================
File: AnnotationOverlapPanel.xaml
Changes vs V003 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V004, metrics card
      BODY    annotation type list, results grid
      FOOTER  status strip (IsLoading drives the indeterminate bar that
              used to sit in the footer), error banner,
              Check Overlaps → Close
  - Type list and results grid: ShellBehaviors.MaxHeightRatio +
    ForwardMouseWheel (type list's fixed MaxHeight=150 replaced).
  - This tool has no log in its ViewModel — nothing to move.
  - No behaviour change — every binding/command is the V003 one.
v4.1.0:
  - Options row: Check across types, Min overlap (paper mm), view name + scale.
  - ID links zoom to and select both elements of the pair.
  - Overlap W / H (paper mm) columns appended at the end.
  - Refresh button in the footer.
v4.2.0:
  - Include leaders option; scope row with Batch Check… and Back to start view.
  - View column appended at the end of the results.
=======================================================
-->
<Window x:Class="Revit26_Plugin.AnnotationOverlapDetection.V004.Views.AnnotationOverlapPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin.Shared.Controls"
        Title="Annotation Overlap Detection — V004"
        Width="760" Height="720"
        MinWidth="760" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="Annotation Overlap Detection"
                           Subtitle="Find overlapping annotations in 2D views and sheets"
                           Version="V004"
                           IsRunning="{Binding IsLoading}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Scanned" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScanned}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Overlaps Found" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalOverlaps}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Breakdown" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding BreakdownByTypeText}" Style="{StaticResource FieldValue}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <StackPanel>
                <!-- Section 1: Type selector -->
                <Border Style="{StaticResource ContentCard}" Padding="12">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Annotation Types To Check" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                                <Button Content="Clear All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearAllCommand}" />
                            </StackPanel>
                        </Grid>

                        <ListBox ItemsSource="{Binding AnnotationFamilies}"
                                 shell:ShellBehaviors.MaxHeightRatio="0.2"
                                 shell:ShellBehaviors.ForwardMouseWheel="True"
                                 BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TypeName}" Margin="6,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                            <Run Text="(" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" items)" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- v4.1.0 / v4.2.0 options -->
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox IsChecked="{Binding CheckAcrossTypes}" VerticalAlignment="Center" Margin="0,0,16,4"
                                      Content="Check across types"
                                      ToolTip="Also report overlaps between different types, e.g. a tag over a text note." />
                            <CheckBox IsChecked="{Binding IncludeLeaders}" VerticalAlignment="Center" Margin="0,0,16,4"
                                      Content="Include leaders"
                                      ToolTip="Unticked: only the tag head / text box is checked. Ticked: leaders count too (re-scans on Check)." />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Min overlap (paper mm):" Margin="0,0,6,0" VerticalAlignment="Center"
                                           ToolTip="Ignore overlaps smaller than this on the printed sheet. 0 reports every overlap." />
                                <TextBox Width="60" VerticalAlignment="Center"
                                         Style="{StaticResource BoxedTextInput}"
                                         Text="{Binding MinOverlapPaperMm, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </WrapPanel>

                        <!-- v4.2.0 scope -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource BrushTextSecondary}">
                                <Run Text="Checking: " /><Run Text="{Binding ViewInfoText, Mode=OneWay}" />
                            </TextBlock>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Back to Start View" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,6,0"
                                        Command="{Binding BackToStartViewCommand}"
                                        Visibility="{Binding IsBatchScope, Converter={StaticResource BoolToVisibilityConverter}}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />
                                <Button Content="Batch Check…" Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding BatchCheckCommand}"
                                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                                        ToolTip="Check several sheets and/or views at once." />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Section 4: Results grid -->
                <DataGrid ItemsSource="{Binding OverlapResults}" MinHeight="160"
                          shell:ShellBehaviors.MaxHeightRatio="0.45"
                          shell:ShellBehaviors.ForwardMouseWheel="True"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}"
                          VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ID 1" SortMemberPath="ElementId1">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ElementId1}"
                                            Command="{Binding DataContext.ZoomToPairCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Zoom to and select both elements"
                                            Foreground="{StaticResource BrushAppleBlue}" BorderThickness="0" Background="Transparent"
                                            Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Type" Binding="{Binding AnnotationType}" />
                        <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F4}}" />
                        <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F4}}" />
                        <DataGridTextColumn Header="Aligned" Binding="{Binding GridAligned}" />
                        <DataGridTextColumn Header="V-Dist (mm)" Binding="{Binding VerticalDistance, StringFormat={}{0:F2}}" />
                        <DataGridTextColumn Header="H-Dist (mm)" Binding="{Binding HorizontalDistance, StringFormat={}{0:F2}}" />
                        <DataGridTemplateColumn Header="ID 2" SortMemberPath="ElementId2">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ElementId2}"
                                            Command="{Binding DataContext.ZoomToPairCommand,
                                                      RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="Zoom to and select both elements"
                                            Foreground="{StaticResource BrushAppleBlue}" BorderThickness="0" Background="Transparent"
                                            Cursor="Hand" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Overlap W (paper mm)" Binding="{Binding OverlapWidthPaper, StringFormat={}{0:F2}}" />
                        <DataGridTextColumn Header="Overlap H (paper mm)" Binding="{Binding OverlapHeightPaper, StringFormat={}{0:F2}}" />
                        <DataGridTextColumn Header="View" Binding="{Binding ViewName}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel>
                <Border Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1"
                        CornerRadius="6" Padding="8" Margin="0,0,0,8"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Refresh" Style="{StaticResource OutlineButton}" Width="90" Height="38" Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip="Re-scan the view after annotations were moved, added or deleted." />
                    <Button Content="Check Overlaps" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CheckOverlapsCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            MinWidth="150" Margin="0,0,8,0" />
                    <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38" Click="CloseButton_Click"/>
                </StackPanel>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
