<Window
    x:Class="Revit26_Plugin.DeleteLineStyles.V001.UI.Views.DeleteLineStylesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
    Title="Delete Line Styles"
    Height="680"
    Width="720"
    MinHeight="520"
    MinWidth="560"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolConverter     x:Key="InverseBool"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColor"/>
            <BooleanToVisibilityConverter        x:Key="NativeBoolToVis"/>

            <!-- Dims rows that cannot be deleted in the current mode -->
            <Style x:Key="LineStyleRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource DataGridRowStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDeletable}" Value="False">
                        <Setter Property="Opacity" Value="0.45"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Padding"           Value="8,0"/>
                <Setter Property="Foreground"        Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize"          Value="11"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0 header -->
            <RowDefinition Height="Auto"/>  <!-- 1 metrics -->
            <RowDefinition Height="Auto"/>  <!-- 2 mode -->
            <RowDefinition Height="*"/>     <!-- 3 grid -->
            <RowDefinition Height="Auto"/>  <!-- 4 log -->
            <RowDefinition Height="Auto"/>  <!-- 5 footer -->
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Delete Line Styles" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="Delete unused custom line styles, or all custom line styles. Revit's built-in styles are never touched."
                           Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ══ Metrics ══ -->
        <Border Grid.Row="1" Padding="12,8">
            <UniformGrid Columns="3">
                <Border Style="{StaticResource MetricTile}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="CUSTOM STYLES" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBlock Text="{Binding TotalCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileSuccess}" Margin="3,0">
                    <StackPanel>
                        <TextBlock Text="UNUSED" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushSuccess}"/>
                        <TextBlock Text="{Binding UnusedCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushSuccess}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricTileDanger}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="USED" Style="{StaticResource MetricTileLabel}"
                                   Foreground="{StaticResource BrushDanger}"/>
                        <TextBlock Text="{Binding UsedCount}" FontSize="26" FontWeight="Bold"
                                   Foreground="{StaticResource BrushDanger}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- ══ Mode ══ -->
        <Border Grid.Row="2" Margin="12,0,12,8" Padding="12" Background="{StaticResource BrushCardBackground}"
                BorderBrush="{StaticResource BrushCardBorder}" BorderThickness="1" CornerRadius="4"
                IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBool}}">
            <StackPanel>
                <RadioButton GroupName="Mode" IsChecked="{Binding UnusedOnly}" Margin="0,0,0,6">
                    <StackPanel>
                        <TextBlock Text="Unused line styles only" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Styles no line uses. Nothing else in the model changes."
                                   FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton GroupName="Mode" IsChecked="{Binding IncludeUsed}">
                    <StackPanel>
                        <TextBlock Text="All custom line styles (including used)" FontSize="12" FontWeight="Medium"
                                   Foreground="{StaticResource BrushTextPrimary}"/>
                        <TextBlock Text="Lines using a deleted style are changed to the replacement style first."
                                   FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                    </StackPanel>
                </RadioButton>
                <Grid Margin="22,8,0,0" IsEnabled="{Binding IncludeUsed}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Replacement style →" VerticalAlignment="Center"
                               Style="{StaticResource FieldLabel}" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Replacements}"
                              SelectedItem="{Binding Replacement}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource StandardComboBox}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ══ Line style grid ══ -->
        <Grid Grid.Row="3" Margin="12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BrushNavyPrimary}" CornerRadius="4,4,0,0" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StyledTextInput}"
                             ToolTip="Filter by name"
                             Margin="0,0,8,0" FontSize="11"
                             Background="#1A2B3C"
                             Foreground="{StaticResource BrushTextOnDark}"
                             BorderBrush="{StaticResource BrushNavyLight}"/>
                    <Button Grid.Column="1" Content="Select All" Command="{Binding SelectAllCommand}"
                            Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSelectionCommand}"
                            Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                    <Button Grid.Column="3" Content="↺ Refresh" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SmallSecondaryButton}"/>
                </Grid>
            </Border>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding RowsView}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      RowStyle="{StaticResource LineStyleRowStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                      BorderThickness="1"
                      BorderBrush="{StaticResource BrushCardBorder}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="" Width="36" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                          IsEnabled="{Binding IsDeletable}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Line Style" Width="*" MinWidth="160" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{StaticResource CellText}" FontWeight="Medium"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Lines" Width="70" SortMemberPath="LineCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LineCount}" Style="{StaticResource CellText}"
                                           FontFamily="Consolas, Courier New" TextAlignment="Right"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Status" Width="90" SortMemberPath="Status">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="8,2" Margin="6,0" HorizontalAlignment="Left"
                                        ToolTip="{Binding StatusTip}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource BrushSuccess}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUsed}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushDanger}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BrushTextSecondary}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ══ Log ══ -->
        <Border Grid.Row="4" Margin="12,8,12,0" Background="{StaticResource BrushLogBg}" CornerRadius="4">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="{StaticResource BrushLogTitleBar}"
                        CornerRadius="4,4,0,0" Padding="10,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RUN LOG" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextOnDark}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Copy Log" Command="{Binding CopyLogCommand}"
                                Style="{StaticResource DarkGhostButton}" Margin="0,0,4,0"/>
                        <ToggleButton Grid.Column="2" IsChecked="{Binding IsLogExpanded}"
                                      Style="{StaticResource LogHeaderToggle}"/>
                    </Grid>
                </Border>
                <ListBox Visibility="{Binding IsLogExpanded, Converter={StaticResource NativeBoolToVis}}"
                         ItemsSource="{Binding Log}"
                         Background="{StaticResource BrushLogBg}"
                         BorderThickness="0" Height="110"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                           FontFamily="Consolas, Courier New" FontSize="10"
                                           Foreground="{StaticResource BrushLogTextDim}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}"
                                           FontFamily="Consolas, Courier New" FontSize="10"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ══ Footer ══ -->
        <Border Grid.Row="5" Background="{StaticResource BrushNavyPrimary}" Padding="12,8" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedCount, StringFormat={}{0} selected}" FontSize="11"
                               Foreground="{StaticResource BrushTextOnDark}"/>
                    <TextBlock Text="   Running…" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushAppleBlueLight}"
                               Visibility="{Binding IsRunning, Converter={StaticResource NativeBoolToVis}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Delete Line Styles" Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}" Margin="0,0,8,0"/>
                    <Button Content="Close" Style="{StaticResource SecondaryButton}"
                            Foreground="{StaticResource BrushTextOnDark}" Click="CloseButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
