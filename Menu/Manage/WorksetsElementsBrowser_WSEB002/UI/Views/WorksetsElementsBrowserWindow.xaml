<Window x:Class="Revit26_Plugin.WorksetsElementsBrowser.WSEB002.UI.Views.WorksetsElementsBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin.WorksetsElementsBrowser.WSEB002.UI.ViewModels"
        xmlns:local="clr-namespace:Revit26_Plugin.WorksetsElementsBrowser.WSEB002.UI.Views"
        mc:Ignorable="d"
        Title="Worksets &amp; Elements Browser — WSEB002"
        Height="760" Width="900"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <local:KindToTypeVisibilityConverter x:Key="KindToTypeVisibilityConverter"/>

            <!-- Recursive template: a workset/category/type row plus its children. -->
            <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
                <Border Padding="2,3" Background="Transparent">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsThreeState="True"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding Name}"
                                   VerticalAlignment="Center"
                                   MouseLeftButtonUp="TypeName_MouseLeftButtonUp"
                                   Foreground="{StaticResource BrushTextPrimary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Workset">
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="Type">
                                            <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border Style="{StaticResource BadgePill}"
                                Margin="6,0,0,0"
                                Visibility="{Binding EditableBadge, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding EditableBadge}" Style="{StaticResource BadgeText}"/>
                        </Border>

                        <TextBlock Text="{Binding ElementCount, StringFormat={}{0:N0} elements}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Visibility="{Binding ElementCount, Converter={StaticResource IntToVisibilityConverter}, FallbackValue=Collapsed}"/>

                        <TextBlock Text="{Binding Owner}"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{StaticResource BrushTextTertiary}"
                                   Visibility="{Binding Owner, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}"/>

                        <!-- Explicit per-row action, in addition to clicking the (easy to miss) name text. -->
                        <Button Content="Show in 3D"
                                Margin="10,0,0,0"
                                Padding="6,1"
                                FontSize="10.5"
                                Style="{StaticResource SmallSecondaryButton}"
                                Click="ShowTypeIn3D_Click"
                                Visibility="{Binding Kind, Converter={StaticResource KindToTypeVisibilityConverter}, FallbackValue=Collapsed}"/>
                    </StackPanel>
                </Border>
            </HierarchicalDataTemplate>

            <Style TargetType="TreeViewItem">
                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="Worksets &amp; Elements Browser" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="{Binding DocumentTitle}" Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="16,10">
            <TextBox Width="260"
                      Padding="6,4"
                      Style="{StaticResource BorderlessTextInput}"
                      Background="{StaticResource BrushSystemSecondaryBackground}"
                      BorderBrush="{StaticResource BrushSeparator}"
                      BorderThickness="1"
                      Tag="Filter worksets, categories, types…"
                      Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Content="Expand All" Margin="10,0,0,0" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ExpandAllCommand}"/>
            <Button Content="Collapse All" Margin="6,0,0,0" Style="{StaticResource SmallSecondaryButton}" Command="{Binding CollapseAllCommand}"/>
            <Border Width="1" Margin="10,2" Background="{StaticResource BrushSeparator}"/>
            <Button Content="Check All" Margin="10,0,0,0" Style="{StaticResource SmallSecondaryButton}" Command="{Binding CheckAllCommand}"/>
            <Button Content="Clear Checks" Margin="6,0,0,0" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearChecksCommand}"/>
            <Border Width="1" Margin="10,2" Background="{StaticResource BrushSeparator}"/>
            <CheckBox Content="Hide empty worksets"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      IsChecked="{Binding HideEmptyWorksets, Mode=TwoWay}"/>
        </StackPanel>

        <!-- Status strip -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding SummaryText}" FontSize="11" Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding CheckedSummaryText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAppleBlue}" VerticalAlignment="Center"/>
        </Grid>

        <!-- Tree -->
        <Border Grid.Row="3" Margin="16,0,16,10" BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1" CornerRadius="4">
            <TreeView x:Name="Tree" ItemsSource="{Binding RootNodes}" BorderThickness="0" Background="Transparent"/>
        </Border>

        <!-- Action bar -->
        <Grid Grid.Row="4" Margin="16,0,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Isolate Checked" Style="{StaticResource SecondaryButton}" Command="{Binding IsolateCheckedCommand}"/>
                <Button Content="Select Checked" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding SelectCheckedCommand}"/>
                <Button Content="Isolate + Select Checked" Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Command="{Binding IsolateAndSelectCheckedCommand}"/>
                <Button Content="Show Checked in 3D" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" Command="{Binding ShowCheckedIn3DCommand}"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
        </Grid>

        <!-- Busy overlay -->
        <Border Grid.Row="0" Grid.RowSpan="5"
                Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="Working…" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
