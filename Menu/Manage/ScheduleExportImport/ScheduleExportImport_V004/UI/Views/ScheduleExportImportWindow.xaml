<Window x:Class="Revit26_Plugin.ScheduleExportImport.V004.UI.Views.ScheduleExportImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin.ScheduleExportImport.V004.UI.ViewModels"
        Title="Schedule Export / Import — V004"
        Width="860" Height="720"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <!-- Metric tile: big number coloured by Tone, label underneath -->
            <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type vm:SummaryCard}">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0" Padding="10,8" ToolTip="{Binding Hint}">
                    <StackPanel>
                        <TextBlock x:Name="Num" Text="{Binding Value}" Style="{StaticResource MetricNumber}" FontSize="20"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushWarning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="GridText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- summary cards -->
            <RowDefinition Height="Auto"/>   <!-- export / import actions -->
            <RowDefinition Height="*"/>      <!-- schedule list -->
            <RowDefinition Height="170"/>    <!-- log -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Style="{StaticResource AppIdentityCard}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Schedule Export / Import" Style="{StaticResource AppName}"/>
                    <TextBlock Text="Export a schedule to Excel, edit the green columns, then import — you review every change before it is applied."
                               Style="{StaticResource AppSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻ Refresh" VerticalAlignment="Center"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding RefreshSchedulesCommand}"
                        ToolTip="Reload the schedule list from the document"/>
            </Grid>
        </Border>

        <!-- ══ Summary cards ══ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding SummaryTitle}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
            <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource SummaryCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- ══ Actions: Export / Import directly under the metric cards ══ -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <Grid Margin="12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Selected schedule" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding SelectedSchedule.Name, FallbackValue='Tick a schedule below to export', TargetNullValue='Tick a schedule below to export'}"
                               FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource BrushTextPrimary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏳ Working…" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Export to Excel…" Style="{StaticResource SecondaryButton}" MinWidth="140" Margin="0,0,6,0"
                            Command="{Binding ExportScheduleCommand}"
                            ToolTip="Save the ticked schedule (Element ID + visible fields) as .xlsx. Green columns are editable, grey are locked."/>
                    <Button Content="Open Exported File" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Command="{Binding OpenExportedFileCommand}"
                            ToolTip="Open the last exported workbook in Excel"/>
                    <Button Content="Import from Excel…" Style="{StaticResource PrimaryButton}" MinWidth="150"
                            Command="{Binding ImportScheduleCommand}"
                            ToolTip="Save your edits in Excel (it can stay open), then import. The schedule is picked from the file; a preview opens and nothing changes until you click Apply."/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="10" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource BrushTextSecondary}">
                    <Run Text="1 · Export, edit the green columns in Excel and save  ·  2 · Import, review the preview, Apply"/>
                    <Run Text="{Binding LastExportedFile, Mode=OneWay, StringFormat='   ·   Last export: {0}', TargetNullValue=''}" Foreground="{StaticResource BrushAppleBlue}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ══ Schedule list ══ -->
        <Border Grid.Row="3" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <Grid Margin="10,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Schedules in Document" FontWeight="SemiBold" FontSize="12"
                           Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍 Search:" VerticalAlignment="Center" FontSize="12"
                               Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                             ToolTip="Filter by schedule name or category"/>
                    <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding ClearSearchCommand}" ToolTip="Clear search"/>
                </Grid>
                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding SchedulesView}"
                          SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                          RowStyle="{StaticResource DataGridRowStyle}"
                          CellStyle="{StaticResource DataGridCellStyle}"
                          ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                          Background="{StaticResource BrushSystemBackground}"
                          BorderThickness="0" RowHeight="26"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <DataGrid.Columns>
                        <!-- Tick box mirrors the row selection; SelectionMode=Single keeps it to one schedule -->
                        <DataGridTemplateColumn Header="✔" Width="34" CanUserResize="False" CanUserSort="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Not hit-testable: the click selects the row (which ticks this box);
                                         letting the box also toggle undid the selection on the same click -->
                                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                                              IsHitTestVisible="False"
                                              ToolTip="Tick to select this schedule for export / import"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay, RelativeSource={RelativeSource AncestorType=DataGridRow}}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Schedule Name" Binding="{Binding Name, Mode=OneWay}" Width="*" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" Width="130" ElementStyle="{StaticResource GridText}"/>
                        <DataGridTextColumn Header="Rows / Fields" Binding="{Binding RowCountDisplay, Mode=OneWay}" Width="115" ElementStyle="{StaticResource GridText}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- ══ Log (always dark) ══ -->
        <Border Grid.Row="4" CornerRadius="6" Background="{StaticResource BrushLogBg}" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="6,6,0,0" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}">
                            <Run Text="Log"/>
                            <Run Text="{Binding LogEntries.Count, Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}" Margin="0,0,4,0" ToolTip="Copy the whole log to the clipboard"/>
                            <Button Content="Save…" Style="{StaticResource DarkGhostButton}" Command="{Binding SaveLogCommand}" Margin="0,0,4,0" ToolTip="Save the log as a .txt file next to the last export"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogEntries}"
                         Background="Transparent" BorderThickness="0" Padding="6,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                       Text="{Binding Mode=OneWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="5" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="2,0,0,2"/>
    </Grid>
</Window>
