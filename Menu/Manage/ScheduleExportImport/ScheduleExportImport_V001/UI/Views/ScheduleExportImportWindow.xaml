<Window x:Class="Revit26_Plugin.ScheduleExportImport.V001.UI.Views.ScheduleExportImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:vm="clr-namespace:Revit26_Plugin.ScheduleExportImport.V001.UI.ViewModels"
        Title="Schedule Export / Import — V001"
        Width="860" Height="720"
        MinWidth="680" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <!-- Metric tile: big number coloured by Tone, label underneath -->
            <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type vm:SummaryCard}">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,6,0" Padding="10,8" ToolTip="{Binding Hint}">
                    <StackPanel>
                        <TextBlock x:Name="Num" Text="{Binding Value}" Style="{StaticResource MetricNumber}" FontSize="20"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource MetricLabel}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Tone}" Value="Accent">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Success">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushSuccess}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushWarning}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Tone}" Value="Danger">
                        <Setter TargetName="Num" Property="Foreground" Value="{StaticResource BrushDanger}"/>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <Style x:Key="GridText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header -->
            <RowDefinition Height="Auto"/>   <!-- summary cards -->
            <RowDefinition Height="*"/>      <!-- list + actions -->
            <RowDefinition Height="170"/>    <!-- log -->
            <RowDefinition Height="Auto"/>   <!-- status -->
        </Grid.RowDefinitions>

        <!-- ══ Header ══ -->
        <Border Grid.Row="0" Style="{StaticResource AppIdentityCard}" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Schedule Export / Import" Style="{StaticResource AppName}"/>
                    <TextBlock Text="Export a schedule to Excel, edit the green columns, then import — you review every change before it is applied."
                               Style="{StaticResource AppSubtitle}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="↻ Refresh" VerticalAlignment="Center"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding RefreshSchedulesCommand}"
                        ToolTip="Reload the schedule list from the document"/>
            </Grid>
        </Border>

        <!-- ══ Summary cards ══ -->
        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="{Binding SummaryTitle}" FontSize="11" FontWeight="SemiBold"
                       Foreground="{StaticResource BrushTextSecondary}" Margin="2,0,0,4"/>
            <ItemsControl ItemsSource="{Binding SummaryCards}" ItemTemplate="{StaticResource SummaryCardTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- ══ Schedule list + actions ══ -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource ContentCard}">
                <Grid Margin="10,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Schedules in Document" FontWeight="SemiBold" FontSize="12"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,6"/>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍 Search:" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="6,4" VerticalContentAlignment="Center"
                                 ToolTip="Filter by schedule name or category"/>
                        <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding ClearSearchCommand}" ToolTip="Clear search"/>
                    </Grid>
                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding SchedulesView}"
                              SelectedItem="{Binding SelectedSchedule, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource BrushSeparatorThin}"
                              RowStyle="{StaticResource DataGridRowStyle}"
                              CellStyle="{StaticResource DataGridCellStyle}"
                              ColumnHeaderStyle="{StaticResource DataGridColumnHeaderStyle}"
                              Background="{StaticResource BrushSystemBackground}"
                              BorderThickness="0" RowHeight="26"
                              IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Schedule Name" Binding="{Binding Name, Mode=OneWay}" Width="*" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" Width="130" ElementStyle="{StaticResource GridText}"/>
                            <DataGridTextColumn Header="Rows / Fields" Binding="{Binding RowCountDisplay, Mode=OneWay}" Width="115" ElementStyle="{StaticResource GridText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ContentCard}">
                <StackPanel Margin="12,10">
                    <TextBlock Text="Selected schedule" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                    <TextBlock Text="{Binding SelectedSchedule.Name, FallbackValue='← Pick one from the list', TargetNullValue='← Pick one from the list'}"
                               FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushTextPrimary}" Margin="0,2,0,12"/>

                    <TextBlock Text="1 · Export" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Element ID + visible fields to .xlsx. Green = editable, grey = locked."
                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="Export to Excel…" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportScheduleCommand}" HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{Binding LastExportedFile}" FontSize="9" TextWrapping="Wrap"
                               Foreground="{StaticResource BrushAppleBlue}" Margin="0,4,0,0"/>

                    <Separator Margin="0,12" Background="{StaticResource BrushSeparatorThin}"/>

                    <TextBlock Text="2 · Import" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="Compares the file with the model and opens a preview. Nothing changes until you click Apply."
                               FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <Button Content="Import from Excel…" Style="{StaticResource PrimaryButton}"
                            Command="{Binding ImportScheduleCommand}" HorizontalAlignment="Stretch"/>

                    <TextBlock Text="⏳ Working…" FontSize="11" Margin="0,10,0,0"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══ Log (always dark) ══ -->
        <Border Grid.Row="3" CornerRadius="6" Background="{StaticResource BrushLogBg}" Margin="0,0,0,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="6,6,0,0" Padding="10,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource BrushLogText}">
                            <Run Text="Log"/>
                            <Run Text="{Binding LogEntries.Count, Mode=OneWay}" Foreground="{StaticResource BrushLogTextDim}"/>
                        </TextBlock>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Copy" Style="{StaticResource DarkGhostButton}" Command="{Binding CopyLogCommand}" Margin="0,0,4,0" ToolTip="Copy the whole log to the clipboard"/>
                            <Button Content="Save…" Style="{StaticResource DarkGhostButton}" Command="{Binding SaveLogCommand}" Margin="0,0,4,0" ToolTip="Save the log as a .txt file next to the last export"/>
                            <Button Content="Clear" Style="{StaticResource DarkGhostButton}" Command="{Binding ClearLogCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <ListBox x:Name="LogList" Grid.Row="1" ItemsSource="{Binding LogEntries}"
                         Background="Transparent" BorderThickness="0" Padding="6,4"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                       Text="{Binding Mode=OneWay}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="2,0,0,2"/>
    </Grid>
</Window>
