<Window x:Class="Revit26_Plugin.ParaManager.V001.Views.ParaManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:models="clr-namespace:Revit26_Plugin.ParaManager.V001.Models"
        Title="ParaManager"
        Height="780" Width="880"
        MinHeight="780" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BrushSystemBackground}"
        Closing="Window_Closing">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters instantiated locally per convention — never in SharedStyles.xaml -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Metrics -->
            <RowDefinition Height="*"/>
            <!-- Body -->
        </Grid.RowDefinitions>

        <!-- ═══════════ HEADER ═══════════ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="ParaManager — Bulk Parameter Assignment" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="v0.1.0 · Revit 2026" Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ METRICS BAR ═══════════ -->
        <Border Grid.Row="1" Background="{StaticResource BrushNavyDark}" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MetricParamsFileCount}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Param File Loaded" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MetricCategoriesSelected}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Categories Selected" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MetricParametersSelected}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Parameters Selected" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="{StaticResource BrushNavyLight}" CornerRadius="6" Padding="10,8" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding MetricAssignedThisSession}" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Assigned This Session" FontSize="10.5" Foreground="{StaticResource BrushAppleBlueLight}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════ BODY (scrollable) ═══════════ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16">
            <StackPanel>

                <!-- ── Shared Parameter File ── -->
                <GroupBox Header="Shared Parameter File" Style="{StaticResource CardGroupBox}">
                    <StackPanel Margin="12,8,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource BrushSystemSecondaryBackground}"
                                    CornerRadius="4" Padding="8,6" Margin="0,0,8,0">
                                <TextBlock Text="{Binding SharedParameterFilePath, TargetNullValue='No file selected'}"
                                           Style="{StaticResource BodyText}" TextTrimming="CharacterEllipsis"/>
                            </Border>

                            <Button Grid.Column="1" Content="Browse…" Style="{StaticResource OutlineButton}"
                                    Command="{Binding BrowseSharedParameterFileCommand}" Margin="0,0,6,0"/>
                            <Button Grid.Column="2" Content="Reload" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ReloadSharedParameterFileCommand}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- ── Target Categories ── -->
                <GroupBox Header="Target Categories" Style="{StaticResource CardGroupBox}">
                    <StackPanel Margin="12,8,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0" IsChecked="{Binding IsCategoryPopupOpen}"
                                          Style="{StaticResource StageHeaderToggle}"
                                          HorizontalAlignment="Stretch" Padding="8,6">
                                <Grid>
                                    <TextBlock Text="{Binding SelectedCategories.Count, StringFormat='{}{0} categories selected'}"
                                               Style="{StaticResource FieldValue}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="▾" Foreground="{StaticResource BrushTextTertiary}" HorizontalAlignment="Right"/>
                                </Grid>
                            </ToggleButton>

                            <Popup IsOpen="{Binding IsCategoryPopupOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource AncestorType=Grid}}"
                                   Placement="Bottom" StaysOpen="False" Width="320">
                                <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}"
                                        BorderThickness="1" CornerRadius="5"
                                        Effect="{x:Null}">
                                    <ItemsControl ItemsSource="{Binding AvailableCategories}" MaxHeight="260">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:CategoryInfo}">
                                                <Button Command="{Binding DataContext.ToggleCategoryCommand,
                                                         RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButton}"
                                                        HorizontalContentAlignment="Left" HorizontalAlignment="Stretch"
                                                        Padding="10,6">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}"/>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </Popup>

                            <Button Grid.Column="1" Content="Clear" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding ClearCategoriesCommand}" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Chip row -->
                        <ItemsControl ItemsSource="{Binding SelectedCategories}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:CategoryInfo}">
                                    <Border Background="{StaticResource BrushNavyPrimary}" CornerRadius="10"
                                            Padding="8,3" Margin="0,0,6,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11"/>
                                            <Button Content="✕" Margin="6,0,0,0" Background="Transparent"
                                                    BorderThickness="0" Foreground="White" Cursor="Hand"
                                                    FontSize="9"
                                                    Command="{Binding DataContext.RemoveCategoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <!-- ── Parameters to Assign ── -->
                <GroupBox Header="Parameters to Assign" Style="{StaticResource CardGroupBox}">
                    <Grid Margin="12,8,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Select Parameters…" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenParameterPopoverCommand}" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Grid.Column="1" Text="Binding type is chosen once per Run (applies to the whole batch)"
                                   Style="{StaticResource HintText}" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <!-- Parameter popover -->
                        <Popup IsOpen="{Binding IsParameterPopoverOpen}" Placement="Bottom" StaysOpen="False" Width="440">
                            <Border Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}"
                                    BorderThickness="1" CornerRadius="5">
                                <StackPanel>
                                    <!-- Popover header -->
                                    <Border Padding="12,10" BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="Select Parameter Groups / Parameters" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                                            <TextBox Style="{StaticResource StyledTextInput}"
                                                     Text="{Binding ParameterFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                     MaxLength="25"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Popover actions -->
                                    <StackPanel Orientation="Horizontal" Margin="12,8">
                                        <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding SelectAllParametersCommand}" Margin="0,0,8,0"/>
                                        <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}"
                                                Command="{Binding ClearParameterSelectionCommand}"/>
                                    </StackPanel>

                                    <!-- Grouped list -->
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ParameterGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:ParameterGroupNode}">
                                                    <StackPanel>
                                                        <Border Background="{StaticResource BrushSystemSecondaryBackground}" Padding="12,6">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontWeight="SemiBold"
                                                                           FontSize="11.5" Foreground="{StaticResource BrushNavyPrimary}"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                                                <TextBlock Grid.Column="2" Text="{Binding ParameterCount, StringFormat='{}{0} params'}"
                                                                           Foreground="{StaticResource BrushTextTertiary}" FontSize="10.5"
                                                                           VerticalAlignment="Center"/>
                                                            </Grid>
                                                        </Border>
                                                        <ItemsControl ItemsSource="{Binding Parameters}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type models:ParameterLeafNode}">
                                                                    <StackPanel Orientation="Horizontal" Margin="26,4,12,4">
                                                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="{Binding Parameter.Name}" Style="{StaticResource BodyText}"
                                                                                   Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Popover footer -->
                                    <Border BorderBrush="{StaticResource BrushSeparatorThin}" BorderThickness="0,1,0,0" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                                    Command="{Binding CancelParameterPopoverCommand}" Margin="0,0,8,0"/>
                                            <Button Content="Apply" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding ApplyParameterPopoverCommand}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </GroupBox>

                <!-- ── Assignment Queue (Advanced DataGrid) ── -->
                <GroupBox Header="Assignment Queue" Style="{StaticResource CardGroupBox}">
                    <StackPanel Margin="12,8,12,12">

                        <!-- Toolbar -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Style="{StaticResource StyledTextInput}" Width="220"
                                     Text="{Binding QueueFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="25"/>
                            <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding SelectAllQueueRowsCommand}"/>
                            <Button Content="Clear Selection" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                    Command="{Binding ClearQueueSelectionCommand}"/>
                            <Button Content="Refresh" Style="{StaticResource SmallSecondaryButton}" Margin="6,0,0,0"
                                    Command="{Binding RefreshQueueCommand}"/>
                        </StackPanel>

                        <!-- Advanced DataGrid -->
                        <DataGrid ItemsSource="{Binding QueueView}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  EnableRowVirtualization="True"
                                  EnableColumnVirtualization="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      PreviewMouseLeftButtonDown="RowCheckBox_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Parameter Name" Binding="{Binding ParameterName}"
                                                     Width="1.6*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Group" Binding="{Binding ParameterGroup}"
                                                     Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryDisplay}"
                                                     Width="1.4*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Binding" Binding="{Binding BindingTypeDisplay}"
                                                     Width="0.8*" IsReadOnly="True"/>

                                <DataGridTemplateColumn Header="" Width="34" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="✕" Style="{StaticResource SmallSecondaryButton}"
                                                    Command="{Binding DataContext.RemoveQueueRowCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </GroupBox>

                <!-- ── Activity Log ── -->
                <GroupBox Header="Activity Log" Style="{StaticResource CardGroupBox}">
                    <StackPanel Margin="12,8,12,12">
                        <Border Background="{StaticResource BrushLogBg}" CornerRadius="4" Padding="10">
                            <ListBox ItemsSource="{Binding LogEntries}" Height="120"
                                     Background="Transparent" BorderThickness="0"
                                     SelectionMode="Extended"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     SelectionChanged="LogListBox_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Time, StringFormat='HH:mm:ss'}"
                                                       Foreground="{StaticResource BrushLogTextDim}" FontFamily="Consolas" FontSize="11"/>
                                            <TextBlock Text="{Binding Level}" Margin="8,0"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                       FontFamily="Consolas" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="{Binding Message}" Foreground="{StaticResource BrushLogText}"
                                                       FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="Copy Selected" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopySelectedLogCommand}" Margin="0,0,8,0"/>
                            <Button Content="Copy All" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding CopyAllLogCommand}" Margin="0,0,8,0"/>
                            <Button Content="Export Logs (.txt)" Style="{StaticResource OutlineButton}"
                                    Command="{Binding ExportLogsCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- ── Footer: summary + actions ── -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding SummaryLine}" Style="{StaticResource StatusText}"
                               VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Click="CloseButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Run Assignment" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RunCommand}"/>
                    </StackPanel>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
