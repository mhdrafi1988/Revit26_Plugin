<Window x:Class="Revit26_Plugin.WorksetRenamer.FX03.Views.WorksetRenamerFxView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Revit26_Plugin.WorksetRenamer.FX03.ViewModels"
        Title="Workset Renamer — From Excel (FX03)"
        Width="920" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Background="{DynamicResource BrushSystemSecondaryBackground}"
        FontFamily="{DynamicResource SystemFont}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <vm:RowStatusToBrushConverter x:Key="RowStatusToBrush"/>
            <vm:RowKindToBrushConverter x:Key="RowKindToBrush"/>
            <vm:DuplicateWarningToBrushConverter x:Key="DuplicateWarningToBrush"/>

            <!-- ══ Group expander chrome — colored left bar via the Tag brush ══ -->
            <Style x:Key="GroupExpander" TargetType="Expander">
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemBackground}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BrushSeparatorThin}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <DockPanel>
                                    <ToggleButton DockPanel.Dock="Top"
                                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                  OverridesDefaultStyle="True">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="{StaticResource BrushSystemSecondaryBackground}"
                                                        BorderThickness="0,0,0,4"
                                                        BorderBrush="{Binding Tag, RelativeSource={RelativeSource FindAncestor, AncestorType=Expander}}"
                                                        Padding="10,7">
                                                    <ContentPresenter Content="{TemplateBinding Content}"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <ContentPresenter ContentSource="Header"/>
                                    </ToggleButton>
                                    <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                </DockPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ Compact DataGrid shared by every group ══ -->
            <Style x:Key="FxGroupGrid" TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="CanUserAddRows" Value="False"/>
                <Setter Property="CanUserDeleteRows" Value="False"/>
                <Setter Property="CanUserReorderColumns" Value="False"/>
                <Setter Property="CanUserResizeRows" Value="False"/>
                <Setter Property="SelectionMode" Value="Extended"/>
                <Setter Property="SelectionUnit" Value="FullRow"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushSeparatorThin}"/>
                <Setter Property="AlternationCount" Value="2"/>
                <Setter Property="RowStyle" Value="{StaticResource DataGridRowStyle}"/>
                <Setter Property="CellStyle" Value="{StaticResource DataGridCellStyle}"/>
                <Setter Property="ColumnHeaderStyle" Value="{StaticResource DataGridColumnHeaderStyle}"/>
                <Setter Property="Background" Value="{StaticResource BrushSystemBackground}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="RowHeight" Value="28"/>
                <Setter Property="MaxHeight" Value="220"/>
            </Style>

            <DataTemplate x:Key="SelectCellTemplate">
                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          IsEnabled="{Binding IsActionable}"
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </DataTemplate>

            <Style x:Key="FxReadOnlyCellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="FontSize" Value="11"/>
            </Style>
            <Style x:Key="FxTertiaryCellText" TargetType="TextBlock" BasedOn="{StaticResource FxReadOnlyCellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushTextTertiary}"/>
                <Setter Property="FontStyle" Value="Italic"/>
            </Style>
            <Style x:Key="FxEditableCellText" TargetType="TextBlock" BasedOn="{StaticResource FxReadOnlyCellText}">
                <Setter Property="Foreground" Value="{StaticResource BrushAppleBlue}"/>
            </Style>
            <Style x:Key="FxDuplicateCellText" TargetType="TextBlock" BasedOn="{StaticResource FxReadOnlyCellText}">
                <Setter Property="Foreground" Value="#A06A00"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
            <Style x:Key="FxInvalidCellText" TargetType="TextBlock" BasedOn="{StaticResource FxReadOnlyCellText}">
                <Setter Property="Foreground" Value="#B23B3B"/>
            </Style>
            <Style x:Key="FxEditingCellText" TargetType="TextBox">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="IsEnabled" Value="{Binding IsActionable}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══ Header ══════════════════════════════════════════════ -->
        <Border Grid.Row="0" Style="{StaticResource AppIdentityCard}" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Workset Renamer — From Excel" Style="{StaticResource AppName}"/>
                <TextBlock Text="Export the model's worksets, edit New Name in Excel, import, review by group, then Update."
                           Style="{StaticResource AppSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- ══ Row 1: Export ═══════════════════════════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource ContentCard}" Margin="0,0,0,6">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="12">
                        <Run Text="Export" FontWeight="SemiBold"/>
                        <Run Text=" the model's current worksets to an editable Old Name / New Name workbook"/>
                    </TextBlock>
                    <TextBlock Text="New Name is pre-filled with the current name — edit only what you want changed, then import it back."
                               Style="{StaticResource AppSubtitle}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Export Worksets to Excel..."
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ExportWorksetsCommand}"/>
            </Grid>
        </Border>

        <!-- ══ Row 2: Import ═══════════════════════════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource ContentCard}" Margin="0,0,0,8"
                Drop="Window_Drop" AllowDrop="True">
            <Grid Margin="10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock FontSize="12">
                        <Run Text="File: "/>
                        <Run Text="{Binding ExcelFileName}" FontWeight="SemiBold" Foreground="{StaticResource BrushAppleBlue}"/>
                    </TextBlock>
                    <TextBlock Text="Drag &amp; drop an .xlsx file here, or click Browse. Column A = Old Name, Column B = New Name."
                               Style="{StaticResource AppSubtitle}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Browse..."
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding BrowseExcelCommand}"/>
            </Grid>
        </Border>

        <!-- ══ Metric cards ════════════════════════════════════════ -->
        <UniformGrid Grid.Row="3" Rows="1" Columns="6" Margin="0,0,0,8">
            <Border Style="{StaticResource ContentCard}" Margin="0,0,4,0" BorderThickness="0,0,0,3" BorderBrush="{StaticResource BrushAppleBlue}">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding TotalRowsRead}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                    <TextBlock Text="TOTAL ROWS" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ContentCard}" Margin="4,0" BorderThickness="0,0,0,3" BorderBrush="#34C759">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding OkCount}" FontSize="20" FontWeight="Bold" Foreground="#1E7E1E"/>
                    <TextBlock Text="OK TO RENAME" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ContentCard}" Margin="4,0" BorderThickness="0,0,0,3" BorderBrush="#C98A00">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding DuplicateCount}" FontSize="20" FontWeight="Bold" Foreground="#A06A00"/>
                    <TextBlock Text="DUPLICATE (AUTO)" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ContentCard}" Margin="4,0" BorderThickness="0,0,0,3" BorderBrush="#999999">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding NoMatchCount}" FontSize="20" FontWeight="Bold" Foreground="#777777"/>
                    <TextBlock Text="NO MATCH" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ContentCard}" Margin="4,0" BorderThickness="0,0,0,3" BorderBrush="#B23B3B">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding InvalidCount}" FontSize="20" FontWeight="Bold" Foreground="#B23B3B"/>
                    <TextBlock Text="BLANK / INVALID" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource ContentCard}" Margin="4,0,0,0" BorderThickness="0,0,0,3" BorderBrush="#2D7A5F">
                <StackPanel Margin="8,6">
                    <TextBlock Text="{Binding NewWorksetCount}" FontSize="20" FontWeight="Bold" Foreground="#1E7A52"/>
                    <TextBlock Text="NEW WORKSETS" FontSize="9" Foreground="{StaticResource BrushTextSecondary}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══ Create-new-for-unmatched option ═════════════════════ -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}" Margin="0,0,0,8" Background="#F2FAF6">
            <StackPanel Orientation="Horizontal" Margin="10,6">
                <CheckBox IsChecked="{Binding CreateNewForUnmatched, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11.5" TextWrapping="Wrap">
                    <Run Text="Create new worksets" FontWeight="SemiBold"/>
                    <Run Text=" for Excel rows whose Old Name has no match in the model"/>
                </TextBlock>
                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource BrushTextSecondary}"
                           Text="(uses the row's New Name; unchecked = those rows are skipped)"/>
            </StackPanel>
        </Border>

        <!-- ══ Toolbar ═════════════════════════════════════════════ -->
        <Grid Grid.Row="5" Margin="0,0,0,8">
            <Button Content="↻ Re-run Dry Run" HorizontalAlignment="Left"
                    Style="{StaticResource SmallSecondaryButton}"
                    Command="{Binding RerunDryRunCommand}"/>
        </Grid>

        <!-- ══ Search / Filter bar ════════════════════════════════ -->
        <Border Grid.Row="6" Style="{StaticResource ContentCard}" Margin="0,0,0,8">
            <Grid Margin="8,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍 Filter:" VerticalAlignment="Center"
                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12" VerticalContentAlignment="Center"
                         Background="{StaticResource BrushSystemSecondaryBackground}"
                         BorderBrush="{StaticResource BrushSeparatorThin}"
                         BorderThickness="1" Padding="6,4"
                         x:Name="SearchBox">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Background" Value="{StaticResource BrushSystemSecondaryBackground}"/>
                            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BrushSeparatorThin}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Padding" Value="6,4"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Style.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAppleBlue}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <Button Grid.Column="2" Content="✕" Margin="6,0,0,0"
                        Style="{StaticResource SmallSecondaryButton}"
                        Command="{Binding ClearSearchCommand}"
                        ToolTip="Clear filter"/>
            </Grid>
        </Border>

        <!-- ══ Grouped by possibility of rename — one expander per bucket ══ -->
        <ScrollViewer Grid.Row="7" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Expander IsExpanded="True" Style="{StaticResource GroupExpander}" Tag="#1E7E1E">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="✅ OK to Rename" FontWeight="SemiBold" FontSize="12"/>
                            <Border Grid.Column="1" Background="#DCF3DC" CornerRadius="9" Padding="8,1">
                                <TextBlock Text="{Binding OkCount}" FontSize="10" FontWeight="Bold" Foreground="#1E7E1E"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <DataGrid ItemsSource="{Binding OkRows}" Style="{StaticResource FxGroupGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="☑" Width="36" CanUserSort="False" CellTemplate="{StaticResource SelectCellTemplate}"/>
                            <DataGridTextColumn Header="Current Workset Name" Binding="{Binding OldName, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource FxReadOnlyCellText}"/>
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource FxEditableCellText}" EditingElementStyle="{StaticResource FxEditingCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Style="{StaticResource GroupExpander}" Tag="#C98A00">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12">
                                <Run Text="▲ Duplicate — Auto-suffixed"/>
                                <Run Text=" (re-checked again at Update)" FontWeight="Normal" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            </TextBlock>
                            <Border Grid.Column="1" Background="#FFF0CC" CornerRadius="9" Padding="8,1">
                                <TextBlock Text="{Binding DuplicateCount}" FontSize="10" FontWeight="Bold" Foreground="#A06A00"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <DataGrid ItemsSource="{Binding DuplicateRows}" Style="{StaticResource FxGroupGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="☑" Width="36" CanUserSort="False" CellTemplate="{StaticResource SelectCellTemplate}"/>
                            <DataGridTextColumn Header="Old Name / Current Workset" Binding="{Binding OldName, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource FxReadOnlyCellText}"/>
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource FxDuplicateCellText}" EditingElementStyle="{StaticResource FxEditingCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Style="{StaticResource GroupExpander}" Tag="#1E7A52">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12">
                                <Run Text="+ Will Create New Workset"/>
                                <Run Text=" (Old Name not found in model)" FontWeight="Normal" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            </TextBlock>
                            <Border Grid.Column="1" Background="#DCF3EA" CornerRadius="9" Padding="8,1">
                                <TextBlock Text="{Binding NewWorksetCount}" FontSize="10" FontWeight="Bold" Foreground="#1E7A52"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <DataGrid ItemsSource="{Binding NewWorksetRows}" Style="{StaticResource FxGroupGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="☑" Width="36" CanUserSort="False" CellTemplate="{StaticResource SelectCellTemplate}"/>
                            <DataGridTextColumn Header="Excel Old Name (not in model)" Binding="{Binding OldName, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource FxReadOnlyCellText}"/>
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource FxEditableCellText}" EditingElementStyle="{StaticResource FxEditingCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Style="{StaticResource GroupExpander}" Tag="#999999">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12">
                                <Run Text="– No Match — Unchanged"/>
                                <Run Text=" (model worksets with no Excel row)" FontWeight="Normal" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            </TextBlock>
                            <Border Grid.Column="1" Background="#EEEEEE" CornerRadius="9" Padding="8,1">
                                <TextBlock Text="{Binding NoMatchCount}" FontSize="10" FontWeight="Bold" Foreground="#777777"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <DataGrid ItemsSource="{Binding UnmatchedRows}" Style="{StaticResource FxGroupGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Current Workset Name" Binding="{Binding OldName, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource FxTertiaryCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

                <Expander Style="{StaticResource GroupExpander}" Tag="#B23B3B">
                    <Expander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" FontWeight="SemiBold" FontSize="12">
                                <Run Text="✕ Invalid / Blank"/>
                                <Run Text=" (cannot be actioned as-is)" FontWeight="Normal" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            </TextBlock>
                            <Border Grid.Column="1" Background="#FBDADA" CornerRadius="9" Padding="8,1">
                                <TextBlock Text="{Binding InvalidCount}" FontSize="10" FontWeight="Bold" Foreground="#B23B3B"/>
                            </Border>
                        </Grid>
                    </Expander.Header>
                    <DataGrid ItemsSource="{Binding InvalidRows}" Style="{StaticResource FxGroupGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Old Name" Binding="{Binding OldName, Mode=OneWay}" Width="*" IsReadOnly="True" ElementStyle="{StaticResource FxReadOnlyCellText}"/>
                            <DataGridTextColumn Header="New Name" Binding="{Binding NewName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Width="*" ElementStyle="{StaticResource FxInvalidCellText}" EditingElementStyle="{StaticResource FxEditingCellText}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>

            </StackPanel>
        </ScrollViewer>

        <!-- ══ Footer buttons ══════════════════════════════════════ -->
        <Grid Grid.Row="8" Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="Select All Valid"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding SelectAllValidCommand}"
                    Margin="0,0,6,0"/>
            <Button Grid.Column="1" Content="Clear"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding ClearAllCommand}"/>
            <TextBlock Grid.Column="2" Text="⚠ Duplicates are re-checked at Update time, including manual edits."
                       FontSize="10" Foreground="#A06A00" VerticalAlignment="Center" Margin="10,0"/>
            <Button Grid.Column="3" Content="Update ▶"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding UpdateCommand}"
                    MinWidth="100"/>
        </Grid>

        <!-- ══ Status bar ══════════════════════════════════════════ -->
        <TextBlock Grid.Row="9"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource StatusText}"
                   Margin="2,0,0,2"/>
    </Grid>
</Window>
