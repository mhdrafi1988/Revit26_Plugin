<!--
=======================================================
File: AnnotationOverlapPanel.xaml
Changes vs V002 (layout only, per Revit_Plugin_UI_Standard.md):
  - Now uses Shared/SharedStyles.xaml (navy theme) — was default WPF
    chrome with inline greys.
  - Three-zone layout: fixed top (title bar + version, metrics card with
    scanned / overlaps / breakdown), middle (annotation type list, results
    grid that fills and scrolls itself), fixed footer (busy bar, error
    banner, Check Overlaps → Close).
  - Adds a Close button; MinWidth/MinHeight = default size.
  - This tool has no log in its ViewModel, so the footer carries the
    status/error line instead (no behaviour change).
=======================================================
-->
<Window x:Class="Revit26_Plugin.AnnotationOverlapDetection.V003.Views.AnnotationOverlapPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Annotation Overlap Detection — V003"
        Width="760" Height="720"
        MinWidth="760" MinHeight="720"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ═══ FIXED TOP ═══════════════════════════════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Annotation Overlap Detection" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Find overlapping annotations in the active view" Style="{StaticResource HeaderSubtitle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V003" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <Grid Margin="12,10,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="10,8" Margin="0,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Scanned" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalScanned}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="Overlaps Found" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalOverlaps}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="10,8" Margin="4,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Breakdown" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding BreakdownByTypeText}" Style="{StaticResource FieldValue}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>

        <!-- ═══ MIDDLE ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="160"/>
            </Grid.RowDefinitions>

            <!-- Section 1: Type selector -->
            <Border Grid.Row="0" Style="{StaticResource ContentCard}" Padding="12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Annotation Types To Check" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Select All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding SelectAllCommand}" Margin="0,0,6,0" />
                            <Button Content="Clear All" Style="{StaticResource SmallSecondaryButton}" Command="{Binding ClearAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <ListBox ItemsSource="{Binding AnnotationFamilies}" MaxHeight="150"
                             BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TypeName}" Margin="6,0,4,0" VerticalAlignment="Center" />
                                    <TextBlock Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center">
                                        <Run Text="(" /><Run Text="{Binding Count, Mode=OneWay}" /><Run Text=" items)" />
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Section 4: Results grid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding OverlapResults}"
              Style="{StaticResource StandardDataGrid}"
              ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
              CellStyle="{StaticResource StandardDataGridCell}"
              RowStyle="{StaticResource StandardDataGridRow}"
              VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="ID 1" SortMemberPath="ElementId1">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ElementId1}"
                                        Command="{Binding DataContext.ZoomToElementCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding ElementId1}"
                                        Foreground="{StaticResource BrushAppleBlue}" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Type" Binding="{Binding AnnotationType}" />
                    <DataGridTextColumn Header="X (mm)" Binding="{Binding X, StringFormat={}{0:F4}}" />
                    <DataGridTextColumn Header="Y (mm)" Binding="{Binding Y, StringFormat={}{0:F4}}" />
                    <DataGridTextColumn Header="Aligned" Binding="{Binding GridAligned}" />
                    <DataGridTextColumn Header="V-Dist (mm)" Binding="{Binding VerticalDistance, StringFormat={}{0:F2}}" />
                    <DataGridTextColumn Header="H-Dist (mm)" Binding="{Binding HorizontalDistance, StringFormat={}{0:F2}}" />
                    <DataGridTemplateColumn Header="ID 2" SortMemberPath="ElementId2">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ElementId2}"
                                        Command="{Binding DataContext.ZoomToElementCommand,
                                                  RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding ElementId2}"
                                        Foreground="{StaticResource BrushAppleBlue}" BorderThickness="0" Background="Transparent"
                                        Cursor="Hand" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- ═══ FIXED FOOTER (never scrolls) ════════════════════ -->
        <StackPanel Grid.Row="2" Margin="12,8,12,12">
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Foreground="{StaticResource BrushNavyPrimary}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            <Border Background="{StaticResource BrushInputBackground}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1"
                    CornerRadius="6" Padding="8" Margin="0,0,0,8"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Check Overlaps" Style="{StaticResource RunButton}"
                        Command="{Binding CheckOverlapsCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                        MinWidth="150" Margin="0,0,8,0" />
                <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Height="38" Click="CloseButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
