<!--
=======================================================
File: Window1.xaml (BatchLinkWindow)
Changes vs the unversioned "_WOrking" build (layout only, per Revit_Plugin_UI_Standard.md):
  - Now uses Shared/SharedStyles.xaml (navy theme) — was default WPF
    chrome with inline greys.
  - Three-zone layout: fixed top (title bar + version, metrics card with
    total / processed / failures), middle (folder inputs + placement mode),
    fixed footer (progress, live log with Copy All / Copy Selected,
    Start Batch → Close).
  - MinWidth/MinHeight = default size. No behaviour change.
=======================================================
-->
<Window x:Class="BatchDwgFamilyLinker.V002.UI.BatchLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch DWG → Family Linker — V002"
        Height="650" Width="950"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemSecondaryBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Fixed top -->
            <RowDefinition Height="*"/>     <!-- Middle -->
            <RowDefinition Height="Auto"/>  <!-- Fixed footer -->
        </Grid.RowDefinitions>

        <!-- ══════════════ TOP ══════════════ -->
        <StackPanel Grid.Row="0">
            <Border Style="{StaticResource HeaderBar}" CornerRadius="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Batch DWG → Revit Family Linker" Style="{StaticResource HeaderTitle}"/>
                        <TextBlock Text="Link AutoCAD files into multiple Revit families safely" Style="{StaticResource HeaderSubtitle}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushNavyLight}" CornerRadius="10" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="V002" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextOnDark}"/>
                    </Border>
                </Grid>
            </Border>
            <UniformGrid Columns="3" Margin="12,12,12,0">
                <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Total Families" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding TotalFamilies}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Processed" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding ProcessedCount}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="Failures" Style="{StaticResource MetricLabel}"/>
                        <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" FontSize="18"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- ══════════════ MIDDLE ══════════════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,10,12,0">
            <Border Style="{StaticResource ContentCard}">
                <StackPanel>
                    <TextBlock Text="Revit Family Folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse" Width="90" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseFamilyFolderCommand}"/>
                        <TextBox Text="{Binding FamilyFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BoxedTextInput}"
                                 ToolTip="Paste or type full folder path"
                                 VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                    </DockPanel>

                    <TextBlock Text="AutoCAD DWG Folder" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="Browse" Width="90" Style="{StaticResource SecondaryButton}"
                                Command="{Binding BrowseDwgFolderCommand}"/>
                        <TextBox Text="{Binding DwgFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource BoxedTextInput}"
                                 ToolTip="Paste or type full folder path"
                                 VerticalContentAlignment="Center" Margin="0,0,6,0"/>
                    </DockPanel>

                    <TextBlock Text="DWG Placement Mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Origin to Origin" IsChecked="{Binding IsOriginToOrigin}" Margin="0,4,20,4"/>
                        <RadioButton Content="Center to Center" IsChecked="{Binding IsCenterToCenter}" Margin="0,4"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrushCardBackground}" BorderBrush="{StaticResource BrushCardBorder}"
                BorderThickness="0,1,0,0" Padding="12,10" Margin="0,10,0,0">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Height="8" Minimum="0" Maximum="{Binding TotalFamilies}" Value="{Binding ProcessedCount}"
                                 Foreground="{StaticResource BrushNavyPrimary}" Background="{StaticResource BrushSystemTertiaryBackground}"
                                 BorderThickness="0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressPercentText}" Style="{StaticResource HintText}"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Border Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="LogToggle" Style="{StaticResource LogHeaderToggle}" VerticalAlignment="Center" ToolTip="Show / hide the log">
                                <TextBlock Text="Live Processing Log" Foreground="{StaticResource BrushLogText}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </ToggleButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}" Click="CopyAllLog_Click"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Click="CopySelectedLog_Click" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBox Visibility="{Binding IsChecked, ElementName=LogToggle, Converter={StaticResource LogToggleVisibility}}" Grid.Row="1" x:Name="LiveLogBox" Text="{Binding LiveLog}" Height="120"
                                 IsReadOnly="True" AcceptsReturn="True"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushLogText}"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Start Batch" Style="{StaticResource RunButton}" Margin="0,0,8,0"
                                Command="{Binding StartBatchCommand}" IsEnabled="{Binding CanStart}"/>
                        <Button Content="Close" Style="{StaticResource SecondaryButton}" Command="{Binding CloseCommand}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
