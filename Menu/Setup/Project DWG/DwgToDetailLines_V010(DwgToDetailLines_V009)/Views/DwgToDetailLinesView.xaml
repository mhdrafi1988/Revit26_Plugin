<Window x:Class="Revit26_Plugin.DwgToDetailLines.V010.Views.DwgToDetailLinesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin.DwgToDetailLines.V010.Helpers"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="DWG to Detail Lines"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="560"
        MinWidth="480">

    <!-- ===================== -->
    <!-- Resources -->
    <!-- ===================== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <conv:NullableIntToDashConverter x:Key="NullableIntToDash"/>
            <conv:MetricCountToBrushConverter x:Key="MetricCountToBrush"/>
            <shared:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title header -->
            <RowDefinition Height="Auto"/> <!-- Context banner -->
            <RowDefinition Height="Auto"/> <!-- CAD import -->
            <RowDefinition Height="Auto"/> <!-- Metrics card -->
            <RowDefinition Height="Auto"/> <!-- Defaults card -->
            <RowDefinition Height="Auto"/> <!-- Layers & Hatches grid card -->
            <RowDefinition Height="Auto"/> <!-- Spline handling -->
            <RowDefinition Height="Auto"/> <!-- Transform Method (diagnostic) -->
            <RowDefinition Height="*"/>    <!-- Convert + log -->
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- TOOL TITLE HEADER -->
        <!-- ===================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushNavyPrimary}"
                Padding="10,8"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DWG to Detail Lines"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="13"/>
                <TextBlock Text="  V009"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- CONTEXT BANNER -->
        <!-- ===================== -->
        <Border Grid.Row="1"
                Background="#EAF1F8"
                BorderBrush="#B7CBE0"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding ContextBannerText}"
                       Foreground="#152A45"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===================== -->
        <!-- CAD IMPORT SELECTION -->
        <!-- ===================== -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Select CAD Import"
                       FontWeight="Bold"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableCads}"
                      SelectedItem="{Binding SelectedCad}"
                      MinHeight="26"/>
        </StackPanel>

        <!-- ===================== -->
        <!-- METRICS CARD -->
        <!-- ===================== -->
        <Border Grid.Row="3"
                BorderBrush="#D7DCE2"
                BorderThickness="1"
                Background="White"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CAD Import Info"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#152A45"
                           Margin="8,6,0,4"/>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.LayersFound}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Layers Found" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.Entities}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Entities" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.Placed, Converter={StaticResource NullableIntToDash}}"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Placed" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" BorderThickness="0,1,1,0" BorderBrush="#D7DCE2" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.Skipped, Converter={StaticResource NullableIntToDash}}"
                                       Foreground="{Binding Metrics.Skipped, Converter={StaticResource MetricCountToBrush}, ConverterParameter=Warning}"
                                       FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Skipped" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" BorderThickness="0,1,0,0" BorderBrush="#D7DCE2" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.Failed, Converter={StaticResource NullableIntToDash}}"
                                       Foreground="{Binding Metrics.Failed, Converter={StaticResource MetricCountToBrush}, ConverterParameter=Danger}"
                                       FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Failed" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- DEFAULTS -->
        <!-- ===================== -->
        <Border Grid.Row="4"
                BorderBrush="#D7DCE2"
                BorderThickness="1"
                Background="White"
                Margin="0,0,0,10">
            <StackPanel Margin="8">
                <TextBlock Text="Defaults"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#152A45"
                           Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Line Style" FontSize="10.5" Foreground="#5B7185" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableLineStyles}"
                                  SelectedItem="{Binding DefaultLineStyle}"
                                  MinHeight="26"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Default Fill Pattern" FontSize="10.5" Foreground="#5B7185" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding AvailableFillPatterns}"
                                  SelectedItem="{Binding DefaultFillPattern}"
                                  MinHeight="26"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Used when a layer has no existing style/pattern match. Per-row prompt still applies; this pre-fills the suggested choice."
                           FontSize="10"
                           Foreground="{StaticResource BrushTextTertiary}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- LAYERS & HATCHES GRID -->
        <!-- ===================== -->
        <Border Grid.Row="5"
                BorderBrush="#D7DCE2"
                BorderThickness="1"
                Background="White"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Layers &amp; Hatches To Convert"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#152A45"
                           Margin="8,6,0,4"/>

                <!-- Toolbar: filter + Select All/Clear/Refresh -->
                <StackPanel Orientation="Horizontal" Margin="8,0,8,6">
                    <TextBox Text="{Binding LayerFilterText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource StyledTextInput}"
                             Width="150"
                             Margin="0,0,6,0"/>
                    <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding LayerRowsView}"
                          SelectedItem="{Binding SelectedLayerRow}"
                          Style="{StaticResource StandardDataGrid}"
                          ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                          CellStyle="{StaticResource StandardDataGridCell}"
                          RowStyle="{StaticResource StandardDataGridRow}"
                          MaxHeight="200"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="10.5"
                                               Foreground="{StaticResource BrushNavyPrimary}"
                                               Background="{StaticResource BrushSystemTertiaryBackground}"
                                               Padding="6,3"/>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="36">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              PreviewMouseLeftButtonDown="LayerCheckBox_PreviewMouseLeftButtonDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Layer Name" Binding="{Binding LayerName}" Width="*"/>
                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                    <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Style / Pattern" Binding="{Binding ResolvedStyleName, Mode=OneWay}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock Margin="8,4,8,6" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}">
                    <Run Text="{Binding LayerRows.Count, Mode=OneWay}"/>
                    <Run Text=" layers found"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- SPLINE HANDLING -->
        <!-- ===================== -->
        <GroupBox Grid.Row="6"
                  Header="Spline Handling"
                  Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="6">
                <RadioButton Content="Preserve Splines"
                             IsChecked="{Binding SplineHandlingMode,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=Preserve}"/>

                <RadioButton Content="Tessellate"
                             Margin="12,0,0,0"
                             IsChecked="{Binding SplineHandlingMode,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=Tessellate}"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== -->
        <!-- TRANSFORM METHOD (TEMPORARY DIAGNOSTIC — V008) -->
        <!-- Remove this whole GroupBox once the correct transform is
             confirmed against a real DWG and hard-coded. -->
        <!-- ===================== -->
        <GroupBox Grid.Row="7"
                  Header="Transform Method (Diagnostic)"
                  Margin="0,0,0,10">
            <StackPanel Margin="6">
                <RadioButton Content="None (gi.Transform only)"
                             IsChecked="{Binding TransformMethod,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=None}"/>

                <RadioButton Content="GetTransform"
                             Margin="0,4,0,0"
                             IsChecked="{Binding TransformMethod,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=GetTransform}"/>

                <RadioButton Content="GetTotalTransform (incl. true north)"
                             Margin="0,4,0,0"
                             IsChecked="{Binding TransformMethod,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=GetTotalTransform}"/>

                <TextBlock Text="Try each option, Convert, and compare against the DWG's actual position. Report back which one lands exactly."
                           Style="{StaticResource HintText}"
                           Margin="0,6,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== -->
        <!-- CONVERT + LOG -->
        <!-- ===================== -->
        <Grid Grid.Row="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Convert Button (right-aligned per Autodesk dialog guidelines) -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8">
                <Button Content="Convert DWG"
                        Width="140"
                        Height="30"
                        Command="{Binding ConvertCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Log"
                           FontWeight="Bold"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Content="Copy All"
                        Command="{Binding CopyAllLogCommand}"
                        Style="{StaticResource SmallSecondaryButton}"/>
            </Grid>

            <!-- LOG PANEL (COPYABLE) -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding LogEntries}"
                     BorderBrush="#D7DCE2"
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- TextBox used intentionally so user can COPY -->
                        <TextBox Text="{Binding Message, Mode=OneWay}"
                                 Foreground="{Binding Color}"
                                 Background="White"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Focusable="True"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
