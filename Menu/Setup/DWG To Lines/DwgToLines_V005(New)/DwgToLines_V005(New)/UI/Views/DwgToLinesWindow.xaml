<!--
=======================================================
File: DwgToLinesWindow.xaml
Location: UI/Views/
Changes vs V004 (per approved mockup):
  - Plain default WPF window (no theme at all, hardcoded AliceBlue log
    background) replaced with the navy SharedStyles theme used across the
    suite. All functionality preserved: CAD import picker, Placement Mode,
    Spline Handling, Extrusion-ready checkbox, Convert.
  - ADDED Close button + Esc-to-close (modal dialog, but consistent with
    the rest of the suite).
  - ADDED activity log title bar with Export / Copy Selected / Copy All,
    matching the shared log-panel pattern (was a bare unstyled ListBox
    bound to a nonexistent property before).
  - MinWidth/MinHeight added, locked to the default Width/Height.
=======================================================
-->
<Window x:Class="Revit26_Plugin.DwgToLines.V005.UI.Views.DwgToLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:local="clr-namespace:Revit26_Plugin.DwgToLines.V005.Infrastructure.Helpers"
        Title="DWG to Lines — V005"
        Width="560" Height="640"
        MinWidth="560" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Header bar -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>   <!-- CAD import picker -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>   <!-- Placement mode -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Spline handling -->
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>   <!-- Extrusion-ready checkbox -->
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>   <!-- Convert / Close buttons -->
            <RowDefinition Height="10"/>
            <RowDefinition Height="*" MinHeight="160"/>   <!-- Log area -->
        </Grid.RowDefinitions>

        <!-- ── Header bar ── -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <StackPanel>
                <TextBlock Text="DWG to Lines" Style="{StaticResource HeaderTitle}"/>
                <TextBlock Text="Convert CAD import to Symbolic / Model lines (Family Editor)" Style="{StaticResource HeaderSubtitle}"/>
            </StackPanel>
        </Border>

        <!-- ── CAD import picker ── -->
        <StackPanel Grid.Row="2">
            <TextBlock Text="CAD Import" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
            <ComboBox Style="{StaticResource StandardComboBox}" Height="32"
                      ItemsSource="{Binding AvailableCads}"
                      SelectedItem="{Binding SelectedCad, Mode=TwoWay}"/>
        </StackPanel>

        <!-- ── Placement mode ── -->
        <Border Grid.Row="4" Style="{StaticResource ContentCard}">
            <StackPanel Margin="10">
                <TextBlock Text="Placement Mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Symbolic Only" Margin="0,0,18,0"
                                 IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicOnly}"/>
                    <RadioButton Content="Model Only" Margin="0,0,18,0"
                                 IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=ModelOnly}"/>
                    <RadioButton Content="Symbolic + Model"
                                 IsChecked="{Binding PlacementMode, Converter={StaticResource BoolToEnum}, ConverterParameter=SymbolicAndModel}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Spline handling ── -->
        <Border Grid.Row="6" Style="{StaticResource ContentCard}">
            <StackPanel Margin="10">
                <TextBlock Text="Spline Handling" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Preserve Splines" Margin="0,0,18,0"
                                 IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Preserve}"/>
                    <RadioButton Content="Tessellate"
                                 IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Tessellate}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Extrusion-ready mode ── -->
        <CheckBox Grid.Row="8"
                  Content="Extrusion-ready mode (snap endpoints, detect loops)"
                  IsChecked="{Binding ExtrusionReadyMode}"/>

        <!-- ── Convert / Close buttons ── -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Close" Style="{StaticResource OutlineButton}" Width="90" Margin="0,0,8,0"
                    Command="{Binding CloseCommand}"/>
            <Button Content="Convert DWG" Style="{StaticResource PrimaryButton}" Width="130"
                    Command="{Binding ConvertCommand}"/>
        </StackPanel>

        <!-- ── Activity log ── -->
        <Border Grid.Row="12" Background="{StaticResource BrushLogBg}" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{StaticResource BrushLogTitleBar}"
                        CornerRadius="8,8,0,0" Padding="12,7">
                    <Grid>
                        <TextBlock Text="Activity log"
                                   Foreground="{StaticResource BrushLogText}"
                                   FontSize="11.5" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Export" Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding ExportLogCommand}" Margin="0,0,6,0"
                                    ToolTip="Save the log to a .txt file"/>
                            <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding CopySelectedLogsCommand}" Margin="0,0,6,0"
                                    ToolTip="Copy the selected log lines"/>
                            <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                    Command="{Binding CopyAllLogsCommand}"
                                    ToolTip="Copy the whole log to the clipboard"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1"
                         x:Name="LogList"
                         ItemsSource="{Binding LogEntries}"
                         SelectionMode="Extended"
                         SelectionChanged="LogList_SelectionChanged"
                         Background="Transparent"
                         BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Padding="12,8">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                           Foreground="{StaticResource BrushLogTextDim}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Message}"
                                           Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                           FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

    </Grid>
</Window>
