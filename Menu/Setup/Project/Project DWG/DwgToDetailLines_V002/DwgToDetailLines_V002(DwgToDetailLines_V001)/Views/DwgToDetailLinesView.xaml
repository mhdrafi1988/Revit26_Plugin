<Window x:Class="Revit26_Plugin.DwgToDetailLines.V002.Views.DwgToDetailLinesView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Revit26_Plugin.DwgToDetailLines.V002.Helpers"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="DWG to Detail Lines"
        Height="620"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        MinHeight="560"
        MinWidth="480">

    <!-- ===================== -->
    <!-- Resources -->
    <!-- ===================== -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <shared:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="12" Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title header -->
            <RowDefinition Height="Auto"/> <!-- Context banner -->
            <RowDefinition Height="Auto"/> <!-- CAD import -->
            <RowDefinition Height="Auto"/> <!-- Metrics card -->
            <RowDefinition Height="Auto"/> <!-- Spline handling -->
            <RowDefinition Height="*"/>    <!-- Convert + log -->
        </Grid.RowDefinitions>

        <!-- ===================== -->
        <!-- TOOL TITLE HEADER -->
        <!-- ===================== -->
        <Border Grid.Row="0"
                Background="{StaticResource BrushNavyPrimary}"
                Padding="10,8"
                Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="DWG to Detail Lines"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="13"/>
                <TextBlock Text="  V001"
                           Foreground="#CBD5E1"
                           FontSize="11"
                           VerticalAlignment="Bottom"/>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- CONTEXT BANNER -->
        <!-- ===================== -->
        <Border Grid.Row="1"
                Background="#EAF1F8"
                BorderBrush="#B7CBE0"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,10">
            <TextBlock Text="{Binding ContextBannerText}"
                       Foreground="#152A45"
                       FontSize="11"
                       TextWrapping="Wrap"/>
        </Border>

        <!-- ===================== -->
        <!-- CAD IMPORT SELECTION -->
        <!-- ===================== -->
        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="Select CAD Import"
                       FontWeight="Bold"
                       FontSize="12"
                       Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableCads}"
                      SelectedItem="{Binding SelectedCad}"
                      MinHeight="26"/>
        </StackPanel>

        <!-- ===================== -->
        <!-- METRICS CARD -->
        <!-- ===================== -->
        <Border Grid.Row="3"
                BorderBrush="#D7DCE2"
                BorderThickness="1"
                Background="White"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CAD Import Info"
                           FontWeight="Bold"
                           FontSize="11"
                           Foreground="#152A45"
                           Margin="8,6,0,4"/>
                <Grid Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.LayersFound}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Layers Found" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Metrics.Entities}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Entities" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#D7DCE2" BorderThickness="0,1,1,0" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource BrushNavyPrimary}"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Metrics.Placed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.Placed}" Value="{x:Null}">
                                                <Setter Property="Text" Value="—"/>
                                                <Setter Property="Foreground" Value="#AEB6BF"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Placed" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" BorderThickness="0,1,0,0" BorderBrush="#D7DCE2" Padding="6,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Metrics.Skipped}"/>
                                        <Setter Property="Foreground" Value="#B45309"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Metrics.Skipped}" Value="{x:Null}">
                                                <Setter Property="Text" Value="—"/>
                                                <Setter Property="Foreground" Value="#AEB6BF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Metrics.Skipped}" Value="0">
                                                <Setter Property="Foreground" Value="{StaticResource BrushNavyPrimary}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="Skipped" FontSize="10" Foreground="#6B7684"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===================== -->
        <!-- SPLINE HANDLING -->
        <!-- ===================== -->
        <GroupBox Grid.Row="4"
                  Header="Spline Handling"
                  Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="6">
                <RadioButton Content="Preserve Splines"
                             IsChecked="{Binding SplineHandlingMode,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=Preserve}"/>

                <RadioButton Content="Tessellate"
                             Margin="12,0,0,0"
                             IsChecked="{Binding SplineHandlingMode,
                             Converter={StaticResource BoolToEnum},
                             ConverterParameter=Tessellate}"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== -->
        <!-- CONVERT + LOG -->
        <!-- ===================== -->
        <Grid Grid.Row="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Convert Button (right-aligned per Autodesk dialog guidelines) -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,0,8">
                <Button Content="Convert DWG"
                        Width="140"
                        Height="30"
                        Command="{Binding ConvertCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"
                        Style="{StaticResource PrimaryButton}"/>
            </StackPanel>

            <TextBlock Grid.Row="1"
                       Text="Log"
                       FontWeight="Bold"
                       FontSize="12"
                       Margin="0,0,0,4"/>

            <!-- LOG PANEL (COPYABLE) -->
            <ListBox Grid.Row="2"
                     ItemsSource="{Binding LogEntries}"
                     BorderBrush="#D7DCE2"
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- TextBox used intentionally so user can COPY -->
                        <TextBox Text="{Binding Message}"
                                 Foreground="{Binding Color}"
                                 Background="White"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas"
                                 FontSize="11"
                                 Focusable="True"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
