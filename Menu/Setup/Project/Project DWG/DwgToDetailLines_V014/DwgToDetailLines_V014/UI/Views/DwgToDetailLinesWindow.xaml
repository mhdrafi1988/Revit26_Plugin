<!--
=======================================================
File: DwgToDetailLinesWindow.xaml
Location: UI/Views/
Changes vs V013:
  - Left column: "Line Style Mapping" card (Layer name / Shortlist mode,
    filterable shortlist of project line styles, Auto-assign) and
    "Placement" card (Place beside CAD + CAD width).
  - Layers grid: CAD colour swatch column; in Shortlist mode the
    Style column is a dropdown limited to the shortlisted styles.
Changes vs V012 (layout only, per CLAUDE.md v1.1 — ToolWindowShell):
  - Window content is a shared ToolWindowShell:
      HEADER  title bar + V013, metrics card, context banner
      BODY    left: CAD import, defaults, spline handling, transform
              method (own ScrollViewer removed); right: Layers &amp;
              Hatches grid; below: Activity Log (moved here from the footer)
      FOOTER  status strip (IsRunning, indeterminate), Convert DWG → Close
  - Layers grid and log: ShellBehaviors.MaxHeightRatio + ForwardMouseWheel.
  - No behaviour change — every binding/command is the V012 one.
=======================================================
-->
<Window x:Class="Revit26_Plugin.DwgToDetailLines.V014.UI.Views.DwgToDetailLinesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shared="clr-namespace:Revit26_Plugin.Shared.Models"
        xmlns:shell="clr-namespace:Revit26_Plugin.Shared.Controls"
        xmlns:local="clr-namespace:Revit26_Plugin.DwgToDetailLines.V014.Infrastructure.Helpers"
        Title="DWG to Detail Lines — V014"
        Width="980" Height="760"
        MinWidth="980" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:BooleanToEnumConverter x:Key="BoolToEnum"/>
            <local:NullableIntToDashConverter x:Key="NullableIntToDash"/>
            <local:MetricCountToBrushConverter x:Key="MetricCountToBrush"/>
            <shared:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
            <shared:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility"/>
            <shared:LogLevelToColorConverter x:Key="LogLevelToColor"/>
        </ResourceDictionary>
    </Window.Resources>

    <shell:ToolWindowShell Title="DWG to Detail Lines"
                           Subtitle="Convert CAD import to Detail Curves / Filled Regions"
                           Version="V014"
                           IsRunning="{Binding IsRunning}"
                           IsIndeterminate="True"
                           Progress="{Binding Progress}"
                           SummaryText="{Binding SummaryText}">

        <!-- ═══ HEADER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.HeaderContent>
            <StackPanel>
                <UniformGrid Columns="5" Margin="0,0,0,0">
                    <Border Style="{StaticResource MetricCard}" Margin="0,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Layers Found" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Metrics.LayersFound}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Entities" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Metrics.Entities}" Style="{StaticResource MetricNumber}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Placed" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Metrics.Placed, Converter={StaticResource NullableIntToDash}}" Style="{StaticResource MetricNumberSuccess}" FontSize="18"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,4,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Metrics.Skipped, Converter={StaticResource NullableIntToDash}}" Style="{StaticResource MetricNumber}" FontSize="18"
                                       Foreground="{Binding Metrics.Skipped, Converter={StaticResource MetricCountToBrush}, ConverterParameter=Warning}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource MetricCard}" Margin="4,0,0,0" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="Failed" Style="{StaticResource MetricLabel}"/>
                            <TextBlock Text="{Binding Metrics.Failed, Converter={StaticResource NullableIntToDash}}" Style="{StaticResource MetricNumber}" FontSize="18"
                                       Foreground="{Binding Metrics.Failed, Converter={StaticResource MetricCountToBrush}, ConverterParameter=Danger}"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Margin="0,10,0,8">
                    <!-- ── Context banner ── -->
                    <Border Background="{StaticResource BrushSystemTertiaryBackground}"
                            BorderBrush="{StaticResource BrushNavyPrimary}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                        <TextBlock Text="{Binding ContextBannerText}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource BrushNavyPrimary}"/>
                    </Border>
                </Grid>
            </StackPanel>
        </shell:ToolWindowShell.HeaderContent>

        <!-- ═══ BODY ═════════════════════════════════════════════ -->
        <shell:ToolWindowShell.BodyContent>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="0">
                    <!-- ── CAD import ── -->
                    <StackPanel>
                        <TextBlock Text="CAD Import" Style="{StaticResource FieldLabel}" Margin="0,0,0,6"/>
                        <ComboBox Style="{StaticResource StandardComboBox}" Height="32"
                                  ItemsSource="{Binding AvailableCads}"
                                  SelectedItem="{Binding SelectedCad, Mode=TwoWay}"/>
                    </StackPanel>
                    <!-- ── Defaults ── -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="Defaults" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Default Line Style" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Height="30"
                                              ItemsSource="{Binding AvailableLineStyles}"
                                              SelectedItem="{Binding DefaultLineStyle}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default Fill Pattern" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                                    <ComboBox Style="{StaticResource StandardComboBox}" Height="30"
                                              ItemsSource="{Binding AvailableFillPatterns}"
                                              SelectedItem="{Binding DefaultFillPattern}"/>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="Populated from this project's actual line styles / fill region types. Default line style is the fallback when a mapped style is missing or not allowed on detail lines."
                                       Style="{StaticResource HintText}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- ── Line style mapping (V014) ── -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="Line Style Mapping" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Shortlist (auto-assign)" Margin="0,0,18,0"
                                             IsChecked="{Binding MappingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Shortlist}"/>
                                <RadioButton Content="Layer name (V013)"
                                             IsChecked="{Binding MappingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=LayerName}"/>
                            </StackPanel>
                            <StackPanel IsEnabled="{Binding IsShortlistMode}" Margin="0,8,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding LineStyleFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource StyledTextInput}" Margin="0,0,6,0"
                                             ToolTip="Filter line styles by name"/>
                                    <Button Grid.Column="1" Content="Auto-assign" Command="{Binding AutoAssignCommand}"
                                            Style="{StaticResource SmallSecondaryButton}"
                                            ToolTip="Re-match every line layer to the closest shortlisted style (colour, lineweight, pattern)"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding LineStyleOptionsView}"
                                         Height="150"
                                         BorderBrush="{StaticResource BrushTextTertiary}" BorderThickness="1"
                                         shell:ShellBehaviors.ForwardMouseWheel="True"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1">
                                                <CheckBox IsChecked="{Binding IsShortlisted, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                <Border Width="12" Height="12" Margin="6,0,6,0" CornerRadius="2"
                                                        Background="{Binding Swatch}" BorderBrush="{StaticResource BrushTextTertiary}" BorderThickness="1"
                                                        VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" FontSize="10.5"
                                                           Foreground="{StaticResource BrushTextTertiary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="{Binding ShortlistSummary}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                                <TextBlock Text="Each line layer is mapped to one shortlisted style (name match first, then closest colour / lineweight / pattern). Change any row in the grid. No line styles are created."
                                           Style="{StaticResource HintText}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- ── Placement (V014) ── -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="Placement" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <CheckBox Content="Place beside CAD (offset right by 1× CAD width)"
                                      IsChecked="{Binding PlaceBesideCad}"/>
                            <TextBlock Text="{Binding CadSizeText}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <!-- ── Spline handling ── -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0">
                        <StackPanel Margin="10">
                            <TextBlock Text="Spline Handling" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Preserve Splines" Margin="0,0,18,0"
                                             IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Preserve}"/>
                                <RadioButton Content="Tessellate"
                                             IsChecked="{Binding SplineHandlingMode, Converter={StaticResource BoolToEnum}, ConverterParameter=Tessellate}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <!-- ── Transform Method (TEMPORARY DIAGNOSTIC) — left as-is, per Rafi ── -->
                    <Border Style="{StaticResource ContentCard}" Margin="0,10,0,0" BorderThickness="1" BorderBrush="{StaticResource BrushTextTertiary}">
                        <StackPanel Margin="10">
                            <TextBlock Text="Transform Method (Diagnostic)" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
                            <StackPanel>
                                <RadioButton Content="None (gi.Transform only)"
                                             IsChecked="{Binding TransformMethod, Converter={StaticResource BoolToEnum}, ConverterParameter=None}"/>
                                <RadioButton Content="GetTransform" Margin="0,4,0,0"
                                             IsChecked="{Binding TransformMethod, Converter={StaticResource BoolToEnum}, ConverterParameter=GetTransform}"/>
                                <RadioButton Content="GetTotalTransform (incl. true north)" Margin="0,4,0,0"
                                             IsChecked="{Binding TransformMethod, Converter={StaticResource BoolToEnum}, ConverterParameter=GetTotalTransform}"/>
                                <TextBlock Text="Try each option, Convert, and compare against the DWG's actual position. Report back which one lands exactly."
                                           Style="{StaticResource HintText}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ── Layers & Hatches grid ── -->
                <Border Grid.Column="2" Style="{StaticResource ContentCard}">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Layers &amp; Hatches To Convert" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox Text="{Binding LayerFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource StyledTextInput}" Width="160" Margin="0,0,6,0"/>
                            <Button Content="Select All" Command="{Binding SelectAllCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SmallSecondaryButton}" Margin="0,0,4,0"/>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource SmallSecondaryButton}"/>
                        </StackPanel>

                        <DataGrid Grid.Row="2" ItemsSource="{Binding LayerRowsView}"
                                  MinHeight="200"
                                  shell:ShellBehaviors.MaxHeightRatio="0.45"
                                  shell:ShellBehaviors.ForwardMouseWheel="True"
                                  SelectedItem="{Binding SelectedLayerRow}"
                                  Style="{StaticResource StandardDataGrid}"
                                  ColumnHeaderStyle="{StaticResource StandardDataGridColumnHeader}"
                                  CellStyle="{StaticResource StandardDataGridCell}"
                                  RowStyle="{StaticResource StandardDataGridRow}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold" FontSize="10.5"
                                                       Foreground="{StaticResource BrushNavyPrimary}"
                                                       Background="{StaticResource BrushSystemTertiaryBackground}"
                                                       Padding="6,3"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="36">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      PreviewMouseLeftButtonDown="LayerCheckBox_PreviewMouseLeftButtonDown"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="" Width="26">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="12" Height="12" CornerRadius="2"
                                                    Background="{Binding Swatch}" BorderBrush="{StaticResource BrushTextTertiary}" BorderThickness="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    ToolTip="CAD layer colour"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Layer Name" Binding="{Binding LayerName}" Width="*"/>
                                <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="60">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                    <DataGridTextColumn.HeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource StandardDataGridColumnHeader}">
                                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                                        </Style>
                                    </DataGridTextColumn.HeaderStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Style / Pattern" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <TextBlock Text="{Binding ResolvedStyleName, Mode=OneWay}" VerticalAlignment="Center"
                                                           Visibility="{Binding IsStyleEditable, Converter={StaticResource InverseBoolToVisibility}}"/>
                                                <ComboBox ItemsSource="{Binding DataContext.ShortlistNames, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                          SelectedItem="{Binding ResolvedStyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding IsStyleEditable, Converter={StaticResource BoolToVisibility}}"
                                                          Height="24" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <TextBlock Grid.Row="3" Margin="0,6,0,0" FontSize="10.5" Foreground="{StaticResource BrushTextTertiary}">
                            <Run Text="{Binding LayerRows.Count, Mode=OneWay}"/>
                            <Run Text=" layers found"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- ── Activity Log (moved from footer) ── -->
                <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0" Background="{StaticResource BrushLogBg}" CornerRadius="8" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Activity Log" Foreground="{StaticResource BrushLogText}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                        Command="{Binding CopyAllLogCommand}" ToolTip="Copy the whole log to the clipboard"/>
                                <Button Content="Copy Selected" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding CopySelectedLogCommand}" ToolTip="Copy the selected log lines"/>
                                <Button Content="Export" Style="{StaticResource DarkGhostButton}" Margin="6,0,0,0"
                                        Command="{Binding ExportLogCommand}" ToolTip="Save the log to a .txt file"/>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <ListBox x:Name="LogList"
                                     ItemsSource="{Binding LogEntries}"
                                     SelectionMode="Extended"
                                     SelectionChanged="LogList_SelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Padding="0"
                                     MinHeight="110"
                                     shell:ShellBehaviors.MaxHeightRatio="0.2"
                                     shell:ShellBehaviors.ForwardMouseWheel="True">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,1">
                                            <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                                                       Foreground="{StaticResource BrushLogTextDim}"
                                                       FontFamily="Consolas" FontSize="11.5" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding Message}"
                                                       Foreground="{Binding Level, Converter={StaticResource LogLevelToColor}}"
                                                       FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </shell:ToolWindowShell.BodyContent>

        <!-- ═══ FOOTER ═══════════════════════════════════════════ -->
        <shell:ToolWindowShell.FooterContent>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Convert DWG" Style="{StaticResource PrimaryButton}" Width="140" Margin="0,0,8,0"
                        Command="{Binding ConvertCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource InverseBoolConverter}}"/>
                <Button Content="Close" Style="{StaticResource SecondaryButton}" Width="90"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </shell:ToolWindowShell.FooterContent>
    </shell:ToolWindowShell>
</Window>
