<Window x:Class="Revit26_Plugin.RoofTag_V007_A.RoofTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofTag_V007_A"
        Title="Roof Tag V007.A (FaceRef)"
        Height="680" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <local:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <local:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <DataTemplate x:Key="LogRowTemplate">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="11"
                               Width="62" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Level, StringFormat={}{0,-7}}"
                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                               FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                               Width="70" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Message}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="11"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,10,12,12">

            <!-- ── WARNING BANNER ──────────────────────────────────────── -->
            <Border Background="#FFE8CB" BorderBrush="#FFB26B" BorderThickness="1"
                    CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="⚠ FaceRef Method" Foreground="#8B4513" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBlock Text="Tags anchored to roof face. Tags will DELETE if you edit slab shape elevations after placement."
                               Foreground="#8B4513" FontSize="11" TextWrapping="Wrap"
                               LineHeight="14"/>
                    <TextBlock Text="Place tags AFTER finalizing slope."
                               Foreground="#8B4513" FontSize="11" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ── TAG MODE ─────────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Tag mode" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Auto"   Margin="0,0,16,0"
                                     IsChecked="{Binding UseManualMode,
                                         Converter={StaticResource InverseBoolConverter}}"/>
                        <RadioButton Content="Manual (pick points)"
                                     IsChecked="{Binding UseManualMode}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ── LEADER GEOMETRY ──────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Leader geometry" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Angle" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="45°" Margin="0,0,16,0" IsChecked="{Binding IsAngle45}"/>
                            <RadioButton Content="30°"                   IsChecked="{Binding IsAngle30}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Bend direction" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" FontSize="11"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="Inward"  Margin="0,0,16,0" IsChecked="{Binding BendInward}"/>
                            <RadioButton Content="Outward"                    IsChecked="{Binding BendOutward}"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="6"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Bend offset" Style="{StaticResource FieldLabel}" FontSize="11"
                                   VerticalAlignment="Center" Grid.Row="0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,4,0"
                                 Style="{StaticResource BoxedTextInput}"
                                 Text="{Binding BendOffset, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2"
                                   Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center"/>

                        <TextBlock Text="End offset" Style="{StaticResource FieldLabel}" FontSize="11"
                                   VerticalAlignment="Center" Grid.Row="2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,4,0"
                                 Style="{StaticResource BoxedTextInput}"
                                 Text="{Binding EndOffset, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2"
                                   Text="mm" Style="{StaticResource UnitLabel}" VerticalAlignment="Center"/>
                    </Grid>

                    <Separator Margin="0,8,0,8"/>

                    <CheckBox Content="Use leader line" IsChecked="{Binding UseLeader}"/>
                </StackPanel>
            </Border>

            <!-- ── SPOT TAG TYPE ─────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Spot tag type" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource StandardComboBox}"
                              ItemsSource="{Binding SpotTagTypes}"
                              SelectedItem="{Binding SelectedSpotTagType}"
                              DisplayMemberPath="Name"/>
                </StackPanel>
            </Border>

            <!-- ── LOG PANEL ─────────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource BrushLogTitleBar}"
                            CornerRadius="8,8,0,0" Padding="10,6">
                        <Grid>
                            <TextBlock Text="Log"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding CopyLogCommand}"
                                    Content="Copy" Padding="8,2"
                                    FontSize="10" Height="22"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource BrushLogBg}"
                            CornerRadius="0,0,8,8" Padding="8,6">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 ItemTemplate="{StaticResource LogRowTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="100"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── SUMMARY STRIP ─────────────────────────────────────── -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlacedCount}"
                                   Style="{StaticResource MetricNumberSuccess}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Placed"
                                   Style="{StaticResource MetricLabel}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailedCount}"
                                   Style="{StaticResource MetricNumberDanger}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed"
                                   Style="{StaticResource MetricLabel}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── BUTTONS ───────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Width="80" Margin="0,0,8,0" Click="OnCancel"/>
                <Button Content="OK"     Style="{StaticResource PrimaryButton}"
                        Width="80" Click="OnOK"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
