<Window x:Class="Revit26_Plugin.RoofTag_V014.RoofTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Revit26_Plugin.RoofTag_V014"
        Title="Roof Tag V014 (FaceRef)"
        Height="640" Width="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{DynamicResource BrushSystemBackground}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:InverseBoolConverter             x:Key="InverseBoolConverter"/>
            <local:BoolToVisibilityConverter        x:Key="BoolToVisibilityConverter"/>
            <local:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>

            <DataTemplate x:Key="LogRowTemplate">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                    <TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="10"
                               Width="58" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Level, StringFormat={}{0,-7}}"
                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                               FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"
                               Width="64" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding Message}"
                               Foreground="{StaticResource BrushLogTextDim}"
                               FontFamily="Consolas" FontSize="10"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10,8,10,10">

            <!-- ── HEADER BAR ───────────────────────────────────────── -->
            <Border Style="{StaticResource HeaderBar}" Margin="0,0,0,8" Padding="12,9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Roof Tag" Style="{StaticResource HeaderTitle}" FontSize="14"/>
                        <TextBlock Text="FaceRef method" Style="{StaticResource HeaderSubtitle}" FontSize="10"/>
                    </StackPanel>
                    <Border Style="{StaticResource BadgePill}" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="V014" Style="{StaticResource BadgeText}" FontSize="10.5"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── WARNING BANNER ──────────────────────────────────────── -->
            <Border Background="#FFE8CB" BorderBrush="#FFB26B" BorderThickness="1"
                    CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                <TextBlock FontSize="10" Foreground="#8B4513" FontWeight="SemiBold" TextWrapping="Wrap"
                           Text="FaceRef method — tags DELETE if slab shape is edited after placement. Place tags after finalizing slope."/>
            </Border>

            <!-- ── TAG MODE ─────────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Tag mode" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <RadioButton Content="Auto" FontSize="10" Margin="0,0,14,0"
                                     IsChecked="{Binding UseManualMode, Converter={StaticResource InverseBoolConverter}}"/>
                        <RadioButton Content="Manual (pick points)" FontSize="10" IsChecked="{Binding UseManualMode}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── LEADER GEOMETRY ──────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                <StackPanel>
                    <TextBlock Text="Leader geometry" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushNavyPrimary}" Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Angle" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <RadioButton Content="45°" FontSize="10" Margin="0,0,10,0" IsChecked="{Binding IsAngle45}"/>
                            <RadioButton Content="30°" FontSize="10" IsChecked="{Binding IsAngle30}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="Bend" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal">
                            <RadioButton Content="Inward" FontSize="10" Margin="0,0,10,0" IsChecked="{Binding BendInward}"/>
                            <RadioButton Content="Outward" FontSize="10" IsChecked="{Binding BendOutward}"/>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Bend" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1" IsEditable="True" FontSize="10" Height="24" Padding="4,2"
                                  Background="White" Foreground="{StaticResource BrushTextPrimary}"
                                  ItemsSource="{Binding PresetOffsetValues}"
                                  Text="{Binding BendOffset, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="3" Text="End" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="4" IsEditable="True" FontSize="10" Height="24" Padding="4,2"
                                  Background="White" Foreground="{StaticResource BrushTextPrimary}"
                                  ItemsSource="{Binding PresetOffsetValues}"
                                  Text="{Binding EndOffset, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Column="5" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>

                        <CheckBox Grid.Column="7" Content="Use leader" FontSize="10" VerticalAlignment="Center"
                                  IsChecked="{Binding UseLeader}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── SPOT TAG TYPE ─────────────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Spot tag type" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource BrushNavyPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox Grid.Column="1" FontSize="10" Height="24"
                              Background="White" Foreground="{StaticResource BrushTextPrimary}"
                              ItemsSource="{Binding SpotTagTypes}"
                              SelectedItem="{Binding SelectedSpotTagType}"
                              DisplayMemberPath="Name"/>
                </Grid>
            </Border>

            <!-- ── CLUSTER FILTER (Rule 1) ────────────────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Content="Cluster filter — avoid clustered tags near drains" FontSize="10"
                              VerticalAlignment="Center" IsChecked="{Binding ClusterFilterEnabled}"/>
                    <TextBlock Grid.Column="1" Text="Radius" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                               VerticalAlignment="Center" Margin="8,0,6,0"/>
                    <TextBox Grid.Column="2" FontSize="10" Height="24" MaxLength="10"
                             Background="White" Foreground="{StaticResource BrushTextPrimary}"
                             BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                             VerticalContentAlignment="Center" Padding="6,0"
                             IsEnabled="{Binding ClusterFilterEnabled}"
                             Text="{Binding ClusterRadius, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="3" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                               VerticalAlignment="Center" Margin="4,0,0,0"/>
                </Grid>
            </Border>

            <!-- ── INTERIOR LOOP REDUCTION (Rule 2) ───────────────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,6" Padding="10,8">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="Interior loop reduction — reduce points per loop" FontSize="10"
                                  VerticalAlignment="Center" IsChecked="{Binding InteriorLoopReductionEnabled}"/>
                        <TextBlock Grid.Column="1" Text="Spacing" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"
                                   VerticalAlignment="Center" Margin="8,0,6,0"/>
                        <TextBox Grid.Column="2" FontSize="10" Height="24" MaxLength="10"
                                 Background="White" Foreground="{StaticResource BrushTextPrimary}"
                                 BorderBrush="{StaticResource BrushSeparator}" BorderThickness="1"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 IsEnabled="{Binding InteriorLoopReductionEnabled}"
                                 Text="{Binding InteriorLoopSpacing, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="mm" FontSize="10" Foreground="{StaticResource BrushTextTertiary}"
                                   VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                    <TextBlock FontSize="9.5" Foreground="{StaticResource BrushTextTertiary}" TextWrapping="Wrap" Margin="0,5,0,0"
                               Text="Top 4 highest points per loop, kept only if each neighbor pair is at least this far apart horizontally — otherwise only the highest point is kept."/>
                </StackPanel>
            </Border>

            <!-- ── SUMMARY STRIP ─────────────────────────────────────── -->
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCard}" Padding="8,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding PlacedCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrushSuccess}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Placed" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource MetricCard}" Padding="8,8">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding FailedCount}" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource BrushDanger}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Failed" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── LOG PANEL (kept at bottom, above buttons) ──────────── -->
            <Border Style="{StaticResource SectionCard}" Margin="0,0,0,8" Padding="0">
                <StackPanel>
                    <Border Background="{StaticResource BrushLogTitleBar}"
                            CornerRadius="8,8,0,0" Padding="10,5">
                        <Grid>
                            <TextBlock Text="Log"
                                       Foreground="{StaticResource BrushLogText}"
                                       FontSize="10.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding CopyLogCommand}"
                                    Content="Copy" Padding="8,2"
                                    FontSize="10" Height="20"/>
                        </Grid>
                    </Border>

                    <Border Background="{StaticResource BrushLogBg}"
                            CornerRadius="0,0,8,8" Padding="8,5">
                        <ListBox ItemsSource="{Binding LogEntries}"
                                 ItemTemplate="{StaticResource LogRowTemplate}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Height="80"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 VirtualizingPanel.ScrollUnit="Pixel"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ── BUTTONS ───────────────────────────────────────────── -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Width="80" Margin="0,0,8,0" Click="OnCancel"/>
                <Button Content="OK"     Style="{StaticResource PrimaryButton}"
                        Width="80" Click="OnOK"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
