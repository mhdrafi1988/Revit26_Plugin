<Window x:Class="Revit26_Plugin.DetailLIneDimensions.V005.Views.DetailLineDimensionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="{Binding WindowTitle}"
        Height="520" Width="420"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter  x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Detail line dimensions" Style="{StaticResource HeaderTitle}"/>
                    <TextBlock Text="Revit26_Plugin.DetailLIneDimensions.V005" Style="{StaticResource HeaderSubtitle}"/>
                </StackPanel>

                <Border Grid.Column="1" Style="{StaticResource BadgePill}" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionBadge}" Style="{StaticResource BadgeText}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ BODY ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="10">
            <StackPanel>

                <!-- Configuration card -->
                <Border Style="{StaticResource ContentCard}">
                    <StackPanel Margin="0,0,0,4">
                        <TextBlock Text="Configuration" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Detail item type" FontSize="10" Style="{StaticResource FieldLabel}"/>
                            <ComboBox
                                ItemsSource="{Binding DetailItemTypes}"
                                SelectedItem="{Binding SelectedDetailItemType}"
                                DisplayMemberPath="Name"
                                FontSize="10"
                                Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Dimension type" FontSize="10" Style="{StaticResource FieldLabel}"/>
                            <ComboBox
                                ItemsSource="{Binding DimensionTypes}"
                                SelectedItem="{Binding SelectedDimensionType}"
                                DisplayMemberPath="Name"
                                FontSize="10"
                                Style="{StaticResource StandardComboBox}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Action -->
                <Button
                    Content="Generate dimensions"
                    Command="{Binding GenerateDimensionsCommand}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,8"/>

                <TextBlock
                    Text="Processing..."
                    Style="{StaticResource HintText}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,-4,0,8"/>

                <!-- Summary cards -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource MetricCard}" Margin="0,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlacedCount}" Style="{StaticResource MetricNumberSuccess}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Placed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricCard}" Margin="4,0,4,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SkippedCount}" Style="{StaticResource MetricNumberWarning}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Skipped" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCard}" Margin="4,0,0,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding FailedCount}" Style="{StaticResource MetricNumberDanger}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Failed" Style="{StaticResource MetricLabel}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Log panel -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10">
                    <StackPanel>
                        <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="9,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Log" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextOnDark}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy all" Command="{Binding CopyAllLogsCommand}"
                                            Style="{StaticResource DarkGhostButton}" Margin="0,0,5,0"/>
                                    <Button Content="Copy selected" Click="CopySelected_Click"
                                            Style="{StaticResource DarkGhostButton}" Margin="0,0,5,0"/>
                                    <Button Content="Clear" Command="{Binding ClearLogsCommand}"
                                            Style="{StaticResource DarkGhostButton}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding Log}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 MaxHeight="180"
                                 SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="10" FontFamily="Consolas"
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                               Text="{Binding}"
                                               TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
