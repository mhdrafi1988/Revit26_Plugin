<Window x:Class="Revit26_Plugin.DtlLineDim.V008.UI.Views.DtlLineDimWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Revit26_Plugin.Shared.Models"
        Title="Detail Line Dimension — V008"
        Height="680" Width="560"
        MinHeight="680" MinWidth="560"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Revit26_Plugin;component/Shared/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:LogLevelToColorConverter         x:Key="LogLevelToColorConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource BrushSystemBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Style="{StaticResource HeaderBar}" CornerRadius="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Detail Line Dimension — V008" Style="{StaticResource HeaderTitle}"/>
                <Button Grid.Column="1" Content="✕ Close" Style="{StaticResource SecondaryButton}"
                        Foreground="{StaticResource BrushAppleBlueLight}"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14">
            <StackPanel>

                <!-- View validation warning -->
                <Border Background="#FCEFE3" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1"
                        CornerRadius="8" Padding="10,8" Margin="0,0,0,10"
                        Visibility="{Binding IsViewValid, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding ViewValidationMessage, StringFormat='⚠ {0}'}"
                               FontSize="11.5" Foreground="#8A5A1A" TextWrapping="Wrap"/>
                </Border>

                <!-- Selection card -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Selection" Style="{StaticResource SectionTitle}"/>

                        <StackPanel Style="{StaticResource FieldRow}">
                            <TextBlock Text="Detail Item Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding DetailItemTypes}"
                                      SelectedItem="{Binding SelectedDetailItemType}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>

                        <StackPanel Style="{StaticResource FieldRow}" Margin="12,4,12,10">
                            <TextBlock Text="Dimension Type" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource StandardComboBox}"
                                      ItemsSource="{Binding DimensionTypes}"
                                      SelectedItem="{Binding SelectedDimensionType}"
                                      DisplayMemberPath="Name"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Settings card -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Dimension Settings" Style="{StaticResource SectionTitle}"/>

                        <Grid Margin="12,4,12,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Tick Size" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource BoxedTextInput}"
                                             Text="{Binding TickSizeText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FontSize="10"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="mm" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                                <TextBlock Text="Default 50mm — blank/invalid falls back automatically."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Offset" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource BoxedTextInput}"
                                             Text="{Binding OffsetText, UpdateSourceTrigger=PropertyChanged}"
                                             MaxLength="10" FontSize="10"
                                             Padding="4,2"
                                             HorizontalContentAlignment="Right"/>
                                    <TextBlock Grid.Column="1" Text="mm" Style="{StaticResource UnitLabel}"/>
                                </Grid>
                                <TextBlock Text="Default 300mm — blank/invalid falls back automatically."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Run row -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Button Content="Generate Dimensions"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding GenerateDimensionsCommand}"/>
                </StackPanel>

                <!-- Log panel -->
                <Border Background="{StaticResource BrushLogBg}" CornerRadius="10" Margin="0,0,0,8">
                    <StackPanel>
                        <Border Background="{StaticResource BrushLogTitleBar}" CornerRadius="10,10,0,0" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Log" FontSize="11.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextOnDark}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Copy All" Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding CopyAllLogsCommand}" Margin="0,0,4,0"/>
                                    <Button Content="Clear" Style="{StaticResource DarkGhostButton}"
                                            Command="{Binding ClearLogsCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="LogListBox"
                                 ItemsSource="{Binding LogEntries}"
                                 Background="Transparent" BorderThickness="0"
                                 Height="190" Padding="8,4"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Time, StringFormat='{}{0:HH:mm:ss}'}"
                                                   Foreground="{StaticResource BrushLogTextDim}"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Level}"
                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToColorConverter}}"
                                                   FontFamily="Consolas" FontSize="11" FontWeight="SemiBold"
                                                   Width="58" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Message}"
                                                   Foreground="{StaticResource BrushLogText}"
                                                   FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Status bar -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Last run:" Style="{StaticResource StatusText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding RunSummary}" Style="{StaticResource StatusText}" FontWeight="SemiBold"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Export Log (.txt)" Style="{StaticResource OutlineButton}"
                            Command="{Binding ExportLogsCommand}"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
