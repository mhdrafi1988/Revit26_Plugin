<Project>
	<!-- Settings shared by SloperPro.Core, SloperPro.Modelling and SloperPro.Documentation. -->
	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<PackageId />
		<IsPublishable>False</IsPublishable>
		<!-- Namespaces and embedded-resource names are unchanged from the single-assembly plugin. -->
		<RootNamespace>Revit26_Plugin</RootNamespace>
		<!-- Plugin version (SemVer), shared by all three assemblies. Per-tool versions live in
		     SloperPro.Core/Shared/Services/ToolCatalog.cs. -->
		<Version>4.0.0</Version>
		<!-- All three projects build into one folder, so it can be copied to the Revit add-in
		     folder as is: bin\Debug\ or bin\Release\ under the repository root. -->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
	</PropertyGroup>
</Project>
